---
/**
 * L'apparato urinario: dai reni alla vescica, vista di fronte.
 *
 * Ogni stato è disegnato solo con CSS a partire da [data-passaggio] e [data-indice] del palco
 * (docs/STRUTTURA-ARGOMENTO.md, §4). Gli organi sono i componenti condivisi in vista
 * frontale di src/components/anatomia.
 *
 * Inquadrature: tutto l'addome (1, 9), i reni (2, 3, 8), la vescica (10, 11);
 * nei passaggi 4–7 si apre la "lente" sul nefrone, dal rene sinistro (a destra nel disegno).
 */
import AddomeFronte from '../../../src/components/anatomia/AddomeFronte.astro';
import VasiAddome from '../../../src/components/anatomia/VasiAddome.astro';
import Reni from '../../../src/components/anatomia/Reni.astro';
import Vescica from '../../../src/components/anatomia/Vescica.astro';
import Nefrone from '../../../src/components/anatomia/Nefrone.astro';

interface Etichetta {
  testo: string;
  /** Inizio della riga di base del testo. */
  x: number;
  y: number;
  /** Linea dal testo all'organo: [x1, y1, x2, y2]; il pallino va sull'organo. */
  linea: [number, number, number, number];
  passaggio: string;
  /** Ingrandimento dell'inquadratura: il testo resta della stessa misura sullo schermo. */
  zoom: number;
}

const ZOOM_RENI = 1.7;
const ZOOM_VESCICA = 1.8;

// Etichette sul corpo (si muovono con l'inquadratura).
const etichetteCorpo: Etichetta[] = [
  { testo: 'Rene', x: 600, y: 230, linea: [592, 222, 515, 236], passaggio: 'panoramica', zoom: 1 },
  { testo: 'Rene', x: 140, y: 278, linea: [202, 270, 286, 272], passaggio: 'panoramica', zoom: 1 },
  { testo: 'Uretere', x: 600, y: 430, linea: [592, 422, 452, 420], passaggio: 'panoramica', zoom: 1 },
  { testo: 'Vescica', x: 100, y: 596, linea: [200, 588, 366, 600], passaggio: 'panoramica', zoom: 1 },
  { testo: 'Uretra', x: 600, y: 660, linea: [592, 652, 404, 652], passaggio: 'panoramica', zoom: 1 },
  { testo: 'Rene destro', x: 172, y: 200, linea: [262, 196, 300, 236], passaggio: 'reni', zoom: ZOOM_RENI },
  { testo: 'Rene sinistro', x: 526, y: 178, linea: [534, 184, 500, 214], passaggio: 'reni', zoom: ZOOM_RENI },
  { testo: 'Costole', x: 176, y: 150, linea: [234, 148, 278, 181], passaggio: 'reni', zoom: ZOOM_RENI },
  { testo: 'Aorta', x: 470, y: 120, linea: [466, 115, 418, 120], passaggio: 'sangue', zoom: ZOOM_RENI },
  { testo: 'Arteria renale', x: 440, y: 170, linea: [446, 176, 438, 236], passaggio: 'sangue', zoom: ZOOM_RENI },
  { testo: 'Urea', x: 200, y: 330, linea: [234, 322, 344, 262], passaggio: 'sangue', zoom: ZOOM_RENI },
  { testo: 'Vena renale', x: 400, y: 362, linea: [430, 348, 430, 264], passaggio: 'vena-renale', zoom: ZOOM_RENI },
  { testo: 'Vena cava', x: 222, y: 140, linea: [296, 136, 384, 140], passaggio: 'vena-renale', zoom: ZOOM_RENI },
  { testo: 'Uretere', x: 600, y: 430, linea: [592, 422, 452, 420], passaggio: 'ureteri', zoom: 1 },
  { testo: 'Uretere', x: 100, y: 450, linea: [200, 442, 350, 440], passaggio: 'ureteri', zoom: 1 },
  { testo: 'Vescica', x: 500, y: 520, linea: [496, 516, 452, 544], passaggio: 'vescica', zoom: ZOOM_VESCICA },
  { testo: 'Urina', x: 500, y: 600, linea: [496, 596, 430, 596], passaggio: 'vescica', zoom: ZOOM_VESCICA },
  { testo: 'Sfintere', x: 450, y: 646, linea: [446, 641, 412, 628], passaggio: 'minzione', zoom: ZOOM_VESCICA },
  { testo: 'Uretra', x: 290, y: 660, linea: [336, 656, 396, 656], passaggio: 'minzione', zoom: ZOOM_VESCICA },
];

// Etichette nella lente sul nefrone (riferimento di Nefrone.astro).
const etichetteLente: Etichetta[] = [
  { testo: 'Glomerulo', x: 80, y: 74, linea: [206, 68, 214, 112], passaggio: 'nefroni', zoom: 1 },
  { testo: 'Capsula', x: 310, y: 86, linea: [306, 80, 274, 110], passaggio: 'nefroni', zoom: 1 },
  { testo: 'Tubulo', x: 440, y: 140, linea: [480, 148, 470, 196], passaggio: 'nefroni', zoom: 1 },
  { testo: 'Capillari', x: 290, y: 392, linea: [340, 368, 340, 336], passaggio: 'nefroni', zoom: 1 },
  { testo: 'Preurina', x: 380, y: 120, linea: [392, 128, 330, 212], passaggio: 'filtrazione', zoom: 1 },
  { testo: 'Globuli rossi', x: 170, y: 270, linea: [166, 262, 117, 262], passaggio: 'filtrazione', zoom: 1 },
  { testo: 'Acqua e zuccheri', x: 300, y: 392, linea: [420, 368, 430, 338], passaggio: 'riassorbimento', zoom: 1 },
  { testo: 'Urea', x: 560, y: 130, linea: [584, 136, 590, 210], passaggio: 'riassorbimento', zoom: 1 },
  { testo: 'Urina', x: 560, y: 470, linea: [630, 462, 674, 462], passaggio: 'urina', zoom: 1 },
  { testo: 'Verso il bacinetto', x: 380, y: 590, linea: [626, 582, 668, 594], passaggio: 'urina', zoom: 1 },
];

// Cosa mostra il disegno a ogni passaggio, per chi usa uno screen reader.
const descrizioni: Record<string, string> = {
  panoramica: 'Addome visto di fronte. In alto i due reni, ai lati della colonna; da ognuno scende un tubo sottile, l’uretere, fino alla vescica in basso. Dalla vescica esce l’uretra.',
  reni: 'I due reni ingranditi, a forma di fagiolo, sotto le costole. Quello a sinistra nel disegno, il rene destro della persona, è un po’ più in basso.',
  'sangue': 'Dall’aorta, il grande vaso rosso al centro, partono le arterie renali. Il sangue porta ai reni dei quadratini gialli: l’urea, una sostanza di rifiuto.',
  nefroni: 'Si apre una lente dentro il rene: un nefrone. A sinistra un gomitolo di capillari rossi, il glomerulo, dentro una coppa, la capsula. Dalla capsula parte un tubicino, il tubulo, che finisce in un tubo più grande a destra. Sotto il tubulo corrono i capillari.',
  filtrazione: 'Dal glomerulo escono gocce d’acqua, quadratini gialli di urea e pallini viola di zucchero, che entrano nel tubulo: è la preurina. I globuli rossi restano nei capillari.',
  riassorbimento: 'Le gocce d’acqua e i pallini di zucchero escono dal tubulo e tornano nei capillari. I quadratini di urea e una goccia d’acqua proseguono fino alla fine del tubulo.',
  urina: 'Urea e acqua scendono nel tubo più grande, che si colora di giallo: è l’urina, che va verso il bacinetto.',
  'vena-renale': 'Di nuovo i reni. Il sangue esce dai reni lungo le vene renali, blu, e sale nella vena cava. Porta con sé meno urea di prima. Il centro dei reni, il bacinetto, è pieno di urina gialla.',
  ureteri: 'Di nuovo tutto l’addome. L’urina gialla scende dai reni lungo i due ureteri fino alla vescica.',
  vescica: 'La vescica ingrandita si gonfia e si riempie di urina gialla.',
  minzione: 'Lo sfintere in fondo alla vescica si apre. La vescica si stringe e l’urina esce lungo l’uretra, verso il basso.',
};

// Urea nel sangue: scende lungo l'aorta (y) e poi entra nelle arterie renali (x).
const ureaEntra = [
  { x: 414, y: 96, x2: 452, y2: 241 },
  { x: 414, y: 132, x2: 440, y2: 238 },
  { x: 414, y: 112, x2: 346, y2: 260 },
  { x: 414, y: 150, x2: 362, y2: 257 },
];
// Urea che esce con il sangue: meno di quella entrata. Va nella vena cava (x) e poi sale (y).
const ureaEsce = [
  { x: 452, y: 260, x2: 386, y2: 100 },
  { x: 346, y: 277, x2: 386, y2: 140 },
];

// Sostanze nella lente: nel glomerulo (1), all'inizio del tubulo (2), dopo il riassorbimento (3), nell'urina (4).
type Tipo = 'acqua' | 'urea' | 'zucchero';
const particelle: { tipo: Tipo; p: [number, number][] }[] = [
  { tipo: 'acqua', p: [[200, 128], [292, 200], [360, 330], [360, 330]] },
  { tipo: 'acqua', p: [[244, 140], [318, 216], [440, 330], [440, 330]] },
  { tipo: 'acqua', p: [[214, 186], [346, 226], [500, 330], [500, 330]] },
  { tipo: 'acqua', p: [[250, 182], [372, 222], [560, 330], [560, 330]] },
  { tipo: 'acqua', p: [[196, 160], [276, 192], [604, 218], [680, 440]] },
  { tipo: 'urea', p: [[232, 124], [334, 224], [560, 224], [680, 380]] },
  { tipo: 'urea', p: [[206, 196], [360, 228], [628, 214], [680, 510]] },
  { tipo: 'urea', p: [[258, 160], [300, 208], [584, 222], [680, 570]] },
  { tipo: 'zucchero', p: [[226, 146], [306, 208], [400, 330], [400, 330]] },
  { tipo: 'zucchero', p: [[188, 140], [390, 220], [530, 330], [530, 330]] },
];

const GOCCIA = 'M0 -7C3 -3 5 0 5 3A5 5 0 0 1 -5 3C-5 0 -3 -3 0 -7Z';
const px = (n: number) => `${n}px`;
const larghezzaTesto = (t: string, fs: number) => t.length * fs * 0.56;
---

<div class="apparato-urinario">
  <svg viewBox="0 0 800 640" aria-hidden="true" focusable="false">
    <g class="camera">
      <AddomeFronte />
      <VasiAddome />
      <Reni />
      <Vescica />

      {
        ureaEntra.map((u, i) => (
          <g class="urea-sangue urea-sangue--entra" style={`--y: ${px(u.y)}; --y2: ${px(u.y2)}; --ritardo: ${i * 0.12}s`}>
            <g class="urea-sangue__x" style={`--x: ${px(u.x)}; --x2: ${px(u.x2)}`}>
              <rect x="-4" y="-4" width="8" height="8" rx="1" />
            </g>
          </g>
        ))
      }
      {
        ureaEsce.map((u, i) => (
          <g class="urea-sangue urea-sangue--esce" style={`--y: ${px(u.y)}; --y2: ${px(u.y2)}; --ritardo: ${i * 0.15}s`}>
            <g class="urea-sangue__x" style={`--x: ${px(u.x)}; --x2: ${px(u.x2)}`}>
              <rect x="-4" y="-4" width="8" height="8" rx="1" />
            </g>
          </g>
        ))
      }
      <path class="uscita" d="M400 674V700M391 691L400 702L409 691"></path>

      {
        etichetteCorpo.map((e) => {
          const fs = 24 / e.zoom;
          return (
            <g class="etichetta" data-per={e.passaggio}>
              <line x1={e.linea[0]} y1={e.linea[1]} x2={e.linea[2]} y2={e.linea[3]} />
              <circle cx={e.linea[2]} cy={e.linea[3]} r={3.5 / e.zoom} />
              <rect x={e.x - fs * 0.3} y={e.y - fs * 0.95} width={larghezzaTesto(e.testo, fs) + fs * 0.6} height={fs * 1.3} rx={fs * 0.65} />
              <text x={e.x} y={e.y} style={`font-size: ${fs}px`}>
                {e.testo}
              </text>
            </g>
          );
        })
      }
    </g>

    <!-- la lente sul nefrone: si apre dal rene sinistro (a destra nel disegno), già ingrandito -->
    <g transform="translate(539 303)">
      <g class="lente">
        <g transform="translate(-539 -303)">
          <Nefrone />
          {
            particelle.map((s, i) => (
              <g
                class:list={['particella', `particella--${s.tipo}`]}
                style={s.p.map(([x, y], n) => `--x${n + 1}: ${px(x)}; --y${n + 1}: ${px(y)}`).join('; ') + `; --ritardo: ${(i % 5) * 0.1}s`}
              >
                {s.tipo === 'acqua' && <path d={GOCCIA} transform="scale(1.6)" />}
                {s.tipo === 'urea' && <rect x="-7" y="-7" width="14" height="14" rx="2" />}
                {s.tipo === 'zucchero' && <circle r="8" />}
              </g>
            ))
          }
          {
            etichetteLente.map((e) => (
              <g class="etichetta" data-per={e.passaggio}>
                <line x1={e.linea[0]} y1={e.linea[1]} x2={e.linea[2]} y2={e.linea[3]} />
                <circle cx={e.linea[2]} cy={e.linea[3]} r="3.5" />
                <rect x={e.x - 7} y={e.y - 23} width={larghezzaTesto(e.testo, 24) + 14} height="31" rx="15.5" />
                <text x={e.x} y={e.y} style="font-size: 24px">
                  {e.testo}
                </text>
              </g>
            ))
          }
        </g>
      </g>
    </g>
  </svg>

  <div class="solo-lettori">
    {
      Object.entries(descrizioni).map(([id, testo]) => (
        <p class="descrizione" data-per={id}>
          Disegno: {testo}
        </p>
      ))
    }
  </div>
</div>

<style is:global>
  .apparato-urinario {
    position: absolute;
    inset: 0;
  }
  .apparato-urinario svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Contorni sempre dello stesso spessore negli ingrandimenti (i tubi invece crescono con lo zoom). */
  .apparato-urinario .camera :is(.addome__pelle, .rene__forma, .rene__piramide, .rene__bacinetto, .rene__urina, .vescica__parete, .vescica__lume, .sfintere rect, .urea-sangue rect, .uscita, .etichetta line) {
    vector-effect: non-scaling-stroke;
  }

  /* --- Inquadratura --- */

  .apparato-urinario .camera {
    transform: translate(0, -30px) scale(1);
    transition: transform 1.2s ease-in-out;
  }
  :is([data-passaggio='reni'], [data-passaggio='sangue'], [data-passaggio='nefroni'], [data-passaggio='filtrazione'], [data-passaggio='riassorbimento'], [data-passaggio='urina'], [data-passaggio='vena-renale']) .apparato-urinario .camera {
    transform: translate(-280px, -125px) scale(1.7);
  }
  :is([data-passaggio='vescica'], [data-passaggio='minzione']) .apparato-urinario .camera {
    transform: translate(-320px, -688px) scale(1.8);
  }

  /* --- Il sangue: l'urea entra con l'arteria renale, ne esce meno con la vena --- */

  .apparato-urinario .urea-sangue {
    transform: translate(0, var(--y));
    opacity: 0;
    transition:
      transform 1s ease-in-out,
      opacity 0.3s ease-in-out;
  }
  .apparato-urinario .urea-sangue__x {
    transform: translate(var(--x), 0);
    transition: transform 0.8s ease-in-out;
  }
  .apparato-urinario .urea-sangue rect {
    fill: var(--rifiuti);
    stroke: var(--contorno);
    stroke-width: 1.5;
  }
  /* Entra: prima scende lungo l'aorta, poi gira verso il rene. */
  [data-passaggio='sangue'] .apparato-urinario .urea-sangue--entra {
    transform: translate(0, var(--y2));
    opacity: 1;
    transition-delay: calc(0.3s + var(--ritardo)), 0.3s;
  }
  [data-passaggio='sangue'] .apparato-urinario .urea-sangue--entra .urea-sangue__x {
    transform: translate(var(--x2), 0);
    transition-delay: calc(1.3s + var(--ritardo));
  }
  /* Esce: prima va verso la vena cava, poi sale. */
  [data-passaggio='vena-renale'] .apparato-urinario .urea-sangue--esce {
    transform: translate(0, var(--y2));
    opacity: 1;
    transition-delay: calc(1.2s + var(--ritardo)), 0.4s;
  }
  [data-passaggio='vena-renale'] .apparato-urinario .urea-sangue--esce .urea-sangue__x {
    transform: translate(var(--x2), 0);
    transition-delay: calc(0.4s + var(--ritardo));
  }

  /* --- La lente sul nefrone --- */

  .apparato-urinario .lente {
    transform: scale(0.1);
    opacity: 0;
    transition:
      transform 0.8s ease-in-out,
      opacity 0.5s ease-in-out;
  }
  :is([data-passaggio='nefroni'], [data-passaggio='filtrazione'], [data-passaggio='riassorbimento'], [data-passaggio='urina']) .apparato-urinario .lente {
    transform: scale(1);
    opacity: 1;
  }
  [data-passaggio='nefroni'] .apparato-urinario .lente {
    transition-delay: 0.3s;
  }

  .apparato-urinario .particella {
    transform: translate(var(--x1), var(--y1));
    opacity: 0;
    transition:
      transform 1.2s ease-in-out,
      opacity 0.3s ease-in-out;
  }
  .apparato-urinario .particella :is(path, rect, circle) {
    stroke: var(--contorno);
    stroke-width: 1.5;
  }
  .apparato-urinario .particella--acqua path {
    fill: var(--acqua);
  }
  .apparato-urinario .particella--urea rect {
    fill: var(--rifiuti);
  }
  .apparato-urinario .particella--zucchero circle {
    fill: var(--nutrienti);
  }
  [data-passaggio='filtrazione'] .apparato-urinario .particella {
    transform: translate(var(--x2), var(--y2));
    opacity: 1;
    transition-delay: calc(0.6s + var(--ritardo)), 0s;
  }
  [data-passaggio='riassorbimento'] .apparato-urinario .particella {
    transform: translate(var(--x3), var(--y3));
    opacity: 1;
    transition-delay: var(--ritardo);
  }
  [data-passaggio='urina'] .apparato-urinario .particella {
    transform: translate(var(--x4), var(--y4));
    opacity: 1;
    transition-delay: var(--ritardo);
  }
  /* Dopo la lente restano dove sono, nascoste: tornando indietro ricompaiono ferme. */
  [data-indice]:not([data-indice='-1'], [data-indice='0'], [data-indice='1'], [data-indice='2'], [data-indice='3'], [data-indice='4'], [data-indice='5'], [data-indice='6']) .apparato-urinario .particella {
    transform: translate(var(--x4), var(--y4));
  }

  .apparato-urinario .nefrone__urina {
    transition: opacity 0.8s ease-in-out;
  }
  [data-passaggio='urina'] .apparato-urinario .nefrone__urina {
    opacity: 1;
    transition-delay: 0.8s;
  }

  /* --- Urina nel bacinetto, dal passaggio "urina" in poi --- */

  .apparato-urinario .rene__urina {
    transition: opacity 0.8s ease-in-out;
  }
  [data-indice]:not([data-indice='-1'], [data-indice='0'], [data-indice='1'], [data-indice='2'], [data-indice='3'], [data-indice='4'], [data-indice='5']) .apparato-urinario .rene__urina {
    opacity: 1;
  }

  /* --- Ureteri: l'urina scende a gocce, dal passaggio "ureteri" in poi --- */

  .apparato-urinario .uretere__urina {
    stroke-dashoffset: 0;
    transition:
      opacity 0.3s ease-in-out,
      stroke-dashoffset 2.4s ease-in-out;
  }
  :is([data-passaggio='ureteri'], [data-passaggio='vescica'], [data-passaggio='minzione']) .apparato-urinario .uretere__urina {
    opacity: 1;
    stroke-dashoffset: -40;
  }

  /* --- Vescica: si riempie, poi si svuota attraverso l'uretra --- */

  .apparato-urinario .vescica {
    transition: transform 1.6s ease-in-out;
  }
  .apparato-urinario .vescica__urina {
    transition: transform 1.6s ease-in-out;
  }
  [data-passaggio='vescica'] .apparato-urinario .vescica {
    transform: scale(1);
    transition-delay: 0.6s;
  }
  [data-passaggio='vescica'] .apparato-urinario .vescica__urina {
    transform: translateY(14px);
    transition-delay: 0.6s;
  }
  [data-passaggio='minzione'] .apparato-urinario .vescica,
  [data-passaggio='minzione'] .apparato-urinario .vescica__urina {
    transition-delay: 0.9s;
  }
  [data-passaggio='minzione'] .apparato-urinario .vescica__urina {
    transform: translateY(80px);
  }

  .apparato-urinario :is(.sfintere__sx, .sfintere__dx) {
    transition: transform 0.5s ease-in-out;
  }
  [data-passaggio='minzione'] .apparato-urinario .sfintere__sx {
    transform: translateX(-5px);
    transition-delay: 0.6s;
  }
  [data-passaggio='minzione'] .apparato-urinario .sfintere__dx {
    transform: translateX(5px);
    transition-delay: 0.6s;
  }

  .apparato-urinario .uretra__urina {
    stroke-dashoffset: 0;
    transition:
      opacity 0.3s ease-in-out,
      stroke-dashoffset 1.4s ease-in-out;
  }
  [data-passaggio='minzione'] .apparato-urinario .uretra__urina {
    opacity: 1;
    stroke-dashoffset: -56;
    transition-delay: 0.9s;
  }
  .apparato-urinario .uscita {
    fill: none;
    stroke: var(--contorno);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
    transition: opacity 0.4s ease-in-out;
  }
  [data-passaggio='minzione'] .apparato-urinario .uscita {
    opacity: 1;
    transition-delay: 2s;
  }

  /* --- Elemento evidenziato nel passaggio corrente (guida di stile, §3) --- */

  [data-passaggio='reni'] .apparato-urinario .rene__forma,
  [data-passaggio='vescica'] .apparato-urinario .vescica__parete,
  [data-passaggio='minzione'] .apparato-urinario .sfintere rect {
    stroke: var(--accento);
    stroke-width: 4;
  }
  [data-passaggio='sangue'] .apparato-urinario .vaso__bordo.arteria-renale,
  [data-passaggio='vena-renale'] .apparato-urinario .vaso__bordo.vena-renale,
  [data-passaggio='ureteri'] .apparato-urinario .uretere__bordo,
  [data-passaggio='nefroni'] .apparato-urinario .nefrone__capsula-bordo,
  [data-passaggio='filtrazione'] .apparato-urinario .nefrone__glomerulo-bordo,
  [data-passaggio='riassorbimento'] .apparato-urinario .nefrone__tubulo-bordo,
  [data-passaggio='urina'] .apparato-urinario .nefrone__dotto-bordo {
    stroke: var(--accento);
  }

  /* --- Etichette: compaiono quando l'inquadratura si è fermata --- */

