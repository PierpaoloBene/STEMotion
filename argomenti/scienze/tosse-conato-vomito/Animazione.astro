---
/**
 * Tosse, conato e vomito: i riflessi che difendono vie dell'aria e stomaco, in sezione di profilo.
 *
 * Stessa scena della deglutizione (componenti condivisi di src/components/anatomia),
 * con polmone e diaframma in più. Ogni stato è disegnato solo con CSS a partire da
 * [data-passaggio] del palco (docs/STRUTTURA-ARGOMENTO.md, §4).
 *
 * Tre inquadrature: "vicina" su bocca e gola, "media" dalla bocca al diaframma (la tosse),
 * "lontana" dal collo allo stomaco (il conato).
 */
import Corpo from '../../../src/components/anatomia/Corpo.astro';
import Polmoni from '../../../src/components/anatomia/Polmoni.astro';
import Diaframma from '../../../src/components/anatomia/Diaframma.astro';
import BoccaFaringe from '../../../src/components/anatomia/BoccaFaringe.astro';
import Esofago from '../../../src/components/anatomia/Esofago.astro';
import Laringe from '../../../src/components/anatomia/Laringe.astro';
import Stomaco from '../../../src/components/anatomia/Stomaco.astro';

interface Etichetta {
  /** Con "\n" il testo va su due righe. */
  testo: string;
  /** Posizione del testo (inizio della riga di base). */
  x: number;
  y: number;
  /** Linea dal testo all'organo: [x1, y1, x2, y2]; il pallino va sull'organo. */
  linea: [number, number, number, number];
  passaggio: string;
  vista: 'vicina' | 'media' | 'lontana';
}

const etichette: Etichetta[] = [
  { testo: 'Cibo', x: 110, y: 530, linea: [170, 523, 428, 484], passaggio: 'di-traverso', vista: 'vicina' },
  { testo: 'Epiglottide aperta', x: 505, y: 440, linea: [499, 433, 446, 376], passaggio: 'di-traverso', vista: 'vicina' },
  { testo: 'Trachea', x: 505, y: 530, linea: [499, 523, 456, 523], passaggio: 'di-traverso', vista: 'vicina' },
  { testo: 'Polmone', x: 640, y: 740, linea: [632, 732, 545, 732], passaggio: 'respiro-profondo', vista: 'media' },
  { testo: 'Diaframma', x: 640, y: 970, linea: [632, 962, 572, 936], passaggio: 'respiro-profondo', vista: 'media' },
  { testo: 'Corde vocali', x: 640, y: 452, linea: [632, 444, 458, 444], passaggio: 'compressione', vista: 'media' },
  { testo: 'Muscoli\ndella pancia', x: 650, y: 920, linea: [644, 948, 628, 966], passaggio: 'compressione', vista: 'media' },
  { testo: 'Cibo', x: 700, y: 380, linea: [694, 372, 540, 292], passaggio: 'colpo-di-tosse', vista: 'media' },
  { testo: 'Aria', x: 640, y: 600, linea: [632, 592, 452, 560], passaggio: 'colpo-di-tosse', vista: 'media' },
  { testo: 'Boccone', x: 110, y: 470, linea: [222, 463, 412, 332], passaggio: 'boccone-grande', vista: 'vicina' },
  { testo: 'Palato molle', x: 110, y: 400, linea: [268, 393, 404, 296], passaggio: 'boccone-grande', vista: 'vicina' },
  { testo: 'Faringe', x: 110, y: 505, linea: [204, 498, 384, 385], passaggio: 'riflesso-faringeo', vista: 'vicina' },
  { testo: 'Lingua', x: 656, y: 382, linea: [650, 375, 540, 340], passaggio: 'riflesso-faringeo', vista: 'vicina' },
  { testo: 'Diaframma', x: -30, y: 870, linea: [138, 862, 262, 925], passaggio: 'conato', vista: 'lontana' },
  { testo: 'Muscoli\ndella pancia', x: 650, y: 976, linea: [644, 968, 628, 968], passaggio: 'conato', vista: 'lontana' },
  { testo: 'Esofago', x: -30, y: 690, linea: [102, 682, 372, 682], passaggio: 'risalita', vista: 'lontana' },
  { testo: 'Cardias', x: -30, y: 944, linea: [102, 936, 366, 934], passaggio: 'risalita', vista: 'lontana' },
  { testo: 'Palato molle', x: 110, y: 470, linea: [268, 463, 416, 248], passaggio: 'vie-aeree-chiuse', vista: 'vicina' },
  { testo: 'Epiglottide', x: 505, y: 462, linea: [499, 455, 423, 384], passaggio: 'vie-aeree-chiuse', vista: 'vicina' },
  { testo: 'Vomito', x: 640, y: 440, linea: [668, 414, 668, 350], passaggio: 'fuori', vista: 'vicina' },
];

// Cosa mostra il disegno a ogni passaggio, per chi usa uno screen reader.
const descrizioni: Record<string, string> = {
  'di-traverso': 'Testa vista in sezione, di profilo. L’epiglottide è alzata e la laringe aperta: un pezzetto di cibo scivola dentro e scende nella trachea.',
  'respiro-profondo': 'La vista si allarga fino al diaframma. Il diaframma si abbassa, il polmone si gonfia e l’aria entra dal naso e scende nella trachea.',
  compressione: 'Le corde vocali si chiudono. I muscoli della pancia spingono, il diaframma sale e il polmone si stringe: l’aria resta chiusa sotto le corde vocali.',
  'colpo-di-tosse': 'Le corde vocali si aprono. L’aria esce di colpo dalla trachea e porta il pezzetto di cibo fino in bocca.',
  'boccone-grande': 'Di nuovo la bocca e la gola. Un boccone grosso è finito in fondo alla bocca e tocca la lingua e il palato molle.',
  'riflesso-faringeo': 'I muscoli della faringe si stringono e la lingua si sposta in avanti: il boccone torna verso la parte davanti della bocca.',
  conato: 'Vista dal collo alla pancia. Il diaframma si abbassa e i muscoli della pancia spingono: lo stomaco, pieno di cibo, viene schiacciato.',
  risalita: 'Il cardias si apre e il contenuto dello stomaco sale lungo l’esofago.',
  'vie-aeree-chiuse': 'Bocca e gola. Il palato molle si alza e chiude il naso, l’epiglottide si abbassa sulla laringe. Il contenuto arriva nella faringe.',
  fuori: 'Il contenuto dello stomaco attraversa la bocca ed esce. Le vie dell’aria restano chiuse.',
};

// Freccia dell'aria, disegnata verso l'alto attorno al proprio centro.
const frecciaAria = 'M0 -22L13 -6H6V22H-6V-6H-13Z';
const ariaInspira = [
  { x: 510, y: 238, r: -90 },
  { x: 437, y: 610, r: 180 },
  { x: 520, y: 800, r: 150 },
];
const ariaCompressa = [
  { x: 437, y: 545, r: 0 },
  { x: 437, y: 610, r: 0 },
  { x: 515, y: 800, r: -35 },
];
const ariaTosse = [
  { x: 437, y: 560, r: 0 },
  { x: 437, y: 630, r: 0 },
  { x: 660, y: 292, r: 90 },
];

// Frecce dei muscoli: la pancia spinge da davanti, il diaframma da sopra.
const freccia = (x: number, y: number, dx: number, dy: number) => {
  const [px, py] = [-Math.sign(dy) * 7, -Math.sign(dx) * 7];
  const [tx, ty] = [x + dx, y + dy];
  const [bx, by] = [tx - Math.sign(dx) * 7, ty - Math.sign(dy) * 7];
  return `M${x} ${y}L${tx} ${ty}M${bx + px} ${by + py}L${tx} ${ty}L${bx - px} ${by - py}`;
};
const spintaPancia = [freccia(624, 968, -32, 0), freccia(624, 1000, -32, 0)].join('');
const spintaDiaframma = [freccia(280, 862, 0, 26), freccia(470, 846, 0, 26)].join('');
const spintaFaringe = [freccia(340, 330, 24, 0), freccia(340, 385, 24, 0)].join('');
const muscoloFaringe = (y: number) => `M372 ${y - 22}C372 ${y - 10} 388 ${y - 8} 388 ${y}C388 ${y + 8} 372 ${y + 10} 372 ${y + 22}Z`;

// Il percorso del vomito, in tre tratti che si scoprono uno per passaggio.
const flusso = {
  esofago: 'M391 936V436',
  faringe: 'M391 436C388 400 388 360 400 335',
  bocca: 'M400 335C420 305 470 292 520 290C560 288 592 298 625 302C648 305 662 318 668 338',
};
---

<div class="tosse-vomito">
  <svg viewBox="0 0 800 640" aria-hidden="true" focusable="false">
    <g class="camera">
      <Corpo />
      <Polmoni />
      <Diaframma />
      <BoccaFaringe />
      <Esofago />
      <Laringe />

      {
        Object.entries(flusso).map(([tratto, d]) => (
          <g class={`flusso flusso--${tratto}`}>
            <path class="flusso__bordo" d={d} pathLength="1" />
            <path class="flusso__cibo" d={d} pathLength="1" />
          </g>
        ))
      }

      <!-- lo stomaco con il suo contenuto: si schiaccia attorno al cardias -->
      <g transform="translate(391 934)">
        <g class="schiacciamento">
          <g transform="translate(-391 -934)">
            <Stomaco />
            <g transform="translate(470 1050)">
              <g class="contenuto">
                <path d="M-60 -50C-40 -65 0 -60 30 -65C60 -70 75 -50 70 -30C65 -5 30 5 -5 0C-40 -4 -65 -20 -60 -50Z"></path>
              </g>
            </g>
          </g>
        </g>
      </g>

      <g class="faringe-contrazione">
        <path class="faringe-muscolo" d={muscoloFaringe(330)}></path>
        <path class="faringe-muscolo" d={muscoloFaringe(385)}></path>
        <path class="freccia-muscolo" d={spintaFaringe}></path>
      </g>
      <path class="freccia-muscolo spinta-pancia" d={spintaPancia}></path>
      <path class="freccia-muscolo spinta-diaframma" d={spintaDiaframma}></path>

      {
        [
          ['aria-inspira', ariaInspira],
          ['aria-compressa', ariaCompressa],
          ['aria-tosse', ariaTosse],
        ].map(([classe, frecce]) => (
          <g class={`aria ${classe}`}>
            {(frecce as typeof ariaInspira).map((f) => (
              <path class="freccia-aria" d={frecciaAria} transform={`translate(${f.x} ${f.y}) rotate(${f.r})`} />
            ))}
          </g>
        ))
      }

      <!-- il pezzetto che va di traverso -->
      <g class="pezzetto">
        <circle r="10"></circle>
      </g>

      <!-- il boccone troppo grande -->
      <g class="boccone">
        <path d="M-24 -4C-26 -14 -14 -19 -4 -17C6 -21 20 -17 24 -7C28 3 22 14 10 16C0 20 -14 18 -20 10C-25 6 -23 1 -24 -4Z"></path>
      </g>

      {
        etichette.map((e) => (
          <g class:list={['etichetta', `etichetta--${e.vista}`]} data-per={e.passaggio}>
            <line x1={e.linea[0]} y1={e.linea[1]} x2={e.linea[2]} y2={e.linea[3]} />
            <circle cx={e.linea[2]} cy={e.linea[3]} r="3.5" />
            <text x={e.x} y={e.y}>
              {e.testo.split('\n').map((riga, i) => (
                <tspan x={e.x} dy={i === 0 ? 0 : '1.15em'}>
                  {riga}
                </tspan>
              ))}
            </text>
          </g>
        ))
      }
    </g>
  </svg>

  <div class="solo-lettori">
    {
      Object.entries(descrizioni).map(([id, testo]) => (
        <p class="descrizione" data-per={id}>
          Disegno: {testo}
        </p>
      ))
    }
  </div>
</div>

<style is:global>
  .tosse-vomito {
    position: absolute;
    inset: 0;
  }
  .tosse-vomito svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Contorni sempre dello stesso spessore, anche quando l'inquadratura cambia. */
  .tosse-vomito svg :is(path, rect, circle, ellipse, line) {
    vector-effect: non-scaling-stroke;
  }

  /* --- Inquadratura --- */

  .tosse-vomito .camera {
    /* vicina: bocca e gola (la stessa della deglutizione) */
    transform: translate(-125px, -62.5px) scale(1.25);
    transition: transform 1.2s ease-in-out;
  }
  :is([data-passaggio='respiro-profondo'], [data-passaggio='compressione'], [data-passaggio='colpo-di-tosse'])
    .tosse-vomito
    .camera {
    /* media: dalla bocca al diaframma */
    transform: translate(72.4px, -167.7px) scale(0.78);
  }
  :is([data-passaggio='conato'], [data-passaggio='risalita']) .tosse-vomito .camera {
    /* lontana: dal collo allo stomaco (la stessa della deglutizione) */
    transform: translate(44.44px, -337.78px) scale(0.8889);
  }

  /* --- Il pezzetto che va di traverso --- */

  .tosse-vomito .pezzetto circle {
    fill: var(--cibo);
    stroke: var(--contorno);
    stroke-width: 2.5;
    transition:
      stroke 0.3s ease-in-out,
      stroke-width 0.3s ease-in-out;
  }
  .tosse-vomito .pezzetto {
    /* prima del passaggio 1 (solo con "Ripeti"): nella faringe */
    transform: translate(398px, 338px);
    transition: opacity 0.3s ease-in-out;
  }
  :is([data-passaggio='di-traverso'], [data-passaggio='respiro-profondo'], [data-passaggio='compressione'])
    .tosse-vomito
    .pezzetto {
    transform: translate(437px, 482px);
  }
  /* Le tappe girano attorno all'epiglottide invece di attraversarla. */
  [data-passaggio='di-traverso'] .tosse-vomito .pezzetto {
    animation: tosse-di-traverso 1.4s ease-in-out;
  }
  @keyframes tosse-di-traverso {
    0% {
      transform: translate(398px, 338px);
    }
    30% {
      transform: translate(414px, 362px);
    }
    55% {
      transform: translate(434px, 400px);
    }
  }
  [data-passaggio='colpo-di-tosse'] .tosse-vomito .pezzetto,
  [data-indice]:not([data-indice='-1'], [data-indice='0'], [data-indice='1'], [data-indice='2']) .tosse-vomito .pezzetto {
    transform: translate(530px, 284px);
  }
  [data-passaggio='colpo-di-tosse'] .tosse-vomito .pezzetto {
    animation: tosse-espulsione 1s ease-in-out 0.4s backwards;
  }
  @keyframes tosse-espulsione {
    0% {
      transform: translate(437px, 482px);
    }
    25% {
      transform: translate(436px, 410px);
    }
    45% {
      transform: translate(420px, 352px);
    }
    65% {
      transform: translate(445px, 316px);
    }
  }
  /* Dopo la tosse il pezzetto è stato sputato o deglutito. */
  [data-indice]:not([data-indice='-1'], [data-indice='0'], [data-indice='1'], [data-indice='2'], [data-indice='3'])
    .tosse-vomito
    .pezzetto {
    opacity: 0;
  }

  /* --- Il boccone troppo grande --- */

  .tosse-vomito .boccone path {
    fill: var(--cibo);
    stroke: var(--contorno);
    stroke-width: 2.5;
    stroke-linejoin: round;
    transition:
      stroke 0.3s ease-in-out,
      stroke-width 0.3s ease-in-out;
  }
  .tosse-vomito .boccone {
    /* in bocca */
    transform: translate(535px, 284px);
    opacity: 0;
    transition:
      transform 1s ease-in-out,
      opacity 0.3s ease-in-out;
  }
  [data-passaggio='boccone-grande'] .tosse-vomito .boccone {
    /* in fondo alla bocca, contro lingua e palato molle */
    transform: translate(428px, 320px);
    opacity: 1;
    transition:
      transform 1.1s ease-in-out 0.3s,
      opacity 0.3s ease-in-out;
  }
  [data-passaggio='riflesso-faringeo'] .tosse-vomito .boccone {
    opacity: 1;
    transition: transform 1s ease-in-out 0.3s;
  }

  /* --- Lingua e faringe nel riflesso faringeo --- */

  .tosse-vomito .lingua {
    transition: transform 0.8s ease-in-out;
  }
  [data-passaggio='riflesso-faringeo'] .tosse-vomito .lingua {
    transform: translate(8px, 4px);
    transition-delay: 0.3s;
  }
  .tosse-vomito .faringe-contrazione {
    opacity: 0;
    transition: opacity 0.2s ease-in-out;
  }
  [data-passaggio='riflesso-faringeo'] .tosse-vomito .faringe-contrazione {
    opacity: 1;
    transition: opacity 0.3s ease-in-out;
  }
  .tosse-vomito .faringe-muscolo {
    fill: var(--muscolo);
    stroke: var(--contorno);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .tosse-vomito .freccia-muscolo {
    fill: none;
    stroke: var(--contorno);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* --- Respiro: diaframma e polmone --- */

  .tosse-vomito :is(.diaframma, .polmone) {
    transition: transform 1s ease-in-out;
  }
  [data-passaggio='respiro-profondo'] .tosse-vomito .diaframma {
    transform: translateY(10px);
  }
  [data-passaggio='respiro-profondo'] .tosse-vomito .polmone {
    transform: scale(1.05);
  }
  :is([data-passaggio='compressione'], [data-passaggio='colpo-di-tosse']) .tosse-vomito .diaframma {
    transform: translateY(-8px);
  }
  :is([data-passaggio='compressione'], [data-passaggio='colpo-di-tosse']) .tosse-vomito .polmone {
    transform: scale(0.92);
  }
  :is([data-passaggio='conato'], [data-passaggio='risalita'], [data-passaggio='vie-aeree-chiuse'], [data-passaggio='fuori'])
    .tosse-vomito
    .diaframma {
    transform: translateY(6px);
  }

  /* --- Corde vocali: chiuse solo mentre l'aria viene compressa --- */

  .tosse-vomito .corda-vocale {
    transition: transform 0.5s ease-in-out;
  }
  [data-passaggio='compressione'] .tosse-vomito .corda-vocale {
    transform: scaleX(1.46);
    transition-duration: 0.6s;
  }
  [data-passaggio='colpo-di-tosse'] .tosse-vomito .corda-vocale {
    transition-duration: 0.25s;
  }

  /* --- Frecce dell'aria e dei muscoli --- */

  .tosse-vomito .freccia-aria {
    fill: var(--aria);
    stroke: var(--contorno);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .tosse-vomito :is(.aria, .spinta-pancia, .spinta-diaframma) {
    opacity: 0;
    transition: opacity 0.2s ease-in-out;
  }
  [data-passaggio='respiro-profondo'] .tosse-vomito .aria-inspira,
  [data-passaggio='compressione'] .tosse-vomito :is(.aria-compressa, .spinta-pancia),
  [data-passaggio='colpo-di-tosse'] .tosse-vomito .aria-tosse,
  [data-passaggio='conato'] .tosse-vomito :is(.spinta-pancia, .spinta-diaframma) {
    opacity: 1;
    transition: opacity 0.4s ease-in-out 1s;
  }
  [data-passaggio='colpo-di-tosse'] .tosse-vomito .aria-tosse {
    transition-delay: 0.4s;
  }

  /* --- Conato: lo stomaco schiacciato --- */

  .tosse-vomito .contenuto path {
    fill: var(--cibo);
    stroke: var(--contorno);
    stroke-width: 2.5;
    stroke-linejoin: round;
  }
  .tosse-vomito .contenuto {
    opacity: 0;
    transition:
      opacity 0.3s ease-in-out,
      transform 1.2s ease-in-out;
  }
  [data-indice]:not([data-indice='-1'], [data-indice='0'], [data-indice='1'], [data-indice='2'], [data-indice='3'], [data-indice='4'], [data-indice='5'])
    .tosse-vomito
    .contenuto {
    opacity: 1;
  }
  :is([data-passaggio='risalita'], [data-passaggio='vie-aeree-chiuse'], [data-passaggio='fuori']) .tosse-vomito .contenuto {
    transform: scaleY(0.6);
  }
  .tosse-vomito .schiacciamento {
    transition: transform 1s ease-in-out;
  }
  :is([data-passaggio='conato'], [data-passaggio='risalita'], [data-passaggio='vie-aeree-chiuse'], [data-passaggio='fuori'])
    .tosse-vomito
    .schiacciamento {
    transform: scale(0.95, 0.88);
  }

  /* --- Il vomito risale: un tratto per passaggio --- */

  .tosse-vomito .flusso path {
    /* lo spessore segue l'inquadratura, come un oggetto */
    vector-effect: none;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
    transition:
      stroke-dashoffset 1s ease-in-out,
      stroke 0.3s ease-in-out;
  }
  .tosse-vomito .flusso__bordo {
    stroke: var(--contorno);
    stroke-width: 28;
  }
  .tosse-vomito .flusso__cibo {
    stroke: var(--cibo);
    stroke-width: 22;
  }
  :is([data-passaggio='risalita'], [data-passaggio='vie-aeree-chiuse'], [data-passaggio='fuori']) .tosse-vomito .flusso--esofago path,
  :is([data-passaggio='vie-aeree-chiuse'], [data-passaggio='fuori']) .tosse-vomito .flusso--faringe path,
  [data-passaggio='fuori'] .tosse-vomito .flusso--bocca path {
    stroke-dashoffset: 0;
  }
  [data-passaggio='risalita'] .tosse-vomito .flusso--esofago path {
    transition-duration: 1.4s;
    transition-delay: 0.5s;
  }
  [data-passaggio='vie-aeree-chiuse'] .tosse-vomito .flusso--faringe path {
    transition-delay: 1.4s;
  }

  /* --- Cardias aperto mentre il contenuto risale --- */

  .tosse-vomito :is(.cardias__sx, .cardias__dx) {
    transition: transform 0.6s ease-in-out;
  }
  :is([data-passaggio='risalita'], [data-passaggio='vie-aeree-chiuse'], [data-passaggio='fuori']) .tosse-vomito .cardias__sx {
    transform: translateX(-12px);
  }
  :is([data-passaggio='risalita'], [data-passaggio='vie-aeree-chiuse'], [data-passaggio='fuori']) .tosse-vomito .cardias__dx {
    transform: translateX(12px);
  }

  /* --- Chiusura delle vie dell'aria (come nella deglutizione) --- */

  .tosse-vomito :is(.palato-molle, .laringe, .epiglottide) {
    transition: transform 0.8s ease-in-out;
  }
  :is([data-passaggio='vie-aeree-chiuse'], [data-passaggio='fuori']) .tosse-vomito .palato-molle {
    transform: rotate(58deg);
  }
  :is([data-passaggio='vie-aeree-chiuse'], [data-passaggio='fuori']) .tosse-vomito .laringe {
    transform: translateY(-16px);
  }
  :is([data-passaggio='vie-aeree-chiuse'], [data-passaggio='fuori']) .tosse-vomito .epiglottide {
    transform: rotate(-68deg);
  }
