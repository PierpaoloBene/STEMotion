---
/**
 * La digestione: dallo stomaco all'intestino crasso, vista di fronte.
 *
 * Ogni stato è disegnato solo con CSS a partire da [data-passaggio] del palco
 * (docs/STRUTTURA-ARGOMENTO.md, §4). Gli organi sono i componenti condivisi in vista
 * frontale di src/components/anatomia.
 *
 * Inquadrature: tutto l'addome (1, 9, 10), lo stomaco (2–4), il duodeno (5–6);
 * nei passaggi 7–8 si apre la "lente" con i villi visti al microscopio.
 */
import AddomeFronte from '../../../src/components/anatomia/AddomeFronte.astro';
import Pancreas from '../../../src/components/anatomia/Pancreas.astro';
import Fegato from '../../../src/components/anatomia/Fegato.astro';
import IntestinoTenue from '../../../src/components/anatomia/IntestinoTenue.astro';
import StomacoFronte from '../../../src/components/anatomia/StomacoFronte.astro';
import IntestinoCrasso from '../../../src/components/anatomia/IntestinoCrasso.astro';
import Villi from '../../../src/components/anatomia/Villi.astro';

interface Etichetta {
  testo: string;
  /** Inizio della riga di base del testo. */
  x: number;
  y: number;
  /** Linea dal testo all'organo: [x1, y1, x2, y2]; il pallino va sull'organo. */
  linea: [number, number, number, number];
  passaggio: string;
  /** Ingrandimento dell'inquadratura: il testo resta della stessa misura sullo schermo. */
  zoom: number;
}

const etichette: Etichetta[] = [
  { testo: 'Esofago', x: 600, y: 42, linea: [592, 34, 446, 30], passaggio: 'percorso', zoom: 1 },
  { testo: 'Stomaco', x: 600, y: 178, linea: [592, 170, 552, 170], passaggio: 'percorso', zoom: 1 },
  { testo: 'Intestino tenue', x: 586, y: 448, linea: [578, 440, 494, 440], passaggio: 'percorso', zoom: 1 },
  { testo: 'Intestino crasso', x: 20, y: 408, linea: [244, 400, 268, 400], passaggio: 'percorso', zoom: 1 },
  { testo: 'Pareti di muscolo', x: 470, y: 42, linea: [540, 46, 548, 106], passaggio: 'rimescolamento', zoom: 2 },
  { testo: 'Succo gastrico', x: 446, y: 42, linea: [500, 46, 512, 104], passaggio: 'succo-gastrico', zoom: 2 },
  { testo: 'Chimo', x: 520, y: 318, linea: [528, 310, 490, 258], passaggio: 'succo-gastrico', zoom: 2 },
  { testo: 'Piloro', x: 300, y: 232, linea: [338, 234, 380, 246], passaggio: 'piloro', zoom: 2 },
  { testo: 'Duodeno', x: 286, y: 330, linea: [330, 326, 342, 316], passaggio: 'piloro', zoom: 2 },
  { testo: 'Bile', x: 230, y: 250, linea: [256, 246, 332, 256], passaggio: 'bile-pancreas', zoom: 2 },
  { testo: 'Succo pancreatico', x: 430, y: 380, linea: [470, 370, 470, 292], passaggio: 'bile-pancreas', zoom: 2 },
  { testo: 'Duodeno', x: 230, y: 360, linea: [276, 356, 340, 334], passaggio: 'bile-pancreas', zoom: 2 },
  { testo: 'Sostanze nutritive', x: 216, y: 412, linea: [290, 402, 356, 334], passaggio: 'molecole', zoom: 2 },
  { testo: 'Villo', x: 82, y: 300, linea: [146, 292, 154, 292], passaggio: 'villi', zoom: 1 },
  { testo: 'Sostanze nutritive', x: 90, y: 72, linea: [200, 82, 202, 296], passaggio: 'villi', zoom: 1 },
  { testo: 'Capillari', x: 82, y: 430, linea: [180, 422, 208, 422], passaggio: 'sangue', zoom: 1 },
  { testo: 'Sangue verso il fegato', x: 300, y: 596, linea: [560, 588, 600, 548], passaggio: 'sangue', zoom: 1 },
  { testo: 'Intestino crasso', x: 20, y: 408, linea: [244, 400, 268, 400], passaggio: 'acqua', zoom: 1 },
  { testo: 'Acqua', x: 600, y: 408, linea: [592, 400, 566, 400], passaggio: 'acqua', zoom: 1 },
  { testo: 'Feci', x: 600, y: 590, linea: [592, 582, 414, 594], passaggio: 'feci', zoom: 1 },
  { testo: 'Ano', x: 600, y: 650, linea: [592, 642, 410, 646], passaggio: 'feci', zoom: 1 },
];

// Cosa mostra il disegno a ogni passaggio, per chi usa uno screen reader.
const descrizioni: Record<string, string> = {
  percorso: 'Addome visto di fronte. Il cibo scende dall’esofago nello stomaco, poi passa nell’intestino tenue, tutto ripiegato, e infine nell’intestino crasso, che gli fa da cornice.',
  rimescolamento: 'Lo stomaco ingrandito. Le pareti di muscolo si stringono a onde e i pezzi di cibo cambiano posto.',
  'succo-gastrico': 'Dalle pareti dello stomaco escono gocce di succo gastrico. I pezzi di cibo si sciolgono in una pappa: il chimo.',
  piloro: 'Il piloro, in fondo allo stomaco, si apre e lascia passare un po’ di chimo nel duodeno.',
  'bile-pancreas': 'Dalla cistifellea, sotto il fegato, scendono gocce di bile; dal pancreas arriva il succo pancreatico. Si uniscono al chimo nel duodeno.',
  molecole: 'Il chimo nel duodeno si scompone in tante palline piccolissime: le sostanze nutritive.',
  villi: 'Si apre una lente sulla parete dell’intestino tenue: tante sporgenze a forma di dito, i villi. Le sostanze nutritive passano dentro i villi.',
  sangue: 'Le sostanze nutritive entrano nei capillari dei villi e il sangue le porta via, verso il fegato.',
  acqua: 'Di nuovo tutto l’addome. Dall’intestino crasso escono gocce d’acqua, che tornano nel corpo.',
  feci: 'I resti, ormai solidi, scendono lungo l’intestino crasso fino al retto ed escono dall’ano.',
};

// Pezzi di cibo nello stomaco: posizione all'arrivo e dopo il rimescolamento.
const bocconi = [
  { x: 500, y: 128, x2: 522, y2: 140, r: 40, d: 'M-10 -7L8 -9L11 4L-3 10L-11 3Z' },
  { x: 530, y: 166, x2: 498, y2: 172, r: -60, d: 'M-9 -9L9 -6L8 8L-8 9Z' },
  { x: 494, y: 194, x2: 530, y2: 204, r: 80, d: 'M-11 -4L-2 -10L10 -3L6 9L-7 8Z' },
  { x: 526, y: 222, x2: 480, y2: 228, r: -30, d: 'M-8 -8L10 -5L7 9L-10 6Z' },
  { x: 478, y: 244, x2: 508, y2: 248, r: 50, d: 'M-10 -6L6 -9L11 5L-5 9Z' },
];

// Gocce di succo gastrico: escono dalla parete (x, y) e scendono verso il centro (dx, dy).
const goccePareti = [
  { x: 548, y: 148, dx: -16, dy: 6 },
  { x: 552, y: 196, dx: -16, dy: 0 },
  { x: 528, y: 244, dx: -12, dy: -10 },
  { x: 470, y: 264, dx: 0, dy: -14 },
  { x: 506, y: 92, dx: 0, dy: 16 },
  { x: 470, y: 124, dx: 14, dy: 10 },
];
// Bile: dalla cistifellea al duodeno. Succo pancreatico: dal pancreas al duodeno.
const gocceBile = [
  { x: 320, y: 220, x2: 350, y2: 302 },
  { x: 322, y: 228, x2: 356, y2: 314 },
  { x: 318, y: 214, x2: 348, y2: 324 },
];
const goccePancreas = [
  { x: 500, y: 287, x2: 362, y2: 300 },
  { x: 470, y: 290, x2: 368, y2: 310 },
  { x: 440, y: 294, x2: 358, y2: 318 },
];
// Sostanze nutritive nel duodeno.
const nutrientiDuodeno = [
  [344, 292],
  [352, 306],
  [343, 320],
  [356, 332],
  [372, 340],
  [392, 343],
  [360, 296],
];
// Sostanze nutritive nella lente: nel lume, dentro i villi, nel sangue.
const nutrientiVilli = [
  { l: [140, 92], v: [202, 300], s: [212, 470] },
  { l: [250, 122], v: [204, 384], s: [352, 500] },
  { l: [330, 80], v: [342, 282], s: [300, 546] },
  { l: [420, 140], v: [344, 364], s: [420, 546] },
  { l: [500, 96], v: [482, 320], s: [520, 546] },
  { l: [580, 132], v: [484, 402], s: [600, 546] },
  { l: [660, 92], v: [622, 292], s: [660, 546] },
  { l: [380, 172], v: [624, 372], s: [708, 546] },
];
// Acqua: dal centro del colon (x, y) verso fuori (x2, y2).
const gocceAcqua = [
  { x: 290, y: 470, x2: 250, y2: 470 },
  { x: 290, y: 420, x2: 250, y2: 420 },
  { x: 292, y: 360, x2: 252, y2: 360 },
  { x: 522, y: 380, x2: 562, y2: 380 },
  { x: 522, y: 440, x2: 562, y2: 440 },
  { x: 520, y: 500, x2: 560, y2: 500 },
];
// Feci: dal colon discendente al retto.
const feci = [
  { x: 522, y: 420, x2: 406, y2: 566 },
  { x: 522, y: 460, x2: 404, y2: 596 },
  { x: 516, y: 500, x2: 401, y2: 626 },
];

const GOCCIA = 'M0 -7C3 -3 5 0 5 3A5 5 0 0 1 -5 3C-5 0 -3 -3 0 -7Z';
const px = (n: number) => `${n}px`;
const larghezzaTesto = (t: string, fs: number) => t.length * fs * 0.56;
---

<div class="digestione">
  <svg viewBox="0 0 800 640" aria-hidden="true" focusable="false">
    <g class="camera">
      <AddomeFronte />
      <Pancreas />
      <Fegato />
      <IntestinoTenue />
      <StomacoFronte />
      <IntestinoCrasso />

      <!-- contrazioni dello stomaco: frecce che spingono verso l'interno -->
      <g class="onde">
        <path d="M584 150H566M572 143L565 150L572 157"></path>
        <path d="M578 222L562 214M566 208L561 215L569 220"></path>
        <path d="M528 290L520 274M514 281L520 273L527 278"></path>
      </g>

      <path class="chimo" d="M470 202C500 190 544 200 546 226C540 256 500 270 460 270C436 270 418 264 408 256C426 248 448 232 470 202Z"></path>
      {
        bocconi.map((b) => (
          <g class="boccone" style={`--x: ${px(b.x)}; --y: ${px(b.y)}; --x2: ${px(b.x2)}; --y2: ${px(b.y2)}; --r: ${b.r}deg`}>
            <path d={b.d} />
          </g>
        ))
      }
      {
        goccePareti.map((g) => (
          <g class="goccia goccia--gastrica" style={`--x: ${px(g.x)}; --y: ${px(g.y)}; --dx: ${px(g.dx)}; --dy: ${px(g.dy)}`}>
            <path d={GOCCIA} />
          </g>
        ))
      }
      <g class="porzione">
        <ellipse rx="10" ry="8"></ellipse>
      </g>
      {
        [...gocceBile, ...goccePancreas].map((g, i) => (
          <g class="goccia goccia--duodeno" style={`--x: ${px(g.x)}; --y: ${px(g.y)}; --x2: ${px(g.x2)}; --y2: ${px(g.y2)}; --ritardo: ${(i % 3) * 0.2}s`}>
            <path d={GOCCIA} />
          </g>
        ))
      }
      {
        nutrientiDuodeno.map(([x, y], i) => (
          <circle class="nutriente nutriente--duodeno" cx={x} cy={y} r="4" style={`--ritardo: ${0.4 + i * 0.08}s`} />
        ))
      }
      {
        gocceAcqua.map((g, i) => (
          <g class="goccia goccia--acqua" style={`--x: ${px(g.x)}; --y: ${px(g.y)}; --x2: ${px(g.x2)}; --y2: ${px(g.y2)}; --ritardo: ${i * 0.1}s`}>
            <path d={GOCCIA} />
          </g>
        ))
      }
      {
        feci.map((f, i) => (
          <g class="fecale" style={`--x: ${px(f.x)}; --y: ${px(f.y)}; --x2: ${px(f.x2)}; --y2: ${px(f.y2)}; --ritardo: ${i * 0.15}s`}>
            <ellipse rx="11" ry="9"></ellipse>
          </g>
        ))
      }
      <path class="uscita" d="M400 646V676M390 666L400 678L410 666"></path>

      {
        etichette
          .filter((e) => e.passaggio !== 'villi' && e.passaggio !== 'sangue')
          .map((e) => {
            const fs = 24 / e.zoom;
            return (
              <g class="etichetta" data-per={e.passaggio}>
                <line x1={e.linea[0]} y1={e.linea[1]} x2={e.linea[2]} y2={e.linea[3]} />
                <circle cx={e.linea[2]} cy={e.linea[3]} r={3.5 / e.zoom} />
                <rect x={e.x - fs * 0.3} y={e.y - fs * 0.95} width={larghezzaTesto(e.testo, fs) + fs * 0.6} height={fs * 1.3} rx={fs * 0.65} />
                <text x={e.x} y={e.y} style={`font-size: ${fs}px`}>
                  {e.testo}
                </text>
              </g>
            );
          })
      }
    </g>

    <!-- la lente sui villi: si apre dal centro dell'intestino tenue -->
    <g transform="translate(410 440)">
      <g class="lente">
        <g transform="translate(-410 -440)">
          <Villi />
          {
            nutrientiVilli.map((n, i) => (
              <circle
                class="nutriente nutriente--villi"
                r="9"
                style={`--lx: ${px(n.l[0])}; --ly: ${px(n.l[1])}; --vx: ${px(n.v[0])}; --vy: ${px(n.v[1])}; --sx: ${px(n.s[0])}; --sy: ${px(n.s[1])}; --ritardo: ${0.5 + i * 0.07}s`}
              />
            ))
          }
          {
            etichette
              .filter((e) => e.passaggio === 'villi' || e.passaggio === 'sangue')
              .map((e) => (
                <g class="etichetta" data-per={e.passaggio}>
                  <line x1={e.linea[0]} y1={e.linea[1]} x2={e.linea[2]} y2={e.linea[3]} />
                  <circle cx={e.linea[2]} cy={e.linea[3]} r="3.5" />
                  <rect x={e.x - 7} y={e.y - 23} width={larghezzaTesto(e.testo, 24) + 14} height="31" rx="15.5" />
                  <text x={e.x} y={e.y} style="font-size: 24px">
                    {e.testo}
                  </text>
                </g>
              ))
          }
        </g>
      </g>
    </g>
  </svg>

  <div class="solo-lettori">
    {
      Object.entries(descrizioni).map(([id, testo]) => (
        <p class="descrizione" data-per={id}>
          Disegno: {testo}
        </p>
      ))
    }
  </div>
</div>

<style is:global>
  .digestione {
    position: absolute;
    inset: 0;
  }
  .digestione svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Contorni sempre dello stesso spessore negli ingrandimenti (i tubi invece crescono con lo zoom). */
  .digestione svg :is(.addome__pelle, .fegato__forma, .fegato__cistifellea, .pancreas__forma, .stomaco-fronte__contorno, .stomaco-fronte__esofago, .piloro rect, .crasso__cieco, .appendice__parete, .boccone path, .chimo, .porzione ellipse, .goccia path, .nutriente, .fecale ellipse, .onde path, .uscita, .etichetta line) {
    vector-effect: non-scaling-stroke;
  }

  /* --- Inquadratura --- */

  .digestione .camera {
    transform: translate(0, 0) scale(1);
    transition: transform 1.2s ease-in-out;
  }
  :is([data-passaggio='rimescolamento'], [data-passaggio='succo-gastrico'], [data-passaggio='piloro']) .digestione .camera {
    transform: translate(-520px, -40px) scale(2);
  }
  :is([data-passaggio='bile-pancreas'], [data-passaggio='molecole']) .digestione .camera {
    transform: translate(-380px, -240px) scale(2);
  }
  :is([data-passaggio='villi'], [data-passaggio='sangue']) .digestione .camera {
    transform: translate(-174px, -296px) scale(1.4);
  }
  [data-passaggio='feci'] .digestione .camera {
    transform: translate(0, -40px) scale(1);
  }

  /* Negli ingrandimenti su stomaco e duodeno il colon, che sta davanti, diventa trasparente. */
  .digestione :is(.crasso, .anse) {
    transition: opacity 0.6s ease-in-out;
  }
  :is([data-passaggio='rimescolamento'], [data-passaggio='succo-gastrico'], [data-passaggio='piloro'], [data-passaggio='bile-pancreas'], [data-passaggio='molecole']) .digestione .crasso {
    opacity: 0.15;
  }
  :is([data-passaggio='bile-pancreas'], [data-passaggio='molecole']) .digestione .anse {
    opacity: 0.4;
  }

  /* --- Stomaco: rimescolamento, succo gastrico, chimo --- */

  .digestione .boccone {
    transform: translate(var(--x), var(--y));
    transition:
      transform 1.4s ease-in-out,
      opacity 0.8s ease-in-out;
  }
  .digestione .boccone path {
    fill: var(--cibo);
    stroke: var(--contorno);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  [data-passaggio='rimescolamento'] .digestione .boccone {
    transform: translate(var(--x2), var(--y2)) rotate(var(--r));
  }
  /* Dal succo gastrico in poi i pezzi si sciolgono nel chimo. */
  [data-indice]:not([data-indice='-1'], [data-indice='0'], [data-indice='1']) .digestione .boccone {
    transform: translate(var(--x2), var(--y2)) rotate(var(--r)) scale(0.3);
    opacity: 0;
  }

  .digestione .onde {
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }
  .digestione .onde path {
    fill: none;
    stroke: var(--contorno);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  [data-passaggio='rimescolamento'] .digestione .onde {
    opacity: 1;
    transition-delay: 0.6s;
  }

  .digestione .chimo {
    fill: var(--cibo);
    stroke: var(--contorno);
    stroke-width: 2;
    opacity: 0;
    transition: opacity 1s ease-in-out;
  }
  [data-indice]:not([data-indice='-1'], [data-indice='0'], [data-indice='1']) .digestione .chimo {
    opacity: 0.7;
  }
  [data-passaggio='succo-gastrico'] .digestione .chimo {
    transition-delay: 0.6s;
  }

  .digestione .goccia path {
    stroke: var(--contorno);
    stroke-width: 1.5;
  }
  .digestione .goccia {
    opacity: 0;
    transition:
      transform 1s ease-in-out,
      opacity 0.3s ease-in-out;
  }
  .digestione .goccia--gastrica {
    transform: translate(var(--x), var(--y)) scale(0.6);
  }
  .digestione :is(.goccia--gastrica, .goccia--duodeno) path {
    fill: var(--succhi);
  }
  [data-passaggio='succo-gastrico'] .digestione .goccia--gastrica {
    transform: translate(calc(var(--x) + var(--dx)), calc(var(--y) + var(--dy))) scale(0.6);
    opacity: 1;
  }

  /* --- Piloro e duodeno --- */

  .digestione :is(.piloro__su, .piloro__giu) {
    transition: transform 0.5s ease-in-out;
  }
  [data-passaggio='piloro'] .digestione .piloro__su {
    transform: translateY(-6px);
  }
  [data-passaggio='piloro'] .digestione .piloro__giu {
    transform: translateY(6px);
  }

  .digestione .porzione {
    transform: translate(418px, 258px);
    opacity: 0;
    transition:
      transform 1.2s ease-in-out,
      opacity 0.4s ease-in-out;
  }
  .digestione .porzione ellipse {
    fill: var(--cibo);
    stroke: var(--contorno);
    stroke-width: 2;
  }
  [data-passaggio='piloro'] .digestione .porzione {
    transform: translate(350px, 300px);
    opacity: 1;
    transition-delay: 0.4s, 0s;
  }
  [data-passaggio='bile-pancreas'] .digestione .porzione {
    transform: translate(350px, 300px);
    opacity: 1;
  }
  [data-passaggio='molecole'] .digestione .porzione {
    transform: translate(350px, 300px) scale(0.3);
    opacity: 0;
  }

  .digestione .goccia--duodeno {
    transform: translate(var(--x), var(--y)) scale(0.45);
  }
  [data-passaggio='bile-pancreas'] .digestione .goccia--duodeno {
    transform: translate(var(--x2), var(--y2)) scale(0.45);
    opacity: 1;
    transition:
      transform 1.4s ease-in-out var(--ritardo),
      opacity 0.3s ease-in-out;
  }

  .digestione .nutriente {
    fill: var(--nutrienti);
    stroke: var(--contorno);
    stroke-width: 1.5;
  }
  .digestione .nutriente--duodeno {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.2);
    transition:
      opacity 0.3s ease-in-out,
      transform 0.6s ease-in-out;
  }
  [data-passaggio='molecole'] .digestione .nutriente--duodeno {
    opacity: 1;
    transform: scale(1);
    transition-delay: var(--ritardo);
  }

  /* --- La lente sui villi --- */

  .digestione .lente {
    transform: scale(0.1);
    opacity: 0;
    transition:
      transform 0.8s ease-in-out,
      opacity 0.5s ease-in-out;
  }
  :is([data-passaggio='villi'], [data-passaggio='sangue']) .digestione .lente {
    transform: scale(1);
    opacity: 1;
  }
  .digestione .nutriente--villi {
    transform: translate(var(--lx), var(--ly));
    transition: transform 1.4s ease-in-out;
  }
  [data-passaggio='villi'] .digestione .nutriente--villi {
    transform: translate(var(--vx), var(--vy));
    transition-delay: var(--ritardo);
  }
  [data-passaggio='sangue'] .digestione .nutriente--villi {
    transform: translate(var(--sx), var(--sy));
    transition-delay: calc(var(--ritardo) - 0.4s);
  }

  /* --- Intestino crasso: acqua e feci --- */

  .digestione .goccia--acqua {
    transform: translate(var(--x), var(--y)) scale(1.5);
  }
  .digestione .goccia--acqua path {
    fill: var(--acqua);
  }
  [data-passaggio='acqua'] .digestione .goccia--acqua {
    transform: translate(var(--x2), var(--y2)) scale(1.5);
    opacity: 1;
    transition:
      transform 1.2s ease-in-out calc(0.4s + var(--ritardo)),
      opacity 0.3s ease-in-out var(--ritardo);
  }

  .digestione .fecale {
    transform: translate(var(--x), var(--y));
    opacity: 0;
    transition:
