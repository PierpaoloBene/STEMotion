  /* --- Elemento evidenziato nel passaggio corrente (guida di stile, §3) --- */

  [data-indice='1'] .osmosi .membrana,
  [data-indice='2'] .osmosi .lente__anello,
  [data-indice='5'] .osmosi .liquido__pelo,
  [data-indice='7'] .osmosi .cellula__membrana {
    stroke: var(--accento);
    stroke-width: 4;
  }
  [data-indice='3'] .osmosi .passante--3,
  [data-indice='4'] .osmosi .passante--4,
