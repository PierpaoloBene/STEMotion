  [data-indice='3'] .osmosi .molecola--urta {
    stroke: var(--accento);
    stroke-width: 3;
  }

  /* --- Descrizione per gli screen reader: solo quella del passaggio corrente --- */

  .osmosi .descrizione {
    display: none;
  }
  [data-passaggio='due-liquidi'] .osmosi .descrizione[data-per='due-liquidi'],
  [data-passaggio='membrana'] .osmosi .descrizione[data-per='membrana'],
  [data-passaggio='ingrandimento'] .osmosi .descrizione[data-per='ingrandimento'],
  [data-passaggio='semipermeabile'] .osmosi .descrizione[data-per='semipermeabile'],
  [data-passaggio='osmosi'] .osmosi .descrizione[data-per='osmosi'],
  [data-passaggio='livelli'] .osmosi .descrizione[data-per='livelli'],
  [data-passaggio='equilibrio'] .osmosi .descrizione[data-per='equilibrio'],
  [data-passaggio='cellula'] .osmosi .descrizione[data-per='cellula'],
  [data-passaggio='stessa-concentrazione'] .osmosi .descrizione[data-per='stessa-concentrazione'],
  [data-passaggio='acqua-pura'] .osmosi .descrizione[data-per='acqua-pura'],
  [data-passaggio='molto-zucchero'] .osmosi .descrizione[data-per='molto-zucchero'] {
    display: block;
  }
</style>
