  /* --- Stato di ogni passaggio ---
     0 tre-stati · 1 molecole · 2 solido · 3 solido-forma · 4 liquido
     5 liquido-forma · 6 gas · 7 gas-volume · 8 confronto */

  [data-indice]:not([data-indice='-1'], [data-indice='0']) .stati .colonna--solido,
