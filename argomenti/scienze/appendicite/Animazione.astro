---
/**
 * L'appendicite: come nasce, come peggiora e come si cura. Addome visto di fronte.
 *
 * Ogni stato è disegnato solo con CSS a partire da [data-passaggio] del palco
 * (docs/STRUTTURA-ARGOMENTO.md, §4). Organi condivisi in vista frontale
 * (src/components/anatomia); il contenuto dell'appendice è AppendiceInterno.
 *
 * Inquadrature: tutto l'addome (1, 6, 7) e l'appendice ingrandita (2–5).
 * La deviazione "senza-cure" (deviazioni/) mostra che cosa succede se non si opera.
 */
import AddomeFronte from '../../../src/components/anatomia/AddomeFronte.astro';
import Pancreas from '../../../src/components/anatomia/Pancreas.astro';
import Fegato from '../../../src/components/anatomia/Fegato.astro';
import IntestinoTenue from '../../../src/components/anatomia/IntestinoTenue.astro';
import StomacoFronte from '../../../src/components/anatomia/StomacoFronte.astro';
import IntestinoCrasso from '../../../src/components/anatomia/IntestinoCrasso.astro';
import AppendiceInterno from '../../../src/components/anatomia/AppendiceInterno.astro';

interface Etichetta {
  testo: string;
  x: number;
  y: number;
  linea: [number, number, number, number];
  passaggio: string;
  zoom: number;
}

const Z = 3.2; // ingrandimento sull'appendice
const etichette: Etichetta[] = [
  { testo: 'Appendice', x: 20, y: 600, linea: [150, 592, 326, 566], passaggio: 'appendice', zoom: 1 },
  { testo: 'Cieco', x: 20, y: 528, linea: [96, 520, 272, 520], passaggio: 'appendice', zoom: 1 },
  { testo: 'Intestino crasso', x: 20, y: 420, linea: [244, 412, 268, 412], passaggio: 'appendice', zoom: 1 },
  { testo: 'Tappo', x: 360, y: 512, linea: [362, 514, 315, 541], passaggio: 'tappo', zoom: Z },
  { testo: 'Batteri', x: 368, y: 612, linea: [368, 608, 330, 568], passaggio: 'batteri', zoom: Z },
  { testo: 'Appendice gonfia', x: 366, y: 632, linea: [366, 628, 340, 584], passaggio: 'gonfiore', zoom: Z },
  { testo: 'Infiammazione', x: 360, y: 486, linea: [370, 488, 334, 560], passaggio: 'infiammazione', zoom: Z },
  { testo: 'Ombelico', x: 600, y: 408, linea: [592, 400, 412, 400], passaggio: 'dolore', zoom: 1 },
  { testo: 'Dolore', x: 20, y: 522, linea: [112, 514, 306, 514], passaggio: 'dolore', zoom: 1 },
  { testo: 'Piccoli tagli', x: 600, y: 508, linea: [592, 500, 482, 500], passaggio: 'intervento', zoom: 1 },
];

// Cosa mostra il disegno a ogni passaggio, per chi usa uno screen reader.
const descrizioni: Record<string, string> = {
  appendice: 'Addome visto di fronte. In basso a sinistra nel disegno, cioè a destra della persona, l’intestino crasso comincia con il cieco; dal cieco pende l’appendice, un tubicino chiuso in fondo.',
  tappo: 'L’appendice ingrandita. Un pezzetto di feci indurito scivola all’ingresso dell’appendice e lo chiude.',
  batteri: 'Dentro l’appendice chiusa compaiono sempre più batteri, a forma di bastoncino.',
  gonfiore: 'L’appendice si allarga e si gonfia.',
  infiammazione: 'La parete dell’appendice diventa rossa e compaiono vasi sanguigni dilatati.',
  dolore: 'Di nuovo tutto l’addome. Un segno di dolore parte dall’ombelico e scende in basso a sinistra nel disegno, sopra l’appendice infiammata.',
  intervento: 'Sulla pancia compaiono tre piccoli tagli. L’appendice viene tolta e il cieco resta chiuso con dei punti.',
};

const STELLA = 'M0 -17L4 -7L14 -10L8 -1L16 6L5 7L4 17L-3 9L-12 13L-9 3L-17 -2L-7 -5Z';
const tagli = [
  [400, 418],
  [400, 562],
  [470, 500],
];
const larghezzaTesto = (t: string, fs: number) => t.length * fs * 0.56;
// Passaggi in cui una cosa è già successa (lo stato dipende solo dal passaggio corrente).
const da = (ids: string[]) => ids.map((id) => `[data-passaggio='${id}']`).join(', ');
---

<div class="appendicite">
  <svg viewBox="0 0 800 640" aria-hidden="true" focusable="false">
    <g class="camera">
      <AddomeFronte />
      <Pancreas />
      <Fegato />
      <IntestinoTenue />
      <StomacoFronte />
      <IntestinoCrasso>
        <AppendiceInterno slot="appendice" />
      </IntestinoCrasso>

      <path class="moncone" d="M302 532L318 544M304 544L316 532"></path>

      <!-- dolore: parte dall'ombelico e scende verso l'appendice -->
      <path class="ombelico" d="M393 400C396 393 404 393 407 400C404 407 396 407 393 400Z"></path>
      <path class="percorso-dolore" d="M396 412C380 446 358 476 338 502M341 490L336 504L350 500"></path>
      <g class="dolore">
        <path d={STELLA}></path>
      </g>

      {
        tagli.map(([x, y]) => (
          <path class="taglio" d={`M${x - 10} ${y}H${x + 10}M${x - 6} ${y - 5}V${y + 5}M${x} ${y - 5}V${y + 5}M${x + 6} ${y - 5}V${y + 5}`} />
        ))
      }

      {
        etichette.map((e) => {
          const fs = 24 / e.zoom;
          return (
            <g class="etichetta" data-per={e.passaggio}>
              <line x1={e.linea[0]} y1={e.linea[1]} x2={e.linea[2]} y2={e.linea[3]} />
              <circle cx={e.linea[2]} cy={e.linea[3]} r={3.5 / e.zoom} />
              <rect x={e.x - fs * 0.3} y={e.y - fs * 0.95} width={larghezzaTesto(e.testo, fs) + fs * 0.6} height={fs * 1.3} rx={fs * 0.65} />
              <text x={e.x} y={e.y} style={`font-size: ${fs}px`}>
                {e.testo}
              </text>
            </g>
          );
        })
      }
    </g>
  </svg>

  <div class="solo-lettori">
    {
      Object.entries(descrizioni).map(([id, testo]) => (
        <p class="descrizione" data-per={id}>
          Disegno: {testo}
        </p>
      ))
    }
  </div>
</div>

<style is:inline set:html={`
  .appendicite {
    position: absolute;
    inset: 0;
  }
  .appendicite svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .appendicite svg :is(.addome__pelle, .fegato__forma, .fegato__cistifellea, .pancreas__forma, .stomaco-fronte__contorno, .stomaco-fronte__esofago, .piloro rect, .crasso__cieco, .appendice__parete, .appendice__lume, .tappo ellipse, .vasi path, .moncone, .ombelico, .percorso-dolore, .dolore path, .taglio, .etichetta line) {
    vector-effect: non-scaling-stroke;
  }

  /* --- Inquadratura --- */
  .appendicite .camera {
    transform: translate(0, 0) scale(1);
    transition: transform 1.2s ease-in-out;
  }
  :is(${da(['tappo', 'batteri', 'gonfiore', 'infiammazione'])}) .appendicite .camera {
    transform: translate(-630.4px, -1433.6px) scale(${Z});
  }

  /* Nell'ingrandimento i bordi dei tubi restano sottili come nel resto del disegno. */
  .appendicite :is(.tubo-bordo, .crasso__bordo) {
    transition: stroke-width 1.2s ease-in-out;
  }
  :is(${da(['tappo', 'batteri', 'gonfiore', 'infiammazione'])}) .appendicite .tubo-bordo {
    stroke-width: 19.6;
  }
  :is(${da(['tappo', 'batteri', 'gonfiore', 'infiammazione'])}) .appendicite .crasso__bordo {
    stroke-width: 41.6;
  }

  /* --- Dentro l'appendice: ogni cambiamento resta nei passaggi successivi --- */
  .appendicite .tappo {
    transition: transform 1.2s ease-in-out, opacity 0.3s ease-in-out;
  }
  :is(${da(['tappo', 'batteri', 'gonfiore', 'infiammazione', 'dolore', 'intervento'])}) .appendicite .tappo {
    opacity: 1;
    transform: translateY(6px);
  }
  [data-passaggio='tappo'] .appendicite .tappo {
    transition-delay: 1s, 1s;
  }

  .appendicite .batteri {
    transition: opacity 0.4s ease-in-out;
  }
  :is(${da(['batteri', 'gonfiore', 'infiammazione', 'dolore', 'intervento'])}) .appendicite .batteri {
    opacity: 1;
  }
  [data-passaggio='batteri'] .appendicite .batteri--1 { transition-delay: 0.2s; }
  [data-passaggio='batteri'] .appendicite .batteri--2 { transition-delay: 0.8s; }
  [data-passaggio='batteri'] .appendicite .batteri--3 { transition-delay: 1.4s; }

  .appendicite .appendice__corpo {
    transition: transform 1.4s ease-in-out;
  }
  :is(${da(['gonfiore', 'infiammazione', 'dolore', 'intervento'])}) .appendicite .appendice__corpo {
    transform: scale(1.8, 1.1);
  }

  .appendicite .appendice__parete {
    transition: fill 1.2s ease-in-out, stroke 0.3s ease-in-out;
  }
  :is(${da(['infiammazione', 'dolore', 'intervento'])}) .appendicite .appendice__parete {
    fill: var(--tessuto-infiammato);
  }
  .appendicite .vasi path {
    transition: opacity 0.8s ease-in-out;
  }
  :is(${da(['infiammazione', 'dolore', 'intervento'])}) .appendicite .vasi path {
    opacity: 1;
  }
  [data-passaggio='infiammazione'] .appendicite .vasi path {
    transition-delay: 0.6s;
  }

  /* --- Il dolore --- */
  .appendicite :is(.ombelico, .percorso-dolore, .dolore) {
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }
  .appendicite .ombelico {
    fill: none;
    stroke: var(--contorno);
    stroke-width: 2.5;
  }
  .appendicite .percorso-dolore {
    fill: none;
    stroke: var(--contorno);
    stroke-width: 2.5;
    stroke-dasharray: 6 6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .appendicite .dolore {
    transform: translate(400px, 400px);
    transition: transform 1.4s ease-in-out, opacity 0.3s ease-in-out;
  }
  .appendicite .dolore path {
    fill: var(--tessuto-infiammato);
    stroke: var(--contorno);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  [data-passaggio='dolore'] .appendicite :is(.ombelico, .dolore) {
    opacity: 1;
  }
  [data-passaggio='dolore'] .appendicite .percorso-dolore {
    opacity: 1;
    transition-delay: 0.6s;
  }
  [data-passaggio='dolore'] .appendicite .dolore {
    transform: translate(324px, 514px);
    transition-delay: 0.6s, 0s;
  }
  [data-passaggio='intervento'] .appendicite .ombelico {
    opacity: 1;
  }

  /* --- L'operazione --- */
  .appendicite .taglio {
    fill: none;
    stroke: var(--contorno);
    stroke-width: 2.5;
    stroke-linecap: round;
    opacity: 0;
    transition: opacity 0.4s ease-in-out;
  }
  .appendicite .appendice {
    transition: transform 1.2s ease-in-out, opacity 0.8s ease-in-out;
  }
  .appendicite .moncone {
    fill: none;
    stroke: var(--contorno);
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0;
    transition: opacity 0.4s ease-in-out;
  }
  [data-passaggio='intervento'] .appendicite .taglio {
    opacity: 1;
  }
  [data-passaggio='intervento'] .appendicite .appendice {
    transform: translateY(-40px);
    opacity: 0;
    transition-delay: 0.6s, 1s;
  }
  [data-passaggio='intervento'] .appendicite .moncone {
    opacity: 1;
    transition-delay: 1.6s;
  }

  /* --- Elemento evidenziato nel passaggio corrente (guida di stile, §3) --- */
  :is([data-passaggio='appendice'], [data-passaggio='gonfiore'], [data-passaggio='infiammazione']) .appendicite .appendice__parete,
  [data-passaggio='tappo'] .appendicite .tappo ellipse,
  [data-passaggio='dolore'] .appendicite .dolore path {
    stroke: var(--accento);
    stroke-width: 4;
  }

  /* --- Etichette: compaiono quando l'inquadratura si è fermata --- */
  .appendicite .etichetta {
    opacity: 0;
    transition: opacity 0.2s ease-in-out;
  }
  .appendicite .etichetta line { stroke: var(--testo-2); stroke-width: 1.5; }
  .appendicite .etichetta circle { fill: var(--testo-2); }
  .appendicite .etichetta rect { fill: var(--superficie); opacity: 0.92; }
  .appendicite .etichetta text { fill: var(--testo); font-weight: 700; }
  ${['appendice', 'tappo', 'batteri', 'gonfiore', 'infiammazione', 'dolore', 'intervento']
    .map((id) => `[data-passaggio='${id}'] .appendicite .etichetta[data-per='${id}']`)
    .join(',\n  ')} {
    opacity: 1;
    transition: opacity 0.4s ease-in-out 1.1s;
  }

  /* --- Descrizione per gli screen reader: solo quella del passaggio corrente --- */
  .appendicite .descrizione { display: none; }
  ${['appendice', 'tappo', 'batteri', 'gonfiore', 'infiammazione', 'dolore', 'intervento']
    .map((id) => `[data-passaggio='${id}'] .appendicite .descrizione[data-per='${id}']`)
    .join(',\n  ')} {
    display: block;
  }
`}></style>
