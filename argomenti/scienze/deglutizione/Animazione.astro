---
/**
 * La deglutizione: il bolo dalla bocca allo stomaco, in sezione di profilo.
 *
 * Ogni stato è disegnato solo con CSS a partire da [data-passaggio] del palco
 * (docs/STRUTTURA-ARGOMENTO.md, §4). Gli organi sono i componenti condivisi
 * di src/components/anatomia, tutti nello stesso sistema di riferimento.
 *
 * Due inquadrature: "vicina" su bocca e gola (passaggi 1–4),
 * "lontana" su esofago e stomaco (passaggi 5–6).
 */
import Sfumature from '../../../src/components/anatomia/Sfumature.astro';
import Corpo from '../../../src/components/anatomia/Corpo.astro';
import BoccaFaringe from '../../../src/components/anatomia/BoccaFaringe.astro';
import Esofago from '../../../src/components/anatomia/Esofago.astro';
import Laringe from '../../../src/components/anatomia/Laringe.astro';
import Stomaco from '../../../src/components/anatomia/Stomaco.astro';

interface Etichetta {
  testo: string;
  /** Posizione del testo (inizio della riga di base). */
  x: number;
  y: number;
  /** Linea dal testo all'organo: [x1, y1, x2, y2]; il pallino va sull'organo. */
  linea: [number, number, number, number];
  passaggio: string;
  vista: 'vicina' | 'lontana';
}

const etichette: Etichetta[] = [
  { testo: 'Bolo', x: 656, y: 290, linea: [650, 283, 538, 282], passaggio: 'masticazione', vista: 'vicina' },
  { testo: 'Denti', x: 656, y: 336, linea: [650, 329, 601, 300], passaggio: 'masticazione', vista: 'vicina' },
  { testo: 'Saliva', x: 656, y: 382, linea: [650, 375, 551, 296], passaggio: 'masticazione', vista: 'vicina' },
  { testo: 'Lingua', x: 656, y: 336, linea: [650, 329, 552, 296], passaggio: 'spinta-lingua', vista: 'vicina' },
  { testo: 'Faringe', x: 110, y: 505, linea: [204, 498, 382, 392], passaggio: 'spinta-lingua', vista: 'vicina' },
  { testo: 'Palato molle', x: 110, y: 470, linea: [268, 463, 416, 248], passaggio: 'chiusura-vie-aeree', vista: 'vicina' },
  { testo: 'Epiglottide', x: 505, y: 462, linea: [499, 455, 423, 384], passaggio: 'chiusura-vie-aeree', vista: 'vicina' },
  { testo: 'Laringe', x: 505, y: 506, linea: [499, 499, 468, 422], passaggio: 'chiusura-vie-aeree', vista: 'vicina' },
  { testo: 'Esofago', x: 110, y: 530, linea: [204, 523, 365, 478], passaggio: 'ingresso-esofago', vista: 'vicina' },
  { testo: 'Epiglottide', x: 505, y: 462, linea: [499, 455, 441, 372], passaggio: 'ingresso-esofago', vista: 'vicina' },
  { testo: 'Esofago', x: -30, y: 690, linea: [102, 682, 372, 682], passaggio: 'peristalsi', vista: 'lontana' },
  { testo: 'Contrazione', x: -30, y: 842, linea: [172, 834, 382, 834], passaggio: 'peristalsi', vista: 'lontana' },
  { testo: 'Bolo', x: 628, y: 890, linea: [622, 882, 408, 880], passaggio: 'peristalsi', vista: 'lontana' },
  { testo: 'Cardias', x: -30, y: 944, linea: [102, 936, 373, 934], passaggio: 'stomaco', vista: 'lontana' },
  { testo: 'Stomaco', x: 628, y: 1030, linea: [622, 1022, 560, 1012], passaggio: 'stomaco', vista: 'lontana' },
];

// Cosa mostra il disegno a ogni passaggio, per chi usa uno screen reader.
const descrizioni: Record<string, string> = {
  masticazione: 'Testa vista in sezione, di profilo. Nella bocca i pezzetti di cibo, masticati dai denti e bagnati dalla saliva, formano il bolo sopra la lingua.',
  'spinta-lingua': 'La lingua si alza contro il palato e spinge il bolo indietro, nella faringe.',
  'chiusura-vie-aeree': 'Il palato molle si alza e chiude il passaggio verso il naso. La laringe sale e l’epiglottide si piega sopra la sua apertura.',
  'ingresso-esofago': 'Il bolo scende ed entra nell’esofago, che si allarga per accoglierlo. L’epiglottide torna su.',
  peristalsi: 'La vista si allarga su collo e torace. Un anello di muscoli si stringe sopra il bolo e lo spinge giù lungo l’esofago.',
  stomaco: 'Il cardias, in fondo all’esofago, si apre, il bolo entra nello stomaco e il cardias si richiude.',
};

// Pezzetti di cibo prima della masticazione, attorno al punto in cui si forma il bolo.
const pezzetti = [
  { x: -30, y: -4, d: 'M-7 -5L6 -7L8 4L-4 7Z' },
  { x: 26, y: -8, d: 'M-6 -6L7 -4L5 6L-7 4Z' },
  { x: -6, y: 8, d: 'M-5 -7L7 -3L3 7L-7 3Z' },
  { x: 36, y: 6, d: 'M-6 -4L5 -7L7 5L-4 6Z' },
];
---

<div class="deglutizione">
  <svg viewBox="0 0 800 640" aria-hidden="true" focusable="false">
    <Sfumature />
    <g class="camera">
      <Corpo />
      <BoccaFaringe />
      <Esofago />
      <Laringe />
      <Stomaco />

      <!-- saliva: due gocce accanto al bolo -->
      <g class="saliva">
        <path d="M498 286C502 292 504 295 504 298A6 6 0 0 1 492 298C492 295 494 292 498 286Z"></path>
        <path d="M550 286C554 292 556 295 556 298A6 6 0 0 1 544 298C544 295 546 292 550 286Z"></path>
      </g>

      <!-- il bolo, con l'esofago che si allarga attorno e l'onda di contrazione sopra -->
      <g class="bolo-x">
        <g class="bolo-y">
          <g class="rigonfiamento">
            <ellipse class="rigonfiamento__muscolo" rx="27" ry="30"></ellipse>
            <ellipse class="rigonfiamento__mucosa" rx="20" ry="23"></ellipse>
          </g>
          <g class="contrazione">
            <path class="contrazione__muscolo" d="M-19 -68C-19 -56 -5 -54 -5 -47C-5 -40 -19 -38 -19 -26Z"></path>
            <path class="contrazione__muscolo" d="M19 -68C19 -56 5 -54 5 -47C5 -40 19 -38 19 -26Z"></path>
            <path class="contrazione__freccia" d="M-52 -47H-30M-37 -54L-30 -47L-37 -40M52 -47H30M37 -54L30 -47L37 -40"></path>
          </g>
          {
            pezzetti.map((p) => (
              <g class="pezzetto" style={`--px: ${p.x}px; --py: ${p.y}px`}>
                <path d={p.d} />
              </g>
            ))
          }
          <g class="bolo">
            <circle r="16"></circle>
            <!-- pezzetti di cibo ancora riconoscibili dentro il bolo -->
            <path class="bolo__grana" d="M-6 4L-2 2L-1 6ZM5 -4L9 -2L6 1ZM3 8L7 6L8 10ZM-10 -2L-7 -5L-6 -1Z"></path>
            <path class="bolo__riflesso" d="M-9 -5A10 10 0 0 1 -2 -12"></path>
          </g>
        </g>
      </g>

      {
        etichette.map((e) => (
          <g class:list={['etichetta', `etichetta--${e.vista}`, e.testo === 'Bolo' && 'etichetta--bolo']} data-per={e.passaggio}>
            <line x1={e.linea[0]} y1={e.linea[1]} x2={e.linea[2]} y2={e.linea[3]} />
            <circle cx={e.linea[2]} cy={e.linea[3]} r="3.5" />
            <text x={e.x} y={e.y}>
              {e.testo}
            </text>
          </g>
        ))
      }
    </g>
  </svg>

  <div class="solo-lettori">
    {
      Object.entries(descrizioni).map(([id, testo]) => (
        <p class="descrizione" data-per={id}>
          Disegno: {testo}
        </p>
      ))
    }
  </div>
</div>

<style is:global>
  .deglutizione {
    position: absolute;
    inset: 0;
  }
  .deglutizione svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Contorni sempre dello stesso spessore, anche quando l'inquadratura cambia. */
  .deglutizione svg :is(path, rect, circle, ellipse, line) {
    vector-effect: non-scaling-stroke;
  }

  /* --- Inquadratura --- */

  .deglutizione .camera {
    /* vicina: bocca e gola */
    transform: translate(-125px, -62.5px) scale(1.25);
    transition: transform 1.2s ease-in-out;
  }
  :is([data-passaggio='peristalsi'], [data-passaggio='stomaco']) .deglutizione .camera {
    /* lontana: dal collo allo stomaco */
    transform: translate(44.44px, -337.78px) scale(0.8889);
    transition-duration: 1s;
  }

  /* --- Bolo e cibo --- */

  .deglutizione .bolo circle {
    fill: url(#an-cibo);
    stroke: var(--cibo-bordo);
    stroke-width: 2;
    transition:
      stroke 0.3s ease-in-out,
      stroke-width 0.3s ease-in-out;
  }
  .deglutizione .bolo__grana {
    fill: var(--cibo-scuro);
    opacity: 0.6;
  }
  .deglutizione .bolo__riflesso {
    fill: none;
    stroke: #ffffff;
    stroke-width: 2.5;
    stroke-linecap: round;
    opacity: 0.7;
  }
  .deglutizione .pezzetto path {
    fill: url(#an-cibo);
    stroke: var(--cibo-bordo);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  /* Posizione del bolo: due gruppi separati, così orizzontale e verticale
     possono avere tempi diversi e il bolo segue una curva. */
  .deglutizione .bolo-x {
    transform: translateX(522px);
    transition: transform 1.2s ease-in-out;
  }
  .deglutizione .bolo-y {
    transform: translateY(282px);
    transition: transform 1.2s ease-in-out;
  }
  :is([data-passaggio='spinta-lingua'], [data-passaggio='chiusura-vie-aeree']) .deglutizione .bolo-x {
    transform: translateX(398px);
    transition: transform 1.1s ease-out 0.2s;
  }
  :is([data-passaggio='spinta-lingua'], [data-passaggio='chiusura-vie-aeree']) .deglutizione .bolo-y {
    transform: translateY(338px);
    transition: transform 1.1s ease-in 0.2s;
  }
  :is([data-passaggio='ingresso-esofago'], [data-passaggio='peristalsi']) .deglutizione .bolo-x {
    transform: translateX(391px);
    transition-duration: 1s;
  }
  [data-passaggio='ingresso-esofago'] .deglutizione .bolo-y {
    transform: translateY(470px);
    transition-duration: 1s;
  }
  [data-passaggio='peristalsi'] .deglutizione .bolo-y {
    transform: translateY(880px);
    transition: transform 1.6s ease-in-out 0.6s;
  }
  [data-passaggio='stomaco'] .deglutizione .bolo-x {
    transform: translateX(470px);
    transition: transform 1s ease-in 0.7s;
  }
  [data-passaggio='stomaco'] .deglutizione .bolo-y {
    transform: translateY(1010px);
    transition: transform 1.2s ease-out 0.3s;
  }

  /* Masticazione: prima del passaggio 1 (solo con "Ripeti") ci sono pezzetti sparsi,
     poi si uniscono nel bolo. */
  .deglutizione .pezzetto {
    transform: translate(var(--px), var(--py));
    opacity: 1;
    transition:
      transform 0.8s ease-in-out,
      opacity 0.4s ease-in-out 0.5s;
  }
  .deglutizione .bolo {
    transform: scale(0.3);
    opacity: 0;
    transition:
      transform 0.6s ease-in-out 0.5s,
      opacity 0.3s ease-in-out 0.5s;
  }
  [data-indice]:not([data-indice='-1']) .deglutizione .pezzetto {
    transform: translate(0, 0);
    opacity: 0;
  }
  [data-indice]:not([data-indice='-1']) .deglutizione .bolo {
    transform: scale(1);
    opacity: 1;
  }

  .deglutizione .saliva path {
    fill: url(#an-saliva);
    stroke: var(--saliva-bordo);
    stroke-width: 1.5;
  }
  .deglutizione .saliva {
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }
  [data-passaggio='masticazione'] .deglutizione .saliva {
    opacity: 1;
    transition: opacity 0.4s ease-in-out 0.2s;
  }

  /* --- Lingua --- */

  .deglutizione .lingua {
    transition: transform 0.8s ease-in-out;
  }
  :is([data-passaggio='spinta-lingua'], [data-passaggio='chiusura-vie-aeree']) .deglutizione .lingua {
    transform: translate(-6px, -28px);
  }

  /* --- Chiusura delle vie dell'aria --- */

  .deglutizione :is(.palato-molle, .laringe, .epiglottide) {
    transition: transform 0.8s ease-in-out;
  }
  [data-passaggio='chiusura-vie-aeree'] .deglutizione .palato-molle {
    transform: rotate(58deg);
  }
  [data-passaggio='chiusura-vie-aeree'] .deglutizione .laringe {
    transform: translateY(-16px);
  }
  [data-passaggio='chiusura-vie-aeree'] .deglutizione .epiglottide {
    transform: rotate(-68deg);
    transition-delay: 0.3s;
  }
  /* Le vie dell'aria si riaprono solo dopo che il bolo è entrato nell'esofago. */
  [data-passaggio='ingresso-esofago'] .deglutizione :is(.palato-molle, .laringe, .epiglottide) {
    transition-delay: 1s;
  }

  /* --- Esofago: rigonfiamento e peristalsi --- */

  .deglutizione .rigonfiamento {
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }
  .deglutizione .rigonfiamento__muscolo {
    fill: url(#an-muscolo);
    stroke: var(--muscolo-bordo);
    stroke-width: 2;
    transition:
      stroke 0.3s ease-in-out,
      stroke-width 0.3s ease-in-out;
  }
  .deglutizione .rigonfiamento__mucosa {
    fill: url(#an-mucosa);
    stroke: var(--mucosa-bordo);
    stroke-width: 1.2;
  }
  [data-passaggio='ingresso-esofago'] .deglutizione .rigonfiamento {
    opacity: 1;
    transition-delay: 0.6s;
  }
  [data-passaggio='peristalsi'] .deglutizione .rigonfiamento {
    opacity: 1;
  }

  .deglutizione .contrazione {
    opacity: 0;
    transition: opacity 0.2s ease-in-out;
  }
  [data-passaggio='peristalsi'] .deglutizione .contrazione {
    opacity: 1;
    transition: opacity 0.3s ease-in-out 0.5s;
  }
  .deglutizione .contrazione__muscolo {
    fill: url(#an-muscolo);
    stroke: var(--muscolo-bordo);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .deglutizione .contrazione__freccia {
    fill: none;
    stroke: var(--testo);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* --- Cardias: si apre, lascia passare il bolo, si richiude --- */

  [data-passaggio='stomaco'] .deglutizione .cardias__sx {
    animation: deglutizione-cardias-sx 2.2s ease-in-out;
  }
  [data-passaggio='stomaco'] .deglutizione .cardias__dx {
    animation: deglutizione-cardias-dx 2.2s ease-in-out;
  }
  @keyframes deglutizione-cardias-sx {
    15%,
    80% {
      transform: translateX(-12px);
    }
  }
  @keyframes deglutizione-cardias-dx {
    15%,
    80% {
      transform: translateX(12px);
    }
  }

  /* --- Elemento evidenziato nel passaggio corrente (guida di stile, §3) --- */

  .deglutizione :is(.lingua__forma, .palato-molle__forma, .epiglottide__forma, .cardias rect) {
    transition:
      stroke 0.3s ease-in-out,
      stroke-width 0.3s ease-in-out;
  }
  [data-passaggio='masticazione'] .deglutizione .bolo circle,
  [data-passaggio='spinta-lingua'] .deglutizione .lingua__forma,
  [data-passaggio='chiusura-vie-aeree'] .deglutizione :is(.palato-molle__forma, .epiglottide__forma),
  [data-passaggio='ingresso-esofago'] .deglutizione .rigonfiamento__muscolo,
  [data-passaggio='peristalsi'] .deglutizione .contrazione__muscolo,
  [data-passaggio='stomaco'] .deglutizione .cardias rect {
    stroke: var(--accento);
    stroke-width: 4;
  }

  /* --- Etichette: compaiono quando l'inquadratura si è fermata --- */

  .deglutizione .etichetta {
    opacity: 0;
    transition: opacity 0.2s ease-in-out;
  }
  .deglutizione .etichetta line {
    stroke: var(--testo-2);
    stroke-width: 1.5;
  }
  .deglutizione .etichetta circle {
    fill: var(--testo-2);
  }
  .deglutizione .etichetta text {
    fill: var(--testo);
    font-weight: 700;
    /* alone chiaro: il testo resta leggibile anche sopra una linea */
    stroke: var(--sfondo);
    stroke-width: 5px;
    stroke-linejoin: round;
    paint-order: stroke;
  }
  /* 21 e 29,5 unità diventano la stessa dimensione a schermo nelle due inquadrature. */
  .deglutizione .etichetta--vicina text {
    font-size: 21px;
  }
  .deglutizione .etichetta--lontana text {
    font-size: 29.5px;
  }
  [data-passaggio='masticazione'] .deglutizione .etichetta[data-per='masticazione'],
  [data-passaggio='spinta-lingua'] .deglutizione .etichetta[data-per='spinta-lingua'],
  [data-passaggio='chiusura-vie-aeree'] .deglutizione .etichetta[data-per='chiusura-vie-aeree'],
  [data-passaggio='ingresso-esofago'] .deglutizione .etichetta[data-per='ingresso-esofago'],
  [data-passaggio='peristalsi'] .deglutizione .etichetta[data-per='peristalsi'],
  [data-passaggio='stomaco'] .deglutizione .etichetta[data-per='stomaco'] {
    opacity: 1;
    transition: opacity 0.4s ease-in-out 1s;
  }
  /* Nella peristalsi l'etichetta del bolo aspetta che il bolo sia arrivato. */
  [data-passaggio='peristalsi'] .deglutizione .etichetta.etichetta--bolo[data-per='peristalsi'] {
    transition-delay: 2s;
  }

  /* --- Descrizione per gli screen reader: solo quella del passaggio corrente --- */

  .deglutizione .descrizione {
    display: none;
  }
  [data-passaggio='masticazione'] .deglutizione .descrizione[data-per='masticazione'],
  [data-passaggio='spinta-lingua'] .deglutizione .descrizione[data-per='spinta-lingua'],
  [data-passaggio='chiusura-vie-aeree'] .deglutizione .descrizione[data-per='chiusura-vie-aeree'],
  [data-passaggio='ingresso-esofago'] .deglutizione .descrizione[data-per='ingresso-esofago'],
  [data-passaggio='peristalsi'] .deglutizione .descrizione[data-per='peristalsi'],
  [data-passaggio='stomaco'] .deglutizione .descrizione[data-per='stomaco'] {
    display: block;
  }
</style>
