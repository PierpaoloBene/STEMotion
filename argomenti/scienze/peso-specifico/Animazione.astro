---
/**
 * Il peso specifico. Prima la formula, con cubi appesi a dinamometri (passaggi 0–5);
 * poi l'esperimento con un sasso, un dinamometro e un cilindro graduato (6–8);
 * infine "Prova tu" (9): lo studente sceglie un oggetto e ne scopre il materiale.
 *
 * Gli stati sono disegnati con CSS a partire da [data-indice] del palco
 * (docs/STRUTTURA-ARGOMENTO.md, §4). Ogni elemento che si sposta è un "posto" con le sue
 * coordinate per ogni passaggio (--x0…--x9, --y0…--y9) e, se serve, la forza sul
 * dinamometro (--f0…) e il livello dell'acqua (--l0…). Ciò che compare e scompare ha
 * l'attributo data-passi con l'elenco dei passaggi in cui si vede.
 *
 * Solo "Prova tu" usa JavaScript: la scelta dell'oggetto mette data-oggetto e data-fase
 * sulla radice. Cambiando passaggio (o con Ripeti) la scelta si azzera: nessuno stato nascosto.
 *
 * Due disposizioni dello stesso disegno, come negli altri argomenti: "larga" per la LIM,
 * "stretta" per il telefono. Sceglie il CSS con una container query.
 */
import Cubo from '../../../src/components/laboratorio/Cubo.astro';
import Dinamometro from '../../../src/components/laboratorio/Dinamometro.astro';
import CilindroGraduato from '../../../src/components/laboratorio/CilindroGraduato.astro';
import Pezzo from '../../../src/components/laboratorio/Pezzo.astro';

const N = 10; // passaggi
const AGGANCIO = 20; // y dell'anello dei dinamometri, appesi all'asta
const CARICO = 240; // il carico pende 240 sotto l'anello (Dinamometro.astro)
const CORSA = 130;
const L = 90; // spigolo del cubo da 1 dm³
const O = +(L * 0.354).toFixed(1);
const SOTTO_CUBO = 17 + L + O / 2; // dal gancio alla base del cubo, passando per l'occhiello
const CENTRO_CUBO = 17 + L / 2;
const PIEDE = 14; // spessore del piede del cilindro
const ALTO_CILINDRO = 344;

/** Valori per i 10 passaggi: si ripete l'ultimo dato, e prima del primo si usa il primo. */
function serie(dati: Record<number, number>): number[] {
  const chiavi = Object.keys(dati).map(Number).sort((a, b) => a - b);
  let v = dati[chiavi[0]];
  return Array.from({ length: N }, (_, i) => (v = dati[i] ?? v));
}
const tutti = (v: number) => serie({ 0: v });
interface Posto {
  x: number[];
  y: number[];
  f?: number[];
  l?: number[];
}
const variabili = (p: Posto) =>
  [
    ...p.x.map((v, i) => `--x${i}: ${v}px`),
    ...p.y.map((v, i) => `--y${i}: ${v}px`),
    ...(p.f ?? []).map((v, i) => `--f${i}: ${v}`),
    ...(p.l ?? []).map((v, i) => `--l${i}: ${v}`),
  ].join('; ');
const passi = (...p: number[]) => p.join(' ');

// --- Le due disposizioni ---

interface Disposizione {
  id: 'larga' | 'stretta';
  viewBox: string;
  w: number;
  h: number;
  tavolo: number;
  /** Le tre righe di testo sotto i dinamometri. */
  righe: [number, number, number];
  allu: Record<number, number>;
  legno: number;
  ferro: number;
  secondo: number; // blocco da 2 dm³ e cubo sulla Luna
  esp: Record<number, number>; // dinamometro dell'esperimento
  cil: Record<number, number>; // cilindro graduato
  /** Riquadro della formula: centro, righe di testo, rettangolo. */
  formula: { x: number; righe: number[]; r: [number, number, number, number] };
  /** Riquadro delle misure dell'esperimento. */
  misure: { x: number; titolo: number | null; righe: number[]; r: [number, number, number, number] };
  /** Tabella dei materiali in "Prova tu". */
  tabella: { titolo: [number, number] | null; caselle: [number, number][]; w: number; h: number; inline: boolean };
  /** Pulsanti di "Prova tu", in coordinate del disegno. */
  scelta: { x: number; y: number; w: number; h: number; colonna: boolean };
}

const disposizioni: Disposizione[] = [
  {
    id: 'larga',
    viewBox: '0 0 960 600',
    w: 960,
    h: 600,
    tavolo: 590,
    righe: [490, 528, 566],
    allu: { 0: 480, 2: 260 },
    legno: 200,
    ferro: 760,
    secondo: 660,
    esp: { 0: 120 },
    cil: { 0: 330 },
    formula: { x: 705, righe: [204, 266, 318], r: [470, 140, 470, 220] },
    misure: { x: 495, titolo: 195, righe: [245, 290, 345, 390], r: [470, 150, 475, 270] },
    tabella: { titolo: [470, 448], caselle: [[470, 462], [717, 462], [470, 532], [717, 532]], w: 228, h: 64, inline: false },
    scelta: { x: 470, y: 40, w: 475, h: 96, colonna: false },
  },
  {
    id: 'stretta',
    viewBox: '0 0 560 640',
    w: 560,
    h: 640,
    tavolo: 430,
    righe: [520, 560, 600],
    allu: { 0: 280, 2: 140 },
    legno: 95,
    ferro: 465,
    secondo: 400,
    esp: { 0: 70 },
    cil: { 0: 290, 9: 250 },
    formula: { x: 411, righe: [112, 160, 200, 240], r: [275, 60, 273, 210] },
    misure: { x: 60, titolo: null, righe: [486, 526, 568, 608], r: [40, 448, 508, 186] },
    tabella: { titolo: null, caselle: [[50, 545], [174, 545], [298, 545], [422, 545]], w: 116, h: 82, inline: false },
    scelta: { x: 330, y: 24, w: 218, h: 84, colonna: true },
  },
];

// --- Cosa c'è da scrivere ---

interface Riga {
  passi: string;
  riga: 0 | 1 | 2;
  testo: string;
  forte?: boolean;
}
const righeAllu: Riga[] = [
  { passi: passi(0, 1), riga: 1, testo: 'Alluminio', forte: true },
  { passi: passi(0, 1), riga: 2, testo: '26,5 N' },
  { passi: passi(2), riga: 1, testo: 'V = 1 dm³' },
  { passi: passi(2, 4), riga: 2, testo: 'P = 26,5 N' },
  { passi: passi(3), riga: 1, testo: '26,5 N : 1 dm³' },
  { passi: passi(3), riga: 2, testo: '= 26,5 N/dm³', forte: true },
  { passi: passi(4), riga: 1, testo: 'm = 2,7 kg' },
  { passi: passi(5), riga: 0, testo: 'Sulla Terra', forte: true },
  { passi: passi(5), riga: 1, testo: 'Ps = 26,5 N/dm³' },
  { passi: passi(5), riga: 2, testo: 'd = 2,7 kg/dm³' },
];

// Gli oggetti dell'esperimento. f: forza sul dinamometro da 10 N (1 = 10 N).
// alto: dal punto di aggancio al fondo dell'oggetto, per appoggiarlo nel cilindro.
interface Oggetto {
  id: string;
  materiale: 'alluminio' | 'ferro' | 'rame' | 'roccia';
  forma: 'sasso' | 'blocco' | 'lingotto';
  scala: number;
  alto: number;
  f: number;
  livello: number;
}
const sasso: Oggetto = { id: 'sasso', materiale: 'roccia', forma: 'sasso', scala: 1, alto: 65, f: 0.26, livello: 300 };
const oggetti = [
  {
    id: 'a', materiale: 'alluminio', forma: 'blocco', scala: 1.26, alto: 76.5, f: 0.53, livello: 400,
    materia: 'alluminio', p: '5,3 N', v: '200 cm³', vv: 'V = 400 mL − 200 mL = 200 cm³', conto: '5,3 N : 0,2 dm³ = 26,5 N/dm³',
  },
  {
    id: 'b', materiale: 'ferro', forma: 'lingotto', scala: 1, alto: 56, f: 0.77, livello: 300,
    materia: 'ferro', p: '7,7 N', v: '100 cm³', vv: 'V = 300 mL − 200 mL = 100 cm³', conto: '7,7 N : 0,1 dm³ = 77 N/dm³',
  },
  {
    id: 'c', materiale: 'rame', forma: 'sasso', scala: 0.8, alto: 55.2, f: 0.44, livello: 250,
    materia: 'rame', p: '4,4 N', v: '50 cm³', vv: 'V = 250 mL − 200 mL = 50 cm³', conto: '4,4 N : 0,05 dm³ = 88 N/dm³',
  },
] as const satisfies readonly (Oggetto & Record<string, unknown>)[];

const tabella = [
  { id: 'alluminio', nome: 'Alluminio', valore: '26,5' },
  { id: 'ferro', nome: 'Ferro', valore: '77' },
  { id: 'rame', nome: 'Rame', valore: '88' },
  { id: 'piombo', nome: 'Piombo', valore: '111' },
];

/** Dove sta un oggetto: appeso al gancio (a riposo e con la molla tesa), sopra il cilindro, dentro. */
function percorso(o: Oggetto, xEsp: number, xCil: number, tavolo: number) {
  const fondo = tavolo - PIEDE;
  const ganci = AGGANCIO + CARICO;
  return [
    `--hx: ${xEsp}px`,
    `--hy0: ${ganci}px`,
    `--hyf: ${+(ganci + CORSA * o.f).toFixed(1)}px`,
    `--cx: ${xCil}px`,
    `--sy: ${+(tavolo - ALTO_CILINDRO - 30 - o.alto).toFixed(1)}px`,
    `--cy: ${+(fondo - o.alto).toFixed(1)}px`,
  ].join('; ');
}

// Cosa mostra il disegno a ogni passaggio, per chi usa uno screen reader.
const descrizioni: Record<string, string> = {
  peso: 'Un cubo di alluminio da 1 dm³ è appeso a un dinamometro, una molla dentro un tubo. La molla si allunga e segna 26,5 N. Una freccia verso il basso indica il peso.',
  'stesso-volume': 'Tre cubi uguali da 1 dm³ appesi a tre dinamometri: legno 4,4 N, alluminio 26,5 N, ferro 77,1 N. La molla del ferro è la più allungata.',
  formula: 'Il cubo di alluminio: volume 1 dm³, peso 26,5 N. Accanto la formula: peso specifico uguale peso diviso volume, 26,5 N diviso 1 dm³ uguale 26,5 N/dm³.',
  grandezza: 'Il cubo di alluminio e un blocco di alluminio lungo il doppio, da 2 dm³. Il blocco pesa 53 N. Per tutti e due il peso specifico è 26,5 N/dm³.',
  densita: 'Il cubo di alluminio: massa 2,7 kg, peso 26,5 N. Accanto la formula: peso specifico uguale densità per g, 2,7 kg/dm³ per 9,8 N/kg uguale 26,5 N/dm³.',
  luna: 'Lo stesso cubo sulla Terra e sulla Luna. Sulla Luna la molla si allunga poco: peso specifico 4,4 N/dm³ invece di 26,5. La densità è 2,7 kg/dm³ in tutti e due i casi.',
  'esp-peso': 'Un sasso appeso con un filo a un dinamometro più piccolo, fino a 10 N. Segna 2,6 N. Accanto, un cilindro graduato con 200 mL di acqua.',
  'esp-volume': 'Il sasso viene staccato dal dinamometro e immerso nel cilindro graduato. Il livello dell’acqua sale da 200 a 300 mL: il volume del sasso è 100 cm³.',
  'esp-calcolo': 'Nel riquadro delle misure il calcolo: peso specifico uguale 2,6 N diviso 0,1 dm³, uguale 26 N/dm³.',
  'prova-tu': 'Tre pulsanti per scegliere l’oggetto A, B o C. L’oggetto scelto viene pesato e immerso nel cilindro. Sotto, il calcolo del peso specifico e una tabella con alluminio 26,5, ferro 77, rame 88 e piombo 111 N/dm³.',
};
---

<div class="peso">
  {
    disposizioni.map((d) => {
      const [t0, t1, t2] = d.righe.map((y) => y - AGGANCIO);
      const riga = (r: 0 | 1 | 2) => [t0, t1, t2][r];
      const xEsp = serie(d.esp);
      const xCil = serie(d.cil);
      const dinamometro = (x: number[], f: number[]): Posto => ({ x, y: tutti(AGGANCIO), f });
      const mf = d.formula;
      const mm = d.misure;
      const punta = `peso-punta-${d.id}`;
      return (
        <svg class={`peso__disegno peso__disegno--${d.id}`} viewBox={d.viewBox} aria-hidden="true" focusable="false">
          <defs>
            <marker id={punta} viewBox="0 0 10 10" refX="5" refY="5" markerWidth="4" markerHeight="4" orient="auto-start-reverse">
              <path class="punta" d="M0 0L10 5L0 10Z" />
            </marker>
          </defs>

          {/* Sostegno: asta in alto e palo a sinistra; il tavolo serve solo all'esperimento. */}
          <line class="tavolo" data-passi={passi(6, 7, 8, 9)} x1="0" x2={d.w} y1={d.tavolo} y2={d.tavolo} />
          <rect class="sostegno" x="12" y="8" width="12" height={d.h} />
          <rect class="sostegno" x="12" y="8" width={d.w - 24} height="12" rx="3" />

          {/* --- Il cubo di alluminio da 1 dm³ --- */}
          <g class="posto d-allu" data-passi={passi(0, 1, 2, 3, 4, 5)} style={variabili(dinamometro(serie(d.allu), serie({ 0: 0.265, 6: 0 })))}>
            <Dinamometro tacche={10}>
              <g transform={`translate(0 ${SOTTO_CUBO})`}>
                <Cubo lato={L} materiale="alluminio" occhiello />
              </g>
              <g class="forza-peso" data-passi={passi(0)}>
                <line x1="0" x2="0" y1={CENTRO_CUBO} y2={CENTRO_CUBO + 110} marker-end={`url(#${punta})`} />
                <text x="16" y={CENTRO_CUBO + 106}>
                  P
                </text>
              </g>
            </Dinamometro>
            {righeAllu.map((r) => (
              <text class:list={['riga', r.forte && 'riga--forte']} data-passi={r.passi} y={riga(r.riga)}>
                {r.testo}
              </text>
            ))}
          </g>

          {/* --- Legno e ferro, per il confronto --- */}
          {[
            { cls: 'd-legno', x: d.legno, f: 0.044, materiale: 'legno' as const, nome: 'Legno', lettura: '4,4 N' },
            { cls: 'd-ferro', x: d.ferro, f: 0.771, materiale: 'ferro' as const, nome: 'Ferro', lettura: '77,1 N' },
          ].map((c) => (
            <g class={`posto ${c.cls}`} data-passi={passi(1)} style={variabili(dinamometro(tutti(c.x), serie({ 0: 0, 1: c.f, 2: 0 })))}>
              <Dinamometro tacche={10}>
                <g transform={`translate(0 ${SOTTO_CUBO})`}>
                  <Cubo lato={L} materiale={c.materiale} occhiello />
                </g>
              </Dinamometro>
              <text class="riga riga--forte" y={t1}>
                {c.nome}
              </text>
              <text class="riga" y={t2}>
                {c.lettura}
              </text>
            </g>
          ))}

          {/* --- Il blocco da 2 dm³ --- */}
          <g class="posto d-blocco" data-passi={passi(3)} style={variabili(dinamometro(tutti(d.secondo), serie({ 0: 0, 3: 0.53, 4: 0 })))}>
            <Dinamometro tacche={10}>
              <g transform={`translate(0 ${SOTTO_CUBO})`}>
                <Cubo lato={L} largo={2} griglia={1} materiale="alluminio" occhiello />
              </g>
            </Dinamometro>
            <text class="riga" y={t1}>
              53 N : 2 dm³
            </text>
            <text class="riga riga--forte" y={t2}>
              = 26,5 N/dm³
            </text>
          </g>

          {/* --- Lo stesso cubo sulla Luna --- */}
          <g class="posto d-luna" data-passi={passi(5)} style={variabili(dinamometro(tutti(d.secondo), serie({ 0: 0, 5: 0.044, 6: 0 })))}>
            <Dinamometro tacche={10}>
              <g transform={`translate(0 ${SOTTO_CUBO})`}>
                <Cubo lato={L} materiale="alluminio" occhiello />
              </g>
            </Dinamometro>
            <text class="riga riga--forte" y={t0}>
              Sulla Luna
            </text>
            <text class="riga" y={t1}>
              Ps = 4,4 N/dm³
            </text>
            <text class="riga" y={t2}>
              d = 2,7 kg/dm³
            </text>
          </g>

          {/* --- Formula --- */}
          <g class="riquadro riquadro--formula" data-passi={passi(2, 4)}>
            <rect x={mf.r[0]} y={mf.r[1]} width={mf.r[2]} height={mf.r[3]} rx="18" />
            <g data-passi={passi(2)}>
              <text class="formula__titolo" x={mf.x} y={mf.righe[0]}>
                Ps = P : V
              </text>
              <text x={mf.x} y={mf.righe[1]}>
                26,5 N : 1 dm³
              </text>
              <text class="riga--forte" x={mf.x} y={mf.righe[2]}>
                = 26,5 N/dm³
              </text>
            </g>
            <g data-passi={passi(4)}>
              <text class="formula__titolo" x={mf.x} y={mf.righe[0]}>
                Ps = d × g
              </text>
              {mf.righe.length === 4 ? (
                <>
                  <text x={mf.x} y={mf.righe[1]}>
                    2,7 kg/dm³
                  </text>
                  <text x={mf.x} y={mf.righe[2]}>
                    × 9,8 N/kg
                  </text>
                  <text class="riga--forte" x={mf.x} y={mf.righe[3]}>
                    = 26,5 N/dm³
                  </text>
                </>
              ) : (
                <>
                  <text x={mf.x} y={mf.righe[1]}>
                    2,7 kg/dm³ × 9,8 N/kg
                  </text>
                  <text class="riga--forte" x={mf.x} y={mf.righe[2]}>
                    = 26,5 N/dm³
                  </text>
                </>
              )}
            </g>
          </g>

          {/* --- Esperimento: oggetti (prima del cilindro, così si vedono dentro l'acqua) --- */}
          <g class="oggetto oggetto--sasso" data-passi={passi(6, 7, 8)} style={percorso(sasso, xEsp[6], xCil[6], d.tavolo)}>
            <Pezzo materiale="roccia" forma="sasso" />
          </g>
          {oggetti.map((o) => (
            <g class={`oggetto oggetto--scelta oggetto--${o.id}`} style={percorso(o, xEsp[9], xCil[9], d.tavolo)}>
              <Pezzo materiale={o.materiale} forma={o.forma} scala={o.scala} />
            </g>
          ))}

          <g class="posto d-esp" data-passi={passi(6, 7, 8, 9)} style={variabili(dinamometro(xEsp, serie({ 0: 0, 6: sasso.f, 7: 0 })))}>
            <Dinamometro tacche={10} />
          </g>

          <g class="posto cil" data-passi={passi(6, 7, 8, 9)} style={variabili({ x: xCil, y: tutti(d.tavolo), l: serie({ 0: 200, 7: 300, 9: 200 }) })}>
            <CilindroGraduato portata={500} tacca={50} />
            <g class="livello">
              <g transform={`translate(-56 ${-PIEDE})`}>
                <rect class="cartellino" x="-100" y="-20" width="100" height="40" rx="20" />
                <text class="lv lv-200" x="-50" y="9">
                  200 mL
                </text>
                <text class="lv lv-300" x="-50" y="9">
                  300 mL
                </text>
                {oggetti.map((o) => (
                  <text class={`lv lv-${o.id}`} x="-50" y="9">
                    {o.livello} mL
                  </text>
                ))}
              </g>
            </g>
          </g>

          {/* --- Riquadro delle misure --- */}
          <g class="riquadro riquadro--misure" data-passi={passi(6, 7, 8, 9)}>
            <rect x={mm.r[0]} y={mm.r[1]} width={mm.r[2]} height={mm.r[3]} rx="18" />
            {mm.titolo !== null && (
              <text class="misure__titolo" x={mm.x} y={mm.titolo}>
                Misure
              </text>
            )}
            <text class="misura" data-passi={passi(6, 7, 8)} x={mm.x} y={mm.righe[0]}>
              P = 2,6 N
            </text>
            <text class="misura" data-passi={passi(7, 8)} x={mm.x} y={mm.righe[1]}>
              V = 300 mL − 200 mL = 100 cm³
            </text>
            <text class="misura riga--forte" data-passi={passi(8)} x={mm.x} y={mm.righe[2]}>
              Ps = P : V
            </text>
            <text class="misura riga--forte" data-passi={passi(8)} x={mm.x} y={mm.righe[3]}>
              = 2,6 N : 0,1 dm³ = 26 N/dm³
            </text>
            <text class="misura invito" x={mm.x} y={mm.righe[0]}>
              Scegli un oggetto: A, B o C.
            </text>
            {oggetti.map((o) =>
              d.id === 'larga' ? (
                <g>
                  <text class={`misura ris-p ris-${o.id}`} x={mm.x} y={mm.righe[0]}>
                    P = {o.p}
                  </text>
                  <text class={`misura ris ris-${o.id}`} x={mm.x} y={mm.righe[1]}>
                    {o.vv}
                  </text>
                  <text class={`misura riga--forte ris ris-${o.id}`} x={mm.x} y={mm.righe[2]}>
                    Ps = P : V
                  </text>
                  <text class={`misura riga--forte ris ris-${o.id}`} x={mm.x} y={mm.righe[3]}>
                    = {o.conto}
                  </text>
                </g>
              ) : (
                <g>
                  <text class={`misura ris-p ris-${o.id}`} x={mm.x} y={mm.righe[0]}>
                    P = {o.p}
                  </text>
                  <text class={`misura ris ris-${o.id}`} x={mm.x + 138} y={mm.righe[0]}>
                    · V = {o.v}
                  </text>
                  <text class={`misura misura--piccola riga--forte ris ris-${o.id}`} x={mm.x} y={mm.righe[1]}>
                    Ps = {o.conto}
                  </text>
                </g>
              ),
            )}
          </g>

          {/* --- Tabella dei materiali, per "Prova tu" --- */}
          <g class="tabella" data-passi={passi(9)}>
            {d.tabella.titolo && (
              <text class="tabella__titolo" x={d.tabella.titolo[0]} y={d.tabella.titolo[1]}>
                Peso specifico (N/dm³)
              </text>
            )}
            {tabella.map((m, i) => {
              const [x, y] = d.tabella.caselle[i];
              const { w, h } = d.tabella;
              return (
                <g class={`voce voce--${m.id}`}>
                  <rect x={x} y={y} width={w} height={h} rx="14" />
                  {d.tabella.inline ? (
                    <>
                      <text class="voce__nome" x={x + 16} y={y + h / 2 + 9}>
                        {m.nome}
                      </text>
                      <text class="voce__valore" x={x + w - 52} y={y + h / 2 + 9}>
                        {m.valore}
                      </text>
                    </>
                  ) : (
                    <>
                      <text class="voce__nome voce__nome--centro" x={x + w / 2} y={y + h * 0.4}>
                        {m.nome}
                      </text>
                      <text class="voce__valore voce__valore--centro" x={x + w / 2} y={y + h * 0.84}>
                        {m.valore}
                      </text>
                    </>
                  )}
                  <path class="voce__segno" d={d.tabella.inline ? `M${x + w - 38} ${y + h / 2}l7 7l13 -14` : `M${x + w - 28} ${y + h - 18}l6 6l12 -12`} />
                </g>
              );
            })}
          </g>
        </svg>
      );
    })
  }

  {/* Pulsanti di "Prova tu": HTML sopra il disegno, nella posizione dei pulsanti disegnati. */}
  <div class="peso__scelta" role="group" aria-label="Scegli un oggetto">
    {
      oggetti.map((o) => (
        <button type="button" class="peso__oggetto" data-scegli={o.id} aria-pressed="false" aria-label={`Oggetto ${o.id.toUpperCase()}`}>
          <svg viewBox="-36 -4 72 76" aria-hidden="true">
            <Pezzo materiale={o.materiale} forma={o.forma} scala={Math.min(o.scala, 1)} />
          </svg>
          <span>{o.id.toUpperCase()}</span>
        </button>
      ))
    }
  </div>

  <div class="solo-lettori">
    {
      Object.entries(descrizioni).map(([id, testo]) => (
        <p class="descrizione" data-per={id}>
          Disegno: {testo}
        </p>
      ))
    }
    <p data-annuncio aria-live="polite"></p>
  </div>
</div>

<script>
  // "Prova tu": l'oggetto scelto si aggancia, la molla si allunga (pesa), poi l'oggetto
  // si stacca e scende nel cilindro (immergi); alla fine compaiono i risultati (fatto).
  const risultati: Record<string, string> = {
    a: 'Oggetto A: pesa 5,3 N e ha un volume di 200 cm³. Peso specifico 26,5 N/dm³: è di alluminio.',
    b: 'Oggetto B: pesa 7,7 N e ha un volume di 100 cm³. Peso specifico 77 N/dm³: è di ferro.',
    c: 'Oggetto C: pesa 4,4 N e ha un volume di 50 cm³. Peso specifico 88 N/dm³: è di rame.',
  };

  document.querySelectorAll<HTMLElement>('.peso').forEach((radice) => {
    const palco = radice.closest<HTMLElement>('[data-palco]');
    const pulsanti = [...radice.querySelectorAll<HTMLButtonElement>('[data-scegli]')];
    const annuncio = radice.querySelector<HTMLElement>('[data-annuncio]')!;
    const ridotto = matchMedia('(prefers-reduced-motion: reduce)');
    let timer: number[] = [];

    function azzera() {
      timer.forEach(clearTimeout);
      timer = [];
      delete radice.dataset.oggetto;
      delete radice.dataset.fase;
      pulsanti.forEach((p) => p.setAttribute('aria-pressed', 'false'));
      annuncio.textContent = '';
    }

    function scegli(id: string) {
      azzera();
      pulsanti.forEach((p) => p.setAttribute('aria-pressed', String(p.dataset.scegli === id)));
      radice.dataset.oggetto = id;
      radice.dataset.fase = 'aggancia';
      void radice.getBoundingClientRect(); // applica subito lo stato di partenza
      radice.dataset.fase = 'pesa';
      const pausa = ridotto.matches ? 0 : 1300;
      timer.push(
        window.setTimeout(() => {
          radice.dataset.fase = 'immergi';
          timer.push(
            window.setTimeout(() => {
              radice.dataset.fase = 'fatto';
              annuncio.textContent = risultati[id];
            }, ridotto.matches ? 0 : 1500),
          );
        }, pausa),
      );
    }

    pulsanti.forEach((p) => p.addEventListener('click', () => scegli(p.dataset.scegli!)));
    palco?.addEventListener('cambiapassaggio', azzera);
  });
</script>

