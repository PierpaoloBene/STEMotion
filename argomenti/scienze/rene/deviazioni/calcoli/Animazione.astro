---
/**
 * Deviazione del rene: come si forma un calcolo, la colica e l'uscita del calcolo.
 *
 * Stesso rene in sezione dell'argomento (ReneSezione, src/components/anatomia), già pieno di urina
 * come nel passaggio "bacinetto" che apre il box. Ogni stato è disegnato solo con CSS
 * a partire da [data-passaggio] del palco (solo gli id: il box sta nella stessa pagina dell'argomento).
 *
 * Inquadrature: nei passaggi 1–3 il rene è a sinistra e a destra c'è la lente sull'urina
 * di un calice; nei passaggi 4–6 il rene torna al centro e si segue il calcolo.
 */
import ReneSezione from '../../../../../src/components/anatomia/ReneSezione.astro';
import { schermo } from '../../../../../src/components/anatomia/rene-sezione';

interface Etichetta {
  testo: string;
  x: number;
  y: number;
  verso: [number, number];
  passaggi: string[];
}
const larghezzaTesto = (t: string) => t.length * 24 * 0.56;
const linea = (e: Etichetta): [number, number, number, number] => {
  const destra = e.verso[0] > e.x;
  return [destra ? e.x + larghezzaTesto(e.testo) + 8 : e.x - 8, e.y - 8, e.verso[0], e.verso[1]];
};

// Il calcolo nasce nel calice minore in basso (unità del rene) e poi scende:
// nel bacinetto, all'inizio dell'uretere, dove si blocca (colica), poi giù fino a uscire dal disegno.
const PARTENZA: [number, number] = [2.4, 19.5];
const TAPPE: [number, number][] = [
  [-5, 7],
  [-22, 11],
  [-30.5, 27],
  [-35.3, 52],
  [-37.2, 84],
];
const spostamenti = TAPPE.map(([x, y], i) => {
  const [px, py] = i === 0 ? PARTENZA : TAPPE[i - 1];
  return [Math.round((x - px) * 10) / 10, Math.round((y - py) * 10) / 10];
});
const CALCOLO = 'M-2.6 -1.2L-1.2 -2.7L1.4 -2.4L2.8 -0.6L2.2 1.9L0 2.8L-2.2 2.1Z';

// La lente sull'urina del calice: riquadro da (440, 40) a (780, 600).
const L = { x: 440, y: 40, w: 340, h: 560 };
const SPOSTA = -150;
const [mx1, my1] = schermo([-4, 13]);
const [mx2, my2] = schermo([10, 27]);
const origineLente: [number, number] = [(mx1 + mx2) / 2 + SPOSTA, (my1 + my2) / 2];

const GOCCIA = 'M0 -7C3 -3 5 0 5 3A5 5 0 0 1 -5 3C-5 0 -3 -3 0 -7Z';
// Gocce d'acqua: con poca acqua ("cause") ne restano solo quelle con resta = true.
const gocce: { x: number; y: number; resta?: boolean }[] = [
  { x: 490, y: 100, resta: true },
  { x: 600, y: 90 },
  { x: 720, y: 120 },
  { x: 520, y: 210 },
  { x: 650, y: 180, resta: true },
  { x: 740, y: 260 },
  { x: 480, y: 330 },
  { x: 610, y: 300 },
  { x: 700, y: 380, resta: true },
  { x: 520, y: 450 },
  { x: 640, y: 480 },
  { x: 740, y: 540 },
  { x: 510, y: 520, resta: true },
];
// Sali sciolti: i primi ci sono sempre, gli altri compaiono con "cause".
// Nel passaggio "cristalli" ognuno va verso il cristallo `a` (in basso a sinistra) o `b` (in alto a destra).
const CRISTALLI = { a: [560, 420] as [number, number], b: [670, 220] as [number, number] };
const sali: { x: number; y: number; nuovo?: boolean; va: 'a' | 'b' }[] = [
  { x: 560, y: 140, va: 'b' },
  { x: 700, y: 210, va: 'b' },
  { x: 560, y: 280, va: 'a' },
  { x: 690, y: 320, va: 'b' },
  { x: 590, y: 400, va: 'a' },
  { x: 700, y: 480, va: 'a' },
  { x: 480, y: 160, nuovo: true, va: 'b' },
  { x: 640, y: 120, nuovo: true, va: 'b' },
  { x: 750, y: 170, nuovo: true, va: 'b' },
  { x: 470, y: 260, nuovo: true, va: 'a' },
  { x: 620, y: 240, nuovo: true, va: 'b' },
  { x: 740, y: 400, nuovo: true, va: 'b' },
  { x: 500, y: 390, nuovo: true, va: 'a' },
  { x: 620, y: 420, nuovo: true, va: 'a' },
  { x: 560, y: 510, nuovo: true, va: 'a' },
  { x: 660, y: 560, nuovo: true, va: 'a' },
  { x: 750, y: 470, nuovo: true, va: 'a' },
  { x: 470, y: 480, nuovo: true, va: 'a' },
];
const CRISTALLO = 'M0 -30L22 -10L16 22L-8 30L-26 8L-18 -20Z';

const [cx, cy] = schermo(PARTENZA);
const posColica = schermo(TAPPE[2]);
const etichette: Etichetta[] = [
  { testo: 'Acqua', x: 470, y: 72, verso: [600, 86], passaggi: ['calcoli-sali'] },
  { testo: 'Sale sciolto', x: 454, y: 600 - 22, verso: [700, 480], passaggi: ['calcoli-sali'] },
  { testo: 'Poca acqua', x: 470, y: 72, verso: [650, 176], passaggi: ['calcoli-cause'] },
  { testo: 'Troppi sali', x: 454, y: 600 - 22, verso: [560, 510], passaggi: ['calcoli-cause'] },
  { testo: 'Cristalli', x: 454, y: 600 - 22, verso: [CRISTALLI.a[0], CRISTALLI.a[1] + 30], passaggi: ['calcoli-cristalli'] },
  { testo: 'Calcolo', x: 600, y: 560, verso: [cx + 8, cy + 8], passaggi: ['calcoli-calcolo'] },
  { testo: 'Calcolo', x: 60, y: 420, verso: [posColica[0] - 10, posColica[1]], passaggi: ['calcoli-colica'] },
  { testo: 'Uretere', x: 60, y: 560, verso: schermo([-35.6, 56]), passaggi: ['calcoli-colica', 'calcoli-uscita'] },
];

const descrizioni: Record<string, string> = {
  'calcoli-sali': 'Il rene tagliato a metà è a sinistra, pieno di urina gialla. Una lente ingrandisce l’urina di un calice: ci sono tante gocce d’acqua blu e qualche pallino viola, i sali sciolti.',
  'calcoli-cause': 'Nella lente molte gocce d’acqua spariscono e compaiono tanti altri pallini viola: i sali sono troppi per l’acqua che resta.',
  'calcoli-cristalli': 'I pallini viola si avvicinano tra loro e si uniscono in due forme spigolose grigio bruno: i cristalli.',
  'calcoli-calcolo': 'La lente si chiude e il rene torna al centro. In un calice in basso compare un sassolino grigio bruno che cresce: il calcolo.',
  'calcoli-colica': 'Il calcolo scivola nel bacinetto e poi nell’uretere, dove si blocca. L’uretere è evidenziato.',
  'calcoli-uscita': 'Il calcolo scende lungo l’uretere insieme all’urina ed esce dal disegno, verso la vescica.',
};
const ids = Object.keys(descrizioni);
---

<div class="calcoli">
  <svg viewBox="0 0 800 640" aria-hidden="true" focusable="false">
    <g class="camera">
      <ReneSezione>
        <g slot="interno">
          <rect class="riquadro-lente" x="-4" y="13" width="14" height="14" rx="2"></rect>
          <g transform={`translate(${PARTENZA[0]} ${PARTENZA[1]})`}>
            <g class="calcolo__tappa calcolo__tappa--1" style={`--dx: ${spostamenti[0][0]}px; --dy: ${spostamenti[0][1]}px`}>
              <g class="calcolo__tappa calcolo__tappa--2" style={`--dx: ${spostamenti[1][0]}px; --dy: ${spostamenti[1][1]}px`}>
                <g class="calcolo__tappa calcolo__tappa--3" style={`--dx: ${spostamenti[2][0]}px; --dy: ${spostamenti[2][1]}px`}>
                  <g class="calcolo__tappa calcolo__tappa--4" style={`--dx: ${spostamenti[3][0]}px; --dy: ${spostamenti[3][1]}px`}>
                    <g class="calcolo__tappa calcolo__tappa--5" style={`--dx: ${spostamenti[4][0]}px; --dy: ${spostamenti[4][1]}px`}>
                      <g class="calcolo">
                        <path class="calcolo__forma" d={CALCOLO}></path>
                        <path class="calcolo__strato" d={CALCOLO} transform="scale(0.62)"></path>
                        <path class="calcolo__strato" d={CALCOLO} transform="scale(0.3)"></path>
                      </g>
                    </g>
                  </g>
                </g>
              </g>
            </g>
          </g>
        </g>
      </ReneSezione>

      {
        etichette
          .filter((e) => !e.passaggi[0].match(/sali|cause|cristalli/))
          .map((e) => {
            const [x1, y1, x2, y2] = linea(e);
            return (
              <g class="etichetta" data-per={e.passaggi.join(' ')}>
                <line x1={x1} y1={y1} x2={x2} y2={y2} />
                <circle cx={x2} cy={y2} r="3.5" />
                <rect x={e.x - 7} y={e.y - 23} width={larghezzaTesto(e.testo) + 14} height="31" rx="15.5" />
                <text x={e.x} y={e.y}>
                  {e.testo}
                </text>
              </g>
            );
          })
      }
    </g>

    <!-- la lente sull'urina del calice -->
    <g transform={`translate(${origineLente[0]} ${origineLente[1]})`}>
      <g class="lente">
        <g transform={`translate(${-origineLente[0]} ${-origineLente[1]})`}>
          <rect class="lente__urina" x={L.x} y={L.y} width={L.w} height={L.h} rx="24"></rect>
          {
            gocce.map((g) => (
              <path class:list={['goccia', { 'goccia--resta': g.resta }]} d={GOCCIA} transform={`translate(${g.x} ${g.y}) scale(2.2)`} />
            ))
          }
          {
            sali.map((s, i) => {
              const [ax, ay] = CRISTALLI[s.va];
              return (
                <g
                  class:list={['sale', { 'sale--nuovo': s.nuovo }]}
                  style={`--x: ${s.x}px; --y: ${s.y}px; --x2: ${ax + ((i * 7) % 15) - 7}px; --y2: ${ay + ((i * 11) % 15) - 7}px; --ritardo: ${(i % 6) * 0.08}s`}
                >
                  <circle r="11" />
                </g>
              );
            })
          }
          {Object.values(CRISTALLI).map(([x, y]) => <path class="cristallo" d={CRISTALLO} transform={`translate(${x} ${y})`} />)}
          <rect class="lente__cornice" x={L.x} y={L.y} width={L.w} height={L.h} rx="24"></rect>
          {
            etichette
              .filter((e) => e.passaggi[0].match(/sali|cause|cristalli/))
              .map((e) => {
                const [x1, y1, x2, y2] = linea(e);
                return (
                  <g class="etichetta" data-per={e.passaggi.join(' ')}>
                    <line x1={x1} y1={y1} x2={x2} y2={y2} />
                    <circle cx={x2} cy={y2} r="3.5" />
                    <rect x={e.x - 7} y={e.y - 23} width={larghezzaTesto(e.testo) + 14} height="31" rx="15.5" />
                    <text x={e.x} y={e.y}>
                      {e.testo}
                    </text>
                  </g>
                );
              })
          }
        </g>
      </g>
    </g>
  </svg>

  <div class="solo-lettori">
    {
      ids.map((id) => (
        <p class="descrizione" data-per={id}>
          Disegno: {descrizioni[id]}
        </p>
      ))
    }
  </div>
</div>

<style is:global>
  .calcoli {
    position: absolute;
    inset: 0;
  }
  .calcoli svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Il rene è già pieno di urina, come nel passaggio "bacinetto" dell'argomento. */
  .calcoli .rene-sezione :is(.rene-sezione__glomeruli circle, .rene-sezione__calici-urina, .rene-sezione__bacinetto-urina, .rene-sezione__uretere-urina) {
    opacity: 1;
  }

  /* --- Inquadratura: rene a sinistra con la lente (1–3), poi al centro (4–6) --- */

  .calcoli .camera {
    transform: translate(0, 0);
    transition: transform 1.2s ease-in-out;
  }
  :is([data-passaggio='calcoli-sali'], [data-passaggio='calcoli-cause'], [data-passaggio='calcoli-cristalli']) .calcoli .camera {
    transform: translate(-150px, 0); /* SPOSTA */
  }
  .calcoli .riquadro-lente {
    fill: none;
    stroke: var(--accento);
    stroke-width: 4;
    vector-effect: non-scaling-stroke;
    opacity: 0;
    transition: opacity 0.4s ease-in-out;
  }
  :is([data-passaggio='calcoli-sali'], [data-passaggio='calcoli-cause'], [data-passaggio='calcoli-cristalli']) .calcoli .riquadro-lente {
    opacity: 1;
  }
  .calcoli .lente {
    transform: scale(0.1);
    opacity: 0;
    transition:
      transform 0.8s ease-in-out,
      opacity 0.5s ease-in-out;
  }
  :is([data-passaggio='calcoli-sali'], [data-passaggio='calcoli-cause'], [data-passaggio='calcoli-cristalli']) .calcoli .lente {
    transform: scale(1);
    opacity: 1;
  }
  [data-passaggio='calcoli-sali'] .calcoli .lente {
    transition-delay: 0.6s;
  }

  /* --- Nella lente: acqua, sali sciolti, cristalli --- */

  .calcoli .lente__urina {
    fill: var(--urina);
  }
  .calcoli .lente__cornice {
    fill: none;
    stroke: var(--accento);
    stroke-width: 4;
  }
  .calcoli .goccia {
    fill: var(--acqua);
    stroke: var(--contorno);
    stroke-width: 0.7;
    transition: opacity 0.8s ease-in-out;
  }
  :is([data-passaggio='calcoli-cause'], [data-passaggio='calcoli-cristalli']) .calcoli .goccia:not(.goccia--resta) {
    opacity: 0;
  }
  .calcoli .sale {
    transform: translate(var(--x), var(--y));
    transition:
      transform 1.4s ease-in-out,
      opacity 0.6s ease-in-out;
  }
  .calcoli .sale circle {
    fill: var(--nutrienti);
    stroke: var(--contorno);
    stroke-width: 1.5;
  }
  .calcoli .sale--nuovo {
    opacity: 0;
  }
  [data-passaggio='calcoli-cause'] .calcoli .sale--nuovo {
    opacity: 1;
    transition-delay: 0s, calc(0.6s + var(--ritardo));
  }
  /* I sali si avvicinano tra loro; dove si incontrano c'è il cristallo. */
  [data-passaggio='calcoli-cristalli'] .calcoli .sale {
    transform: translate(var(--x2), var(--y2));
    opacity: 0;
    transition-delay: var(--ritardo), calc(1.4s + var(--ritardo));
  }
  .calcoli .cristallo {
    fill: var(--calcolo);
    stroke: var(--contorno);
    stroke-width: 2.5;
    stroke-linejoin: round;
    opacity: 0;
    transition: opacity 0.6s ease-in-out;
  }
  [data-passaggio='calcoli-cristalli'] .calcoli .cristallo {
    opacity: 1;
    transition-delay: 1.3s;
  }

  /* --- Il calcolo: cresce nel calice, poi scende --- */

  .calcoli .calcolo {
    transform: scale(0.2);
    opacity: 0;
    transition:
      transform 1.8s ease-in-out,
      opacity 0.4s ease-in-out;
  }
  :is([data-passaggio='calcoli-calcolo'], [data-passaggio='calcoli-colica'], [data-passaggio='calcoli-uscita']) .calcoli .calcolo {
    transform: scale(1);
    opacity: 1;
  }
  [data-passaggio='calcoli-calcolo'] .calcoli .calcolo {
    transition-delay: 0.8s;
  }
  .calcoli .calcolo__forma {
    fill: var(--calcolo);
    stroke: var(--contorno);
    stroke-width: 2;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .calcoli .calcolo__strato {
    fill: none;
    stroke: var(--contorno);
    stroke-width: 1.2;
    stroke-linejoin: round;
    opacity: 0.45;
    vector-effect: non-scaling-stroke;
  }
  .calcoli .calcolo__tappa {
    transform: translate(0, 0);
    transition: transform 0.6s ease-in-out;
  }
  /* Colica: tre tappe una dopo l'altra, fino al punto in cui l'uretere si stringe. */
  :is([data-passaggio='calcoli-colica'], [data-passaggio='calcoli-uscita']) .calcoli :is(.calcolo__tappa--1, .calcolo__tappa--2, .calcolo__tappa--3) {
    transform: translate(var(--dx), var(--dy));
  }
  [data-passaggio='calcoli-colica'] .calcoli .calcolo__tappa--1 {
    transition-delay: 0.2s;
  }
  [data-passaggio='calcoli-colica'] .calcoli .calcolo__tappa--2 {
    transition-delay: 0.8s;
  }
  [data-passaggio='calcoli-colica'] .calcoli .calcolo__tappa--3 {
    transition-delay: 1.4s;
  }
  /* Uscita: scende lungo l'uretere ed esce dal disegno. */
  [data-passaggio='calcoli-uscita'] .calcoli :is(.calcolo__tappa--4, .calcolo__tappa--5) {
    transform: translate(var(--dx), var(--dy));
  }
  [data-passaggio='calcoli-uscita'] .calcoli .calcolo__tappa--4 {
    transition: transform 0.8s ease-in-out 0.2s;
  }
  [data-passaggio='calcoli-uscita'] .calcoli .calcolo__tappa--5 {
    transition: transform 0.9s ease-in-out 1s;
  }
  .calcoli .rene-sezione__uretere-urina {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 2.2s ease-in-out;
  }
  [data-passaggio='calcoli-uscita'] .calcoli .rene-sezione__uretere-urina {
    stroke-dashoffset: -30;
    transition-delay: 0.2s;
  }

  /* --- Elemento evidenziato: l'uretere durante la colica (guida di stile, §3) --- */

  .calcoli .rene-sezione__uretere-bordo {
    transition: stroke 0.4s ease-in-out;
  }
  [data-passaggio='calcoli-colica'] .calcoli .rene-sezione__uretere-bordo {
    stroke: var(--accento);
    transition-delay: 1.8s;
  }

  /* --- Etichette --- */

  .calcoli .etichetta {
    opacity: 0;
    transition: opacity 0.2s ease-in-out;
  }
  .calcoli .etichetta line {
    stroke: var(--testo-2);
    stroke-width: 1.5;
  }
  .calcoli .etichetta circle {
    fill: var(--testo-2);
  }
  .calcoli .etichetta rect {
    fill: var(--superficie);
    opacity: 0.92;
  }
  .calcoli .etichetta text {
    fill: var(--testo);
    font-size: 24px;
    font-weight: 700;
  }
  [data-passaggio='calcoli-sali'] .calcoli .etichetta[data-per~='calcoli-sali'],
  [data-passaggio='calcoli-cause'] .calcoli .etichetta[data-per~='calcoli-cause'],
  [data-passaggio='calcoli-cristalli'] .calcoli .etichetta[data-per~='calcoli-cristalli'],
  [data-passaggio='calcoli-calcolo'] .calcoli .etichetta[data-per~='calcoli-calcolo'],
  [data-passaggio='calcoli-colica'] .calcoli .etichetta[data-per~='calcoli-colica'],
  [data-passaggio='calcoli-uscita'] .calcoli .etichetta[data-per~='calcoli-uscita'] {
    opacity: 1;
    transition: opacity 0.4s ease-in-out 1.6s;
  }
  [data-passaggio='calcoli-colica'] .calcoli .etichetta[data-per~='calcoli-colica'] {
    transition-delay: 2s;
  }

  /* --- Descrizione per gli screen reader --- */

  .calcoli .descrizione {
    display: none;
  }
  [data-passaggio='calcoli-sali'] .calcoli .descrizione[data-per='calcoli-sali'],
  [data-passaggio='calcoli-cause'] .calcoli .descrizione[data-per='calcoli-cause'],
  [data-passaggio='calcoli-cristalli'] .calcoli .descrizione[data-per='calcoli-cristalli'],
  [data-passaggio='calcoli-calcolo'] .calcoli .descrizione[data-per='calcoli-calcolo'],
  [data-passaggio='calcoli-colica'] .calcoli .descrizione[data-per='calcoli-colica'],
  [data-passaggio='calcoli-uscita'] .calcoli .descrizione[data-per='calcoli-uscita'] {
    display: block;
  }
</style>
