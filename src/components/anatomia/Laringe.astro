---
// Laringe, trachea e bronchi come in una radiografia laterale: colonna d'aria scura,
// cartilagini appena visibili, osso ioide, epiglottide.
// Sistema di riferimento condiviso: vedi README.md in questa cartella.
// Richiede <Lastra /> nello stesso <svg>.
const anelli = Array.from({ length: 12 }, (_, i) => 490 + i * 22);
---

<g class="laringe">
  <path class="laringe__lume" d="M418 398V735L414 790H432L437 760L442 790H460L456 735V398Z"></path>
  <path class="laringe__anelli" d={anelli.map((y) => `M419 ${y}H455`).join('')}></path>
  <!-- cartilagine tiroide e cricoide, osso ioide -->
  <path class="cartilagine" d="M456 404C478 414 480 452 456 472Z"></path>
  <path class="cartilagine" d="M414 440H428V482C422 486 416 486 414 482Z"></path>
  <ellipse class="osso" cx="490" cy="404" rx="11" ry="5"></ellipse>
  <g transform="translate(452 398)">
    <g class="epiglottide">
      <path class="epiglottide__forma" d="M0 2C6 -18 -4 -40 -22 -54C-27 -48 -16 -28 -8 2Z"></path>
    </g>
  </g>
</g>

<style>
  .laringe__lume {
    fill: var(--rx-aria-fondo);
    fill-opacity: 0.8;
    stroke: var(--aria);
    stroke-opacity: 0.8;
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  .laringe__anelli {
    fill: none;
    stroke: var(--rx-cartilagine);
    stroke-opacity: 0.3;
    stroke-width: 4;
    mix-blend-mode: screen;
  }
  .cartilagine {
    fill: var(--rx-cartilagine);
    fill-opacity: 0.12;
    stroke: var(--rx-cartilagine);
    stroke-opacity: 0.6;
    stroke-width: 1.5;
    mix-blend-mode: screen;
  }
  .osso {
    fill: var(--rx-osso);
    fill-opacity: 0.3;
    stroke: var(--rx-osso);
    stroke-opacity: 0.9;
    stroke-width: 1.5;
    mix-blend-mode: screen;
  }
  .epiglottide__forma {
    fill: var(--rx-mucosa);
    fill-opacity: 0.5;
    stroke: var(--rx-mucosa);
    stroke-opacity: 0.95;
    stroke-width: 1.5;
    stroke-linejoin: round;
    mix-blend-mode: screen;
  }
</style>
