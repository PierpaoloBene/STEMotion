---
// Che cosa può succedere dentro l'appendice: tappo, batteri, vasi dilatati, pus, rottura della parete.
// Va messo nello slot "appendice" di IntestinoCrasso: asse dell'appendice lungo y, attacco in (0, 0),
// punta a y = 56. Tutto è nascosto: l'animazione mostra i pezzi che servono.
// Classi: .tappo (parte da y = -16, dentro il cieco), .batteri--1/2/3, .vasi, .pus, .crepa.
const batteri = [
  [
    [0, 14, 10],
    [-1, 26, -20],
    [1, 36, 30],
  ],
  [
    [1, 20, -15],
    [-1, 31, 25],
    [0, 42, 0],
    [1, 9, 40],
  ],
  [
    [-1, 18, 30],
    [1, 29, -30],
    [-1, 40, 15],
    [0, 46, -10],
    [1, 34, 5],
  ],
];
---

<g class="appendice-interno">
  <path class="pus" d="M-3.5 4C-3.5 20 -3.5 38 -2.5 46C-1.5 51 1.5 51 2.5 46C3.5 38 3.5 20 3.5 4Z"></path>
  <g class="vasi">
    <path d="M-6 12C-3 15 -5 19 -3 23"></path>
    <path d="M5 24C3 28 5 31 2 35"></path>
    <path d="M-5 34C-2 38 -4 41 -2 45"></path>
    <path d="M4 6C2 9 4 13 2 16"></path>
  </g>
  {
    batteri.map((gruppo, i) => (
      <g class={`batteri batteri--${i + 1}`}>
        {gruppo.map(([x, y, a]) => (
          <rect x="-1" y="-2.6" width="2" height="5.2" rx="1" transform={`translate(${x} ${y}) rotate(${a})`} />
        ))}
      </g>
    ))
  }
  <g class="tappo"><ellipse rx="3.4" ry="4.4"></ellipse></g>
  <path class="crepa" d="M-5 47L-2 55L0 50L2 56L5 47Z"></path>
</g>

<style>
  .pus {
    fill: var(--pus);
    opacity: 0;
  }
  .vasi path {
    fill: none;
    stroke: var(--arterioso);
    stroke-width: 1.2;
    stroke-linecap: round;
    opacity: 0;
  }
  .batteri {
    opacity: 0;
  }
  .batteri rect {
    fill: var(--batteri);
  }
  .tappo {
    opacity: 0;
    transform: translateY(-16px);
  }
  .tappo ellipse {
    fill: var(--feci);
    stroke: var(--contorno);
    stroke-width: 1;
  }
  .crepa {
    fill: var(--contorno);
    opacity: 0;
  }
</style>
