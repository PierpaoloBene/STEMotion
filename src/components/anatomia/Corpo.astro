---
// Sagoma del corpo di profilo (testa, collo, busto) con la colonna vertebrale.
// Sistema di riferimento condiviso: vedi README.md in questa cartella.
const vertebre = Array.from({ length: 29 }, (_, i) => 300 + i * 28);
---

<g class="corpo">
  <path
    class="corpo__sagoma"
    d="M300 470C250 425 190 385 186 295C182 170 255 68 385 62C490 58 562 102 574 170L578 196C590 212 626 238 642 258C644 266 636 272 626 272H612C606 280 612 290 614 298C612 306 604 309 600 311C608 316 612 324 608 334C602 342 594 346 594 358C598 378 592 394 566 400C534 406 504 412 492 432L486 560C500 600 590 630 600 700L592 1120H230L222 700C230 630 290 600 300 560Z"
  ></path>
  <g class="corpo__colonna">
    {vertebre.map((y) => <rect x="324" y={y} width="30" height="22" rx="6" />)}
  </g>
</g>

<style>
  .corpo__sagoma {
    fill: var(--pelle);
    stroke: var(--contorno);
    stroke-width: 3;
    stroke-linejoin: round;
  }
  .corpo__colonna rect {
    fill: var(--osso);
    stroke: var(--contorno);
    stroke-width: 2;
  }
</style>
