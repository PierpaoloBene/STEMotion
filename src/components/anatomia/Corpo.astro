---
// Sagoma del corpo di profilo (testa, collo, busto) con cranio, mandibola e colonna vertebrale.
// Sistema di riferimento condiviso: vedi README.md in questa cartella.
const vertebre = Array.from({ length: 29 }, (_, i) => 300 + i * 28);
const sagoma =
  'M300 470C250 425 190 385 186 295C182 170 255 68 385 62C490 58 562 102 574 170L578 196C590 212 626 238 642 258C644 266 636 272 626 272H612C606 280 612 290 614 298C612 306 604 309 600 311C608 316 612 324 608 334C602 342 594 346 594 358C598 378 592 394 566 400C534 406 504 412 492 432L486 560C500 600 590 630 600 700L592 1120H230L222 700C230 630 290 600 300 560Z';
---

<g class="corpo">
  <path class="corpo__sagoma" d={sagoma}></path>
  <!-- bordo più luminoso all'interno della sagoma, come il vetro colpito dalla luce -->
  <path class="corpo__riflesso" d={sagoma}></path>
  <!-- cranio (volta e base) e mandibola -->
  <g class="corpo__cranio">
    <path d="M222 356C194 300 196 170 300 96C360 66 470 70 530 110C556 128 566 160 566 196L552 204C550 172 538 146 516 128C462 90 368 88 312 114C234 160 218 270 246 340Z"></path>
    <path d="M552 196L560 206H404C390 226 372 258 350 292H334C356 258 374 224 396 196Z"></path>
    <path d="M242 332C270 322 300 304 320 288L334 292C306 316 272 338 236 350Z"></path>
    <path d="M580 326C590 342 590 370 583 390C574 398 556 398 550 392C553 370 564 342 572 326Z"></path>
  </g>
  <g class="corpo__colonna">
    {vertebre.map((y) => <rect x="324" y={y} width="30" height="22" rx="6" />)}
  </g>
</g>

<style>
  .corpo__sagoma {
    fill: var(--pelle);
    stroke: var(--contorno);
    stroke-width: 3;
    stroke-linejoin: round;
  }
  .corpo__riflesso {
    fill: none;
    stroke: var(--contorno);
    stroke-width: 16;
    stroke-linejoin: round;
    opacity: 0.18;
  }
  .corpo__cranio path {
    fill: var(--osso);
    stroke: var(--contorno);
    stroke-width: 1.5;
    stroke-linejoin: round;
    opacity: 0.7;
  }
  .corpo__colonna rect {
    fill: var(--osso);
    stroke: var(--contorno);
    stroke-width: 2;
  }
</style>
