---
// Corpo di profilo in sezione: sagoma, capelli, cranio con encefalo,
// colonna vertebrale con midollo spinale, diaframma.
// Sistema di riferimento condiviso: vedi README.md in questa cartella.
// Richiede <Sfumature /> nello stesso <svg>.
const vertebre = Array.from({ length: 29 }, (_, i) => 300 + i * 28);
const sagoma =
  'M300 470C250 425 190 385 186 295C182 170 255 68 385 62C490 58 562 102 574 170L578 196C590 212 626 238 642 258C644 266 636 272 626 272H612C606 280 612 290 614 298C612 306 604 309 600 311C608 316 612 324 608 334C602 342 594 346 594 358C598 378 592 394 566 400C534 406 504 412 492 432L486 560C500 600 590 630 600 700L592 1120H230L222 700C230 630 290 600 300 560Z';
---

<g class="corpo">
  <path class="corpo__sagoma" d={sagoma}></path>

  <!-- capelli sul cuoio capelluto -->
  <path class="corpo__capelli" d="M190 300C184 172 256 66 385 62C490 58 562 102 574 170L566 172C548 116 474 72 385 74C268 80 200 170 200 298Z"></path>

  <!-- encefalo: cervello, cervelletto, tronco encefalico -->
  <g class="encefalo">
    <path class="encefalo__cervello" d="M246 318C224 250 244 156 318 120C374 94 462 96 512 132C534 148 546 172 546 194C508 196 452 194 404 196C384 204 370 214 360 226C330 232 300 262 282 300C270 312 258 318 246 318Z"></path>
    <path class="encefalo__cervelletto" d="M250 326C252 300 272 278 302 272C322 268 338 276 344 288C326 300 298 322 262 338Z"></path>
    <path class="encefalo__tronco" d="M360 222C372 238 364 266 342 292L330 292C348 266 354 244 346 226Z"></path>
    <g class="encefalo__solchi">
      <path d="M322 208C352 176 440 170 492 192"></path>
      <path d="M300 150C330 160 342 180 340 200"></path>
      <path d="M392 108C400 130 396 152 380 170"></path>
      <path d="M470 118C458 138 460 160 476 176"></path>
      <path d="M262 250C286 240 300 222 298 196"></path>
      <path d="M516 150C500 160 492 176 496 190"></path>
      <path d="M268 312C286 300 306 292 330 290M262 324C284 312 306 304 336 298"></path>
    </g>
  </g>

  <!-- cranio: volta e base -->
  <path class="osso" d="M222 356C194 300 196 170 300 96C360 66 470 70 530 110C556 128 566 160 566 196L552 204C550 172 538 146 516 128C462 90 368 88 312 114C234 160 218 270 246 340Z"></path>
  <path class="osso" d="M552 196L560 206H404C390 226 372 258 350 292H334C356 258 374 224 396 196Z"></path>
  <path class="osso" d="M242 332C270 322 300 304 320 288L334 292C306 316 272 338 236 350Z"></path>

  <!-- colonna: corpi vertebrali, dischi, processi spinosi, midollo -->
  <path class="corpo__midollo" d="M314 292H326V1120H314Z"></path>
  <g class="corpo__colonna">
    {
      vertebre.map((y) => (
        <>
          <rect class="osso" x="330" y={y} width="26" height="22" rx="5" />
          <rect class="disco" x="332" y={y + 22} width="22" height="6" rx="2" />
          <path class="osso" d={`M314 ${y + 6}L300 ${y + 16}L302 ${y + 22}L314 ${y + 18}Z`} />
        </>
      ))
    }
  </g>

  <!-- diaframma: il muscolo sotto i polmoni, attraversato dall'esofago -->
  <path class="muscolo" d="M226 980C260 930 320 904 368 900V910C324 914 268 940 234 988Z"></path>
  <path class="muscolo" d="M414 900C480 896 560 910 598 936L596 948C558 922 482 908 414 910Z"></path>
</g>

<style>
  .corpo__sagoma {
    fill: url(#an-pelle);
    stroke: var(--pelle-bordo);
    stroke-width: 2.5;
    stroke-linejoin: round;
  }
  .corpo__capelli {
    fill: var(--capelli);
  }
  .encefalo__cervello,
  .encefalo__cervelletto,
  .encefalo__tronco {
    fill: url(#an-encefalo);
    stroke: var(--encefalo-bordo);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  .encefalo__solchi path {
    fill: none;
    stroke: var(--encefalo-bordo);
    stroke-width: 1.5;
    stroke-linecap: round;
    opacity: 0.55;
  }
  .osso {
    fill: url(#an-osso);
    stroke: var(--osso-bordo);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  .disco {
    fill: var(--cartilagine);
    stroke: var(--cartilagine-bordo);
    stroke-width: 1;
  }
  .corpo__midollo {
    fill: var(--midollo);
    stroke: var(--midollo-bordo);
    stroke-width: 1.5;
  }
  .muscolo {
    fill: url(#an-muscolo);
    stroke: var(--muscolo-bordo);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
</style>
