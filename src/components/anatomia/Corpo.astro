---
// Corpo di profilo come in una radiografia laterale: tessuti molli, polmoni e cuore,
// cranio, colonna vertebrale, coste, sterno e clavicola.
// Sistema di riferimento condiviso: vedi README.md in questa cartella.
// Richiede <Lastra /> nello stesso <svg>.
const sagoma =
  'M300 470C250 425 190 385 186 295C182 170 255 68 385 62C490 58 562 102 574 170L578 196C590 212 626 238 642 258C644 266 636 272 626 272H612C606 280 612 290 614 298C612 306 604 309 600 311C608 316 612 324 608 334C602 342 594 346 594 358C598 378 592 394 566 400C534 406 504 412 492 432L486 560C500 600 590 630 600 700L592 1120H230L222 700C230 630 290 600 300 560Z';
const vertebre = Array.from({ length: 29 }, (_, i) => 300 + i * 28);
const coste = Array.from({ length: 7 }, (_, i) => 630 + i * 32);
---

<g class="corpo">
  <!-- tessuti molli -->
  <path class="corpo__tessuto" d={sagoma}></path>

  <!-- polmoni pieni d'aria (scuri) e cuore (più chiaro) -->
  <path class="corpo__polmoni" d="M250 700C246 650 290 620 340 616L420 612C470 610 540 620 575 660C592 700 594 800 590 880C560 890 520 884 480 878C420 872 330 890 250 935C240 860 244 760 250 700Z"></path>
  <path class="corpo__cuore" d="M440 760C480 720 570 730 588 790C596 840 580 876 540 880C500 884 450 870 432 840C420 810 424 780 440 760Z"></path>

  <!-- cranio: volta con i due strati d'osso, base, sella turcica, orbita, osso nasale -->
  <path class="osso" d="M222 356C194 300 196 170 300 96C360 66 470 70 530 110C556 128 566 160 566 196L552 204C550 172 538 146 516 128C462 90 368 88 312 114C234 160 218 270 246 340Z"></path>
  <path class="osso" d="M552 196L560 206H404C390 226 372 258 350 292H334C356 258 374 224 396 196Z"></path>
  <path class="osso" d="M242 332C270 322 300 304 320 288L334 292C306 316 272 338 236 350Z"></path>
  <path class="osso-linea" d="M384 190C388 204 410 206 416 190"></path>
  <ellipse class="osso-linea" cx="528" cy="172" rx="32" ry="28"></ellipse>
  <path class="osso-linea" d="M578 196L612 234"></path>

  <!-- colonna: corpi vertebrali e archi posteriori con i processi spinosi -->
  <g>
    {
      vertebre.map((y) => (
        <>
          <rect class="osso" x="330" y={y} width="26" height="22" rx="4" />
          <path class="osso" d={`M330 ${y + 5}H318L302 ${y + 14}L305 ${y + 20}L318 ${y + 16}H330Z`} />
        </>
      ))
    }
  </g>

  <!-- gabbia toracica: coste, sterno, clavicola -->
  {coste.map((y) => <path class="costa" d={`M334 ${y}C262 ${y + 4} 236 ${y + 40} 262 ${y + 62}C320 ${y + 100} 470 ${y + 96} 584 ${y + 112}`} />)}
  <path class="osso osso--tenue" d="M576 650H590L588 880H574Z"></path>
  <path class="osso osso--tenue" d="M470 612C520 612 560 628 596 646L592 656C556 640 518 624 468 622Z"></path>
</g>

<style>
  .corpo__tessuto {
    fill: url(#rx-densita);
    stroke: var(--rx-tessuto);
    stroke-opacity: 0.35;
    stroke-width: 1.5;
    filter: url(#rx-morbido);
  }
  .corpo__polmoni {
    fill: var(--rx-aria-fondo);
    fill-opacity: 0.55;
    stroke: var(--aria);
    stroke-opacity: 0.35;
    stroke-width: 1.5;
    filter: url(#rx-morbido);
  }
  .corpo__cuore {
    fill: var(--rx-tessuto);
    fill-opacity: 0.3;
    filter: url(#rx-morbido);
    mix-blend-mode: screen;
  }
  .osso {
    fill: var(--rx-osso);
    fill-opacity: 0.2;
    stroke: var(--rx-osso);
    stroke-opacity: 0.85;
    stroke-width: 1.5;
    stroke-linejoin: round;
    mix-blend-mode: screen;
  }
  .osso--tenue {
    fill-opacity: 0.1;
    stroke-opacity: 0.4;
  }
  .osso-linea {
    fill: none;
    stroke: var(--rx-osso);
    stroke-opacity: 0.6;
    stroke-width: 2.5;
    stroke-linecap: round;
    mix-blend-mode: screen;
  }
  .costa {
    fill: none;
    stroke: var(--rx-osso);
    stroke-opacity: 0.2;
    stroke-width: 6;
    stroke-linecap: round;
    mix-blend-mode: screen;
  }
</style>
