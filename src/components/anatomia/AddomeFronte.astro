<style>
  .addome__pelle {
    fill: var(--pelle);
    stroke: var(--contorno);
    stroke-width: 3;
    stroke-linejoin: round;
  }
  .addome__costole {
    fill: none;
    stroke: var(--osso);
    stroke-width: 8;
    stroke-linecap: round;
  }
  .addome__diaframma {
    fill: none;
    stroke: var(--muscolo);
    stroke-width: 5;
    stroke-linecap: round;
  }
</style>
