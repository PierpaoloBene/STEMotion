---
/**
 * Effetto "taccuino" delle illustrazioni (guida di stile, §7): va messo una volta,
 * all'inizio dell'<svg>. Il gruppo con filter="url(#tr-mano)" sembra disegnato a mano:
 * - il tratto di china e i bordi dei colori tremano un poco, come fatti a mano libera;
 * - sulle campiture compare la grana della carta, come un acquerello.
 * Il rumore è fisso nel disegno: la stessa forma trema sempre allo stesso modo.
 */
---

<defs>
  <filter id="tr-mano" x="-5%" y="-5%" width="110%" height="110%" color-interpolation-filters="sRGB">
    <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="4" result="onde"></feTurbulence>
    <feDisplacementMap in="SourceGraphic" in2="onde" scale="5" xChannelSelector="R" yChannelSelector="G" result="mano"></feDisplacementMap>
    <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="2" seed="9" result="fibre"></feTurbulence>
    <feColorMatrix in="fibre" type="matrix" values="0 0 0 0 0.35  0 0 0 0 0.3  0 0 0 0 0.25  0 0 0 -1.3 0.55" result="grana"></feColorMatrix>
    <feComposite in="grana" in2="mano" operator="in" result="granaDentro"></feComposite>
    <feMerge>
      <feMergeNode in="mano"></feMergeNode>
      <feMergeNode in="granaDentro"></feMergeNode>
    </feMerge>
  </filter>
</defs>
