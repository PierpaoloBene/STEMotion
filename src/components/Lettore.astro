---
/**
 * Lettore a passaggi: il guscio comune a ogni argomento.
 *
 * Contratto con l'animazione (lo slot):
 * - il contenitore [data-palco] ha sempre `data-passaggio="<id>"` e `data-indice="<n>"`
 *   del passaggio corrente → l'animazione può disegnare ogni stato solo con CSS;
 * - a ogni cambio viene emesso sul palco l'evento `cambiapassaggio`
 *   con detail { indice, id, precedente, ripeti } → per le animazioni che usano JS.
 * Lo stato dipende solo dal passaggio corrente: nessuno stato nascosto.
 *
 * Interfaccia "a storie" (guida di stile, §5): barre in alto, tocchi sul palco
 * nel modello `passaggi`, lettore a tutto schermo sul telefono, schermata finale.
 *
 * Deviazioni (guida di stile, §5): un passaggio può avere dei pulsanti che aprono un box
 * (<dialog data-box id="box-<slug>">) con dentro un altro lettore, `annidato`: niente
 * schermata finale, indirizzo o progressi, e all'ultimo passaggio Avanti chiude il box.
 */
import { testoInline } from '../lib/testo';

interface Passaggio {
  id: string;
  fase?: string;
  titolo: string;
  breve: string;
  spiegazione: string;
  /** Slug delle deviazioni che si aprono da questo passaggio. */
  deviazioni?: string[];
}
interface Link {
  titolo: string;
  href: string;
}
interface Props {
  /** Id dell'argomento (es. "scienze/deglutizione"), per ricordare i progressi nel browser. */
  id: string;
  passaggi: Passaggio[];
  titolo: string;
  modello: 'passaggi' | 'simulazione' | 'confronto';
  /** Argomento consigliato dopo questo, se c'è. */
  prossimo?: Link | null;
  /** Pagina della materia, per la schermata finale quando manca il prossimo argomento. */
  materia: Link;
  /** Testo dei pulsanti delle deviazioni, per slug. */
  pulsanti?: Record<string, string>;
  /** Lettore dentro il box di una deviazione. */
  annidato?: boolean;
  /** Testo di Avanti all'ultimo passaggio di un lettore annidato, es. "Torna alla deglutizione". */
  ritorno?: string;
}
const { id, passaggi, titolo, modello, prossimo, materia, pulsanti = {}, annidato = false, ritorno = 'Chiudi' } = Astro.props;
const n = passaggi.length;
// Più lettori nella stessa pagina (i box delle deviazioni): id diversi.
const idTesti = `testi-${id.replace(/[^a-z0-9]+/gi, '-')}`;
const tocchi = modello === 'passaggi';
---

<section class:list={['lettore', annidato && 'lettore--annidato']} data-lettore data-annidato={annidato ? '' : undefined} data-argomento={id} data-titolo={titolo} data-modello={modello} data-ids={JSON.stringify(passaggi.map((p) => p.id))} aria-label={`Animazione: ${titolo}`}>
  <div class="lettore__barra">
    <ol class="barre">
      {
        passaggi.map((p, i) => (
          <li>
            <button type="button" class="barra" data-vai={i} aria-label={`Passaggio ${i + 1}: ${p.titolo}`} aria-current={i === 0 ? 'step' : undefined}>
              <span />
            </button>
          </li>
        ))
      }
    </ol>
    <button type="button" class="tasto tasto--icona lettore__chiudi" data-azione="chiudi" title="Chiudi (Esc)" aria-label="Chiudi">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
  </div>

  <div class="lettore__palco" data-palco data-passaggio={passaggi[0].id} data-indice="0">
    <slot />
  </div>

  {
    !annidato && (
      <div class="lettore__inizia" data-azione="inizia">
        <button type="button" class="tasto tasto--primario tasto--grande" data-azione="inizia">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 5l11 7-11 7z" />
          </svg>
          <span>Inizia</span>
        </button>
        <p>{n} passaggi{tocchi && ' · tocca a destra per andare avanti, a sinistra per tornare indietro'}</p>
      </div>
    )
  }

  <div class="lettore__testi" id={idTesti} aria-live="polite">
    {
      passaggi.map((p, i) => (
        <article class="passaggio" data-i={i} hidden={i !== 0}>
          <p class="passaggio__contatore">
            {annidato && `${titolo} · `}Passaggio {i + 1} di {n}
            {p.fase && <span> · fase {p.fase}</span>}
          </p>
          <h2 class="passaggio__titolo">{p.titolo}</h2>
          <p class="passaggio__breve">{p.breve}</p>
          {p.deviazioni && p.deviazioni.length > 0 && (
            <div class="deviazioni">
              <p class="deviazioni__domanda">E se qualcosa va storto?</p>
              <div class="deviazioni__pulsanti">
                {p.deviazioni.map((d) => (
                  <button type="button" class="tasto deviazioni__tasto" data-box={d} aria-haspopup="dialog">
                    <span>{pulsanti[d] ?? d}</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M5 5h14v14H5zM9 15l6-6M10 9h5v5" />
                    </svg>
                  </button>
                ))}
              </div>
            </div>
          )}
          <p class="passaggio__spiegazione" set:html={testoInline(p.spiegazione)} />
        </article>
      ))
    }
    <button type="button" class="espandi" data-azione="espandi" aria-expanded="false" aria-controls={idTesti}>
      <span class="espandi__apri">Leggi la spiegazione</span>
      <span class="espandi__chiudi">Riduci</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
    </button>
  </div>

  {
    !annidato && (
      <div class="lettore__fine" data-fine hidden tabindex="-1" aria-labelledby="lettore-fine-titolo">
        <h2 id="lettore-fine-titolo">Hai visto tutti i {n} passaggi</h2>
        <div class="fine__azioni">
          <button type="button" class="tasto" data-azione="rivedi">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.5-5.8"></path><path d="M4 4v5h5"></path></svg>
            <span>Rivedi dall'inizio</span>
          </button>
          <button type="button" class="tasto" data-azione="condividi">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V4M7 9l5-5 5 5"></path><path d="M5 13v6h14v-6"></path></svg>
            <span>Condividi</span>
          </button>
        </div>
        <p class="fine__esito" data-esito aria-live="polite"></p>
        {
          prossimo ? (
            <a class="prossimo" href={prossimo.href}>
              <span class="prossimo__etichetta">Prossimo argomento</span>
              <span class="prossimo__titolo">{prossimo.titolo}</span>
            </a>
          ) : (
            <a class="prossimo" href={materia.href}>
              <span class="prossimo__etichetta">Continua a esplorare</span>
              <span class="prossimo__titolo">Altri argomenti di {materia.titolo}</span>
            </a>
          )
        }
        <h3 class="fine__sottotitolo">Ripassa i passaggi</h3>
        <ol class="riepilogo">
          {
            passaggi.map((p, i) => (
              <li>
                <button type="button" class="riepilogo__voce" data-vai={i}>
                  <span class="riepilogo__numero" aria-hidden="true">{i + 1}</span>
                  <span class="riepilogo__testo">
                    <strong>{p.titolo}</strong>
                    <span>{p.breve}</span>
                  </span>
                </button>
              </li>
            ))
          }
        </ol>
      </div>
    )
  }

  <nav class="lettore__comandi" aria-label="Comandi dell'animazione">
    <button type="button" class="tasto" data-azione="indietro" title="Indietro (←)">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
      <span class="tasto__etichetta">Indietro</span>
    </button>

    <button type="button" class="tasto tasto--primario tasto--avanti" data-azione="avanti" title="Avanti (→ o spazio)">
      <span class="tasto__avanti">Avanti</span>
      {annidato && <span class="tasto__torna">{ritorno}</span>}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
    </button>

    <div class="lettore__extra">
      <button type="button" class="tasto tasto--icona" data-azione="ripeti" title="Ripeti il passaggio (R)" aria-label="Ripeti il passaggio">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.5-5.8"></path><path d="M4 4v5h5"></path></svg>
      </button>
      <button type="button" class="tasto tasto--icona" data-azione="testo" title="Mostra o nascondi la spiegazione (T)" aria-label="Spiegazione" aria-pressed="true">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 6h14M5 11h14M5 16h9"></path></svg>
      </button>
      <button type="button" class="tasto tasto--icona" data-azione="schermo" title="Schermo intero (F)" aria-label="Schermo intero" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path></svg>
      </button>
    </div>
  </nav>
</section>

<script>
  type Dettaglio = { indice: number; id: string; precedente: number | null; ripeti: boolean };

  const CHIAVE_TESTO = 'raggi-x:spiegazione';
  const CHIAVE_ULTIMO = 'raggi-x:ultimo';
  const CHIAVE_VISTI = 'raggi-x:visti';
  const leggi = (k: string) => {
    try {
      return localStorage.getItem(k);
    } catch {
      return null;
    }
  };
  const scrivi = (k: string, v: string) => {
    try {
      localStorage.setItem(k, v);
    } catch {
      /* navigazione privata: pazienza */
    }
  };

  // Stesso limite del CSS: sotto questa larghezza il lettore si apre a tutto schermo.
  const stretto = matchMedia('(max-width: 899px)');
  // I tocchi su questi elementi appartengono all'animazione, non cambiano passaggio.
  const INTERATTIVI = '[data-interattivo], button, a, input, select, textarea, label';

  function avvia(radice: HTMLElement) {
    const palco = radice.querySelector<HTMLElement>('[data-palco]')!;
    const articoli = [...radice.querySelectorAll<HTMLElement>('.passaggio')];
    const barre = [...radice.querySelectorAll<HTMLButtonElement>('.barra')];
    // Nel box di una deviazione non ci sono schermata finale né esito della condivisione.
    const fineEl = radice.querySelector<HTMLElement>('[data-fine]');
    const esitoEl = radice.querySelector<HTMLElement>('[data-esito]');
    const annidato = radice.hasAttribute('data-annidato');
    const box = radice.closest('dialog');
    const elencoId = JSON.parse(radice.dataset.ids ?? '[]') as string[];
    const n = articoli.length;
    const tocchi = radice.dataset.modello === 'passaggi';
    const btn = (azione: string) => radice.querySelector<HTMLButtonElement>(`button[data-azione="${azione}"]`)!;
    const btnIndietro = btn('indietro');
    const btnAvanti = btn('avanti');
    const btnRipeti = btn('ripeti');
    const btnTesto = btn('testo');
    const btnSchermo = btn('schermo');
    const btnEspandi = btn('espandi');

    let indice = 0;
    let fine = false;
    let pronto = false; // i progressi si salvano solo dopo un'azione, non all'apertura

    // Progressi solo nel browser (guida di stile, §9): servono a "Continua" e alla spunta "Visto".
    function ricorda() {
      if (!pronto || annidato) return;
      const id = radice.dataset.argomento!;
      const ultimo = { id, titolo: radice.dataset.titolo, href: location.pathname, passo: indice + 1, n, fine };
      scrivi(CHIAVE_ULTIMO, JSON.stringify(ultimo));
      if (!fine) return;
      let visti: string[] = [];
      try {
        visti = JSON.parse(leggi(CHIAVE_VISTI) ?? '[]');
      } catch {
        /* memoria illeggibile: si riparte */
      }
      if (!visti.includes(id)) scrivi(CHIAVE_VISTI, JSON.stringify([...visti, id]));
    }

    function aggiornaIndirizzo() {
      if (annidato) return;
      // Conserva lo stato della cronologia: serve a chiudere il lettore col tasto "indietro".
      history.replaceState(history.state, '', fine ? '#fine' : `#p${indice + 1}`);
    }

    function aggiornaComandi() {
      articoli.forEach((a, k) => (a.hidden = k !== indice));
      barre.forEach((b, k) => {
        if (k === indice && !fine) b.setAttribute('aria-current', 'step');
        else b.removeAttribute('aria-current');
        b.classList.toggle('fatto', fine || k < indice);
      });
      radice.classList.toggle('lettore--fine', fine);
      // All'ultimo passaggio di un box, Avanti diventa "Torna a …" e lo chiude.
      radice.classList.toggle('lettore--ultimo', annidato && indice === n - 1);
      if (fineEl) fineEl.hidden = !fine;
      btnIndietro.disabled = !fine && indice === 0;
      btnAvanti.disabled = fine;
      btnRipeti.disabled = fine;
      aggiornaIndirizzo();
      ricorda();
    }

    function imposta(i: number, ripeti = false) {
      const prima = indice;
      const eraFine = fine;
      indice = Math.max(0, Math.min(n - 1, i));
      fine = false;
      const precedente = ripeti ? prima : indice === prima ? null : prima;
      aggiornaComandi();
      // Dalla schermata finale il palco è già sull'ultimo passaggio: se non cambia, niente evento.
      if (eraFine && !ripeti && palco.dataset.indice === String(indice)) return;
      palco.dataset.passaggio = elencoId[indice];
      palco.dataset.indice = String(indice);
      const detail: Dettaglio = { indice, id: elencoId[indice], precedente, ripeti };
      palco.dispatchEvent(new CustomEvent('cambiapassaggio', { detail, bubbles: true }));
    }

    // La schermata finale non tocca il palco, che resta sull'ultimo passaggio.
    function mostraFine() {
      indice = n - 1;
      fine = true;
      if (esitoEl) esitoEl.textContent = '';
      aggiornaComandi();
      if (fineEl) {
        fineEl.scrollTop = 0;
        fineEl.focus({ preventScroll: true });
      }
    }

    const avanti = () => {
      if (fine) return;
      if (indice === n - 1 && annidato) box?.close();
      else if (indice === n - 1) mostraFine();
      else imposta(indice + 1);
    };
    const indietro = () => imposta(fine ? n - 1 : indice - 1);

    // Ripeti: riporta per un istante il palco allo stato precedente, senza transizioni,
    // poi torna al passaggio corrente così la transizione riparte.
    function ripeti() {
      if (fine) return;
      palco.classList.add('senza-transizioni');
      if (indice > 0) {
        palco.dataset.passaggio = elencoId[indice - 1];
        palco.dataset.indice = String(indice - 1);
      } else {
        palco.dataset.passaggio = '';
        palco.dataset.indice = '-1';
      }
      void palco.offsetWidth; // forza il ricalcolo degli stili
      palco.classList.remove('senza-transizioni');
      requestAnimationFrame(() => imposta(indice, true));
    }

    function impostaTesto(visibile: boolean) {
      radice.classList.toggle('lettore--lezione', !visibile);
      btnTesto.setAttribute('aria-pressed', String(visibile));
      scrivi(CHIAVE_TESTO, visibile ? 'si' : 'no');
    }

    function espandi(aperto: boolean) {
      radice.classList.toggle('lettore--espanso', aperto);
      btnEspandi.setAttribute('aria-expanded', String(aperto));
    }

    function schermoIntero() {
      if (document.fullscreenElement) document.exitFullscreen();
      else radice.requestFullscreen?.();
    }

    async function condividi() {
      const indirizzo = location.href.split('#')[0];
      if (navigator.share) {
        try {
          await navigator.share({ title: document.title, url: indirizzo });
        } catch {
          /* condivisione annullata */
        }
        return;
      }
      try {
        await navigator.clipboard.writeText(indirizzo);
        if (esitoEl) esitoEl.textContent = 'Link copiato: ora puoi incollarlo dove vuoi.';
      } catch {
        if (esitoEl) esitoEl.textContent = `Copia questo link: ${indirizzo}`;
      }
    }

    // --- Lettore a tutto schermo sul telefono ---

    // Rende inerte tutto il resto della pagina, così il focus resta nel lettore.
    // I box delle deviazioni restano attivi: si aprono sopra il lettore.
    function inerteAttorno(attivo: boolean) {
      let el: HTMLElement = radice;
      while (el.parentElement && el !== document.body) {
        for (const fratello of el.parentElement.children) {
          if (fratello !== el && fratello instanceof HTMLElement && !fratello.matches('[data-box]')) fratello.inert = attivo;
        }
        el = el.parentElement;
      }
    }

    function apri() {
      if (radice.classList.contains('lettore--immersivo')) return;
      radice.classList.add('lettore--immersivo');
      document.documentElement.classList.add('blocca-scorrimento');
      inerteAttorno(true);
      // Una voce nella cronologia: il tasto "indietro" del telefono chiude il lettore.
      history.pushState({ lettore: true }, '', location.href);
      btnAvanti.focus({ preventScroll: true });
    }

    function esci() {
      if (!radice.classList.contains('lettore--immersivo')) return;
      if (document.fullscreenElement) document.exitFullscreen();
      radice.classList.remove('lettore--immersivo');
      document.documentElement.classList.remove('blocca-scorrimento');
      inerteAttorno(false);
      aggiornaIndirizzo();
      radice.scrollIntoView({ block: 'nearest' });
    }

    const chiudi = () => {
      if (annidato) box?.close();
      else if (history.state?.lettore) history.back();
      else esci();
    };

    // --- Deviazioni: il box si apre sopra la pagina e riparte dal primo passaggio ---

    function apriBox(slug: string, pulsante: HTMLElement) {
      const deviazione = document.getElementById(`box-${slug}`);
      if (!(deviazione instanceof HTMLDialogElement)) return;
      deviazione.showModal();
      deviazione.dispatchEvent(new Event('apri'));
      deviazione.addEventListener(
        'close',
        () => {
          impostaTesto(leggi(CHIAVE_TESTO) !== 'no'); // il testo sì/no si può cambiare anche nel box
          pulsante.focus({ preventScroll: true });
        },
        { once: true },
      );
    }

    box?.addEventListener('apri', () => {
      impostaTesto(leggi(CHIAVE_TESTO) !== 'no');
      espandi(false);
      indice = 0;
      ripeti(); // dallo stato "prima del passaggio 1", così la prima animazione si vede
      btnAvanti.focus({ preventScroll: true });
    });

    window.addEventListener('popstate', () => {
      if (!history.state?.lettore) esci();
    });

    // --- Tocchi e scorrimenti sul palco (solo modello "passaggi") ---

    let inizioX = NaN;
    let inizioY = NaN;
    if (tocchi) {
      palco.addEventListener('pointerdown', (e) => {
        const suInterattivo = (e.target as Element).closest(INTERATTIVI);
        inizioX = suInterattivo ? NaN : e.clientX;
        inizioY = e.clientY;
      });
      palco.addEventListener('pointerup', (e) => {
        const dx = e.clientX - inizioX;
        const dy = e.clientY - inizioY;
        if (Math.abs(dx) > 50 && Math.abs(dx) > 1.5 * Math.abs(dy)) {
          if (dx < 0) avanti();
          else indietro();
        }
      });
      palco.addEventListener('click', (e) => {
        if (Number.isNaN(inizioX) || fine) return;
        // Un dito che si è spostato è uno scorrimento, già gestito in pointerup.
        if (Math.hypot(e.clientX - inizioX, e.clientY - inizioY) > 20) return;
        const r = palco.getBoundingClientRect();
        if (e.clientX - r.left < r.width / 3) indietro();
        else avanti();
      });
    }

    radice.addEventListener('click', (e) => {
      const bersaglio = e.target as HTMLElement;
      if (bersaglio.closest('[data-azione="inizia"]')) return apri();
      const t = bersaglio.closest<HTMLButtonElement>('button');
      if (!t) return;
      if (t.dataset.vai) return imposta(Number(t.dataset.vai));
      if (t.dataset.box) return apriBox(t.dataset.box, t);
      switch (t.dataset.azione) {
        case 'indietro':
          return indietro();
        case 'avanti':
          return avanti();
        case 'ripeti':
          return ripeti();
        case 'testo':
          return impostaTesto(radice.classList.contains('lettore--lezione'));
        case 'espandi':
          return espandi(!radice.classList.contains('lettore--espanso'));
        case 'schermo':
          return schermoIntero();
        case 'rivedi':
          return imposta(0);
        case 'condividi':
          return condividi();
        case 'chiudi':
          return chiudi();
      }
    });

    // Tastiera e telecomandi da presentazione (che inviano PagGiù/PagSu).
    document.addEventListener('keydown', (e) => {
      if (e.altKey || e.ctrlKey || e.metaKey) return;
      // Con un box aperto comanda solo il suo lettore.
      if (annidato ? !box?.open : document.querySelector('dialog[open]')) return;
      const bersaglio = e.target as HTMLElement;
      if (bersaglio.closest('input, textarea, select, [contenteditable]')) return;
      const tasto = e.key.toLowerCase();
      const mappa: Record<string, () => void> = {
        arrowright: avanti,
        pagedown: avanti,
        ' ': avanti,
        arrowleft: indietro,
        pageup: indietro,
        r: ripeti,
        t: () => impostaTesto(radice.classList.contains('lettore--lezione')),
        ...(annidato ? {} : { f: schermoIntero }),
        escape: () => (annidato || radice.classList.contains('lettore--immersivo')) && chiudi(),
      };
      if (tasto === ' ' && bersaglio.closest('button, a')) return; // lo spazio su un pulsante lo attiva già
      const azione = mappa[tasto];
      if (azione) {
        e.preventDefault();
        azione();
      }
    });

    if (document.fullscreenEnabled && !annidato) btnSchermo.hidden = false;
    document.addEventListener('fullscreenchange', () => {
      radice.classList.toggle('lettore--schermo', document.fullscreenElement === radice);
    });

    radice.classList.add('lettore--attivo');
    impostaTesto(leggi(CHIAVE_TESTO) !== 'no');

    // Un link a un passaggio (#p3) o alla fine (#fine) riapre il lettore lì.
    function daIndirizzo() {
      const hash = location.hash;
      const numero = Number(hash.match(/^#p(\d+)$/)?.[1]);
      if (hash === '#fine') {
        imposta(n - 1);
        mostraFine();
      } else imposta(numero > 0 ? numero - 1 : 0);
      return hash === '#fine' || numero > 0;
    }
    if (annidato) imposta(0);
    else {
      window.addEventListener('hashchange', daIndirizzo);
      if (daIndirizzo() && stretto.matches) apri();
    }
    pronto = true;
  }

  document.querySelectorAll<HTMLElement>('[data-lettore]').forEach(avvia);
</script>

<style>
  .lettore {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
