---
// Mostrato al posto dell'animazione finché l'argomento non ha il suo Animazione.astro.
interface Props {
  passaggi: { id: string; titolo: string }[];
}
const { passaggi } = Astro.props;
---

<div class="segnaposto" data-segnaposto>
  <p class="segnaposto__nota">Animazione in preparazione</p>
  {
    passaggi.map((p, i) => (
      <div class="segnaposto__passo" data-per={p.id} hidden={i !== 0}>
        <span class="segnaposto__numero">{i + 1}</span>
        <span class="segnaposto__titolo">{p.titolo}</span>
      </div>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-segnaposto]').forEach((el) => {
    const palco = el.closest<HTMLElement>('[data-palco]');
    palco?.addEventListener('cambiapassaggio', (e) => {
      const { id } = (e as CustomEvent<{ id: string }>).detail;
      el.querySelectorAll<HTMLElement>('[data-per]').forEach((p) => (p.hidden = p.dataset.per !== id));
    });
  });
</script>

<style>
  .segnaposto {
    position: absolute;
    inset: 16px;
    display: grid;
    place-items: center;
    border: 3px dashed var(--bordo);
    border-radius: 12px;
    text-align: center;
  }
  .segnaposto__nota {
    position: absolute;
    top: 12px;
    left: 16px;
    margin: 0;
    font-size: 16px;
    color: var(--testo-2);
  }
  @media (max-width: 520px) {
    .segnaposto__nota {
      display: none;
    }
  }
  .segnaposto__passo {
    display: grid;
    gap: 8px;
    justify-items: center;
    padding: 16px;
  }
  .segnaposto__passo[hidden] {
    display: none;
  }
  .segnaposto__numero {
    display: grid;
    place-items: center;
    width: 88px;
    height: 88px;
    border-radius: 50%;
    background: var(--accento);
    color: #fff;
    font-size: 44px;
    font-weight: 700;
  }
  .segnaposto__titolo {
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 700;
  }
</style>
