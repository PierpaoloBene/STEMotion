---
import '@fontsource/atkinson-hyperlegible/400.css';
import '@fontsource/atkinson-hyperlegible/700.css';
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { url } from '../lib/url';

interface Props {
  titolo?: string;
  descrizione?: string;
  /** Materia della pagina: evidenziata nella navigazione. */
  materia?: string;
}

const NOME_SITO = 'Animazioni ai raggi X';
const { titolo, descrizione = 'Animazioni interattive per capire scienze, matematica e fisica alle scuole medie.', materia } = Astro.props;
const titoloPagina = titolo ? `${titolo} · ${NOME_SITO}` : NOME_SITO;
const materie = (await getCollection('materie')).sort((a, b) => a.data.ordine - b.data.ordine);
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descrizione} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <title>{titoloPagina}</title>
  </head>
  <body>
    <header class="testata">
      <div class="contenitore contenitore--largo testata__riga">
        <a class="marchio" href={url()}>
          <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="9" fill="#16233F"></rect><path d="M10 9l12 14M22 9L10 23" stroke="#8EC9F0" stroke-width="4" stroke-linecap="round"></path></svg>
          <span>Animazioni <span class="marchio__raggi">ai raggi X</span></span>
        </a>
        <nav class="menu" aria-label="Materie">
          <ul>
            {
              materie.map((m) => (
                <li>
                  <a class="menu__voce" href={url(`${m.id}/`)} data-materia={m.id} aria-current={m.id === materia ? 'page' : undefined}>
                    <span class="menu__pallino" aria-hidden="true" />
                    {m.data.nome}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="piede">
      <div class="contenitore contenitore--largo piede__riga">
        <p class="piede__marchio">Animazioni ai raggi X</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .testata {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--bordo);
  }
  .testata__riga {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 24px;
    padding-block: 6px;
  }
  .marchio {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: var(--tocco);
    color: var(--testo);
    font-weight: 700;
    font-size: 22px;
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .marchio svg {
    width: 38px;
    height: 38px;
    flex: none;
  }
  .marchio__raggi {
    color: var(--accento);
  }
  .menu ul {
    display: flex;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu__voce {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: var(--tocco);
    padding: 0 18px;
    border: 2px solid transparent;
    border-radius: 999px;
    color: var(--testo);
    font-weight: 700;
    font-size: 18px;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background 0.2s ease-in-out,
      border-color 0.2s ease-in-out;
  }
  .menu__voce:hover {
    background: var(--tinta);
  }
  .menu__voce[aria-current='page'] {
    background: var(--tinta);
    border-color: var(--scuro);
  }
  .menu__pallino {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--colore);
  }

  /* Telefono: le materie diventano una riga che scorre sotto il marchio. */
  @media (max-width: 719px) {
    /* Due righe di testata fissa ruberebbero troppo schermo al telefono. */
    .testata {
      position: static;
    }
    .testata__riga {
      padding-inline: 0;
    }
    .marchio {
      padding-inline: var(--margine);
    }
    .menu {
      width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .menu ul {
      padding: 0 var(--margine) 6px;
      width: max-content;
    }
    .menu__voce {
      padding: 0 14px;
    }
  }

  main {
    min-height: 60vh;
  }
  .piede {
    margin-top: 80px;
    background: var(--radiografia);
    color: #d8e2f0;
    font-size: 16px;
  }
  .piede__riga {
    padding-block: 32px;
  }
  .piede p {
    margin: 0;
  }
  .piede__marchio {
    font-size: 20px;
    font-weight: 700;
    color: #fff;
  }
</style>
