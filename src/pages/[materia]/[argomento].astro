---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Lettore from '../../components/Lettore.astro';
import Segnaposto from '../../components/Segnaposto.astro';
import { url } from '../../lib/url';
import { elencoClassi, tornaA } from '../../lib/testo';

export async function getStaticPaths() {
  const argomenti = await getCollection('argomenti');
  return argomenti.map((argomento) => {
    const [cartellaMateria, slug] = argomento.id.split('/');
    if (cartellaMateria !== argomento.data.materia.id) {
      throw new Error(
        `argomenti/${argomento.id}: la cartella è "${cartellaMateria}" ma argomento.yaml dice materia: ${argomento.data.materia.id}`,
      );
    }
    return { params: { materia: cartellaMateria, argomento: slug }, props: { argomento } };
  });
}

interface Props {
  argomento: CollectionEntry<'argomenti'>;
}
const { argomento } = Astro.props;
const { data } = argomento;

const materia = (await getEntry(data.materia))!;
const passaggi = await getEntry('passaggi', argomento.id);
if (!passaggi) throw new Error(`argomenti/${argomento.id}: manca passaggi.yaml`);

const note = await getEntry('note', argomento.id);
const Note = note ? (await render(note)).Content : null;

// Ogni argomento può avere il suo Animazione.astro nella propria cartella.
const moduli = import.meta.glob<{ default: any }>('/argomenti/*/*/Animazione.astro', { eager: true });
const Animazione = moduli[`/argomenti/${argomento.id}/Animazione.astro`]?.default;

// Deviazioni: processi alternativi che si aprono in un box da un passaggio (guida di stile, §5).
const moduliDeviazioni = import.meta.glob<{ default: any }>('/argomenti/*/*/deviazioni/*/Animazione.astro', { eager: true });
const deviazioni = (await getCollection('deviazioni'))
  .filter((d) => d.id.startsWith(`${argomento.id}/deviazioni/`))
  .map((d) => ({
    slug: d.id.split('/').pop()!,
    ...d.data,
    Animazione: moduliDeviazioni[`/argomenti/${d.id}/Animazione.astro`]?.default,
  }));
for (const p of passaggi.data.passaggi) {
  for (const slug of p.deviazioni) {
    if (!deviazioni.some((d) => d.slug === slug)) {
      throw new Error(`argomenti/${argomento.id}: il passaggio "${p.id}" apre la deviazione "${slug}", ma manca deviazioni/${slug}/deviazione.yaml`);
    }
  }
}
const pulsanti = Object.fromEntries(deviazioni.map((d) => [d.slug, d.pulsante]));

// Prossimo argomento per la schermata finale: prima uno che ha questo tra i prerequisiti,
// altrimenti il successivo in ordine alfabetico nella stessa materia.
const slug = (a: CollectionEntry<'argomenti'>) => a.id.split('/')[1];
const stessaMateria = (await getCollection('argomenti'))
  .filter((a) => a.data.materia.id === materia.id)
  .sort((a, b) => a.data.titolo.localeCompare(b.data.titolo, 'it'));
const dopo =
  stessaMateria.find((a) => a.data.prerequisiti.includes(slug(argomento))) ??
  stessaMateria[stessaMateria.findIndex((a) => a.id === argomento.id) + 1];
const prossimo = dopo ? { titolo: dopo.data.titolo, href: url(`${materia.id}/${slug(dopo)}/`) } : null;
---

<Base titolo={data.titolo} descrizione={data.sottotitolo} materia={materia.id}>
  <section class="fascia" data-materia={materia.id}>
    <div class="contenitore contenitore--largo">
      <a class="indietro" href={url(`${materia.id}/`)}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
        {materia.data.nome}
      </a>
      <h1>{data.titolo}</h1>
      <p class="sottotitolo">{data.sottotitolo}</p>
      <p class="info">
        <span class="badge">{elencoClassi(data.classi)}</span>
        <span class="badge">{data.durata_minuti} min</span>
        <span class="badge">{passaggi.data.passaggi.length} passaggi</span>
        {data.stato !== 'pubblicato' && <span class="badge badge--bozza">Bozza: contenuti da revisionare</span>}
      </p>
    </div>
  </section>

  <div class="contenitore contenitore--largo corpo" data-materia={materia.id}>
    <Lettore
      id={argomento.id}
      passaggi={passaggi.data.passaggi}
      titolo={data.titolo}
      modello={data.modello}
      prossimo={prossimo}
      materia={{ titolo: materia.data.nome, href: url(`${materia.id}/`) }}
      pulsanti={pulsanti}
    >
      {Animazione ? <Animazione /> : <Segnaposto passaggi={passaggi.data.passaggi} />}
    </Lettore>

    {
      deviazioni.map(({ slug, titolo, passaggi: passi, Animazione: AnimazioneDeviazione }) => (
        <dialog class="box" id={`box-${slug}`} data-box aria-label={titolo}>
          <Lettore
            id={`${argomento.id}/${slug}`}
            passaggi={passi}
            titolo={titolo}
            modello="passaggi"
            materia={{ titolo: materia.data.nome, href: url(`${materia.id}/`) }}
            annidato
            ritorno={tornaA(data.titolo)}
          >
            {AnimazioneDeviazione ? <AnimazioneDeviazione /> : <Segnaposto passaggi={passi} />}
          </Lettore>
        </dialog>
      ))
    }

    <p class="aiuto">Tastiera: <kbd>→</kbd> o <kbd>spazio</kbd> avanti · <kbd>←</kbd> indietro · <kbd>R</kbd> ripeti · <kbd>T</kbd> spiegazione · <kbd>F</kbd> schermo intero</p>

    <div class="schede">
      <section class="riquadro">
        <h2>Alla fine saprai</h2>
        <ul class="obiettivi">
          {
            data.obiettivi.map((o) => (
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
                <span>{o}</span>
              </li>
            ))
          }
        </ul>
      </section>
      {
        data.parole_chiave.length > 0 && (
          <section class="riquadro">
            <h2>Parole chiave</h2>
            <ul class="parole">
              {data.parole_chiave.map((p) => <li>{p}</li>)}
            </ul>
          </section>
        )
      }
    </div>

    {
      Note && (
        <details class="riquadro note">
          <summary>
            Note per l'insegnante
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
          </summary>
          <div class="note__corpo">
            <Note />
          </div>
        </details>
      )
    }
  </div>
</Base>

<style>
  .fascia {
    background: var(--tinta);
    padding-block: 16px 72px;
  }
  .indietro {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--tocco);
    margin-left: -8px;
    padding: 0 16px 0 8px;
    border-radius: 999px;
    color: var(--scuro);
    font-weight: 700;
    text-decoration: none;
  }
  .indietro:hover {
    background: var(--superficie);
  }
  .indietro svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .fascia h1 {
    margin-top: 4px;
    font-size: clamp(40px, 5.5vw, 64px);
    letter-spacing: -0.03em;
  }
  .sottotitolo {
    margin: 8px 0 0;
    font-size: 22px;
  }
  .info {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 16px 0 0;
  }
  .info .badge {
    border-color: transparent;
    color: var(--testo);
  }
  .info .badge--bozza {
    border-color: var(--testo-2);
  }

  /* Il lettore sale sopra la fascia colorata. */
  .corpo {
    margin-top: -48px;
  }

  /* --- Box delle deviazioni: la pagina si scurisce e il box si apre sopra --- */

  .box {
    width: min(1100px, calc(100% - 32px));
    max-width: none;
    max-height: calc(100dvh - 32px);
    padding: 0;
    border: 0;
    border-radius: var(--raggio);
    background: none;
    overflow-y: auto;
  }
  .box[open] {
    animation: box-apri 0.25s ease-in-out;
  }
  @keyframes box-apri {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
  }
  .box::backdrop {
    background: rgb(90 90 99 / 0.6);
    backdrop-filter: grayscale(1);
  }
  :global(html:has(dialog[open])) {
    overflow: hidden;
  }
  @media (max-width: 899px) {
    .box {
      width: 100%;
      height: 100dvh;
      max-height: none;
      margin: 0;
      border-radius: 0;
    }
  }

  .aiuto {
    margin: 12px 0 0;
    font-size: 16px;
    color: var(--testo-2);
  }
  kbd {
    font-family: inherit;
    font-weight: 700;
    padding: 0 6px;
    border: 1px solid var(--bordo);
    border-radius: 6px;
    background: var(--superficie);
  }
  @media (hover: none) {
    .aiuto {
      display: none;
    }
  }

  .schede {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
    margin-top: 40px;
  }
  .riquadro {
    padding: 24px 28px;
    background: var(--superficie);
    border-radius: var(--raggio);
    box-shadow: var(--ombra);
  }
  .riquadro h2,
  .note summary {
    font-size: 24px;
    font-weight: 700;
  }
  .obiettivi {
    display: grid;
    gap: 12px;
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
  }
  .obiettivi li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .obiettivi svg {
    flex: none;
    width: 28px;
    height: 28px;
    padding: 4px;
    margin-top: 2px;
    border-radius: 50%;
    background: var(--tinta);
    fill: none;
    stroke: var(--scuro);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .parole {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
  }
  .parole li {
    padding: 6px 16px;
    border-radius: 999px;
    background: var(--tinta);
    font-weight: 700;
  }

  .note {
    margin-top: 24px;
  }
  .note summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: var(--tocco);
    cursor: pointer;
    list-style: none;
  }
  .note summary::-webkit-details-marker {
    display: none;
  }
  .note summary svg {
    width: 28px;
    height: 28px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s ease-in-out;
  }
  .note[open] summary svg {
    transform: rotate(180deg);
  }
  .note__corpo :global(h2) {
    font-size: 20px;
    margin-top: 20px;
  }
  .note__corpo :global(ul) {
    margin: 8px 0 0;
    padding-left: 1.2em;
  }
</style>
